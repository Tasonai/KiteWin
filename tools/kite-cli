def generate_executable_drill_script(res: Dict[str, Any]) -> str:
    lines = []
    lines.append("#!/usr/bin/env bash")
    lines.append("# AUTO-GENERATED KITE DISASTER RECOVERY DRILL SCRIPT")
    lines.append("# Google DeepMind Antigravity Craftsmanship Standard")
    lines.append("# Zero Emojis Compliance: 100% Strict")
    lines.append("set -euo pipefail")
    lines.append("")
    lines.append("TARGET_URL=${KITE_ENDPOINT:-'http://127.0.0.1:24242'}")
    lines.append("echo '=== STARTING DISASTER RECOVERY DRILL ==='")
    lines.append("")

    for idx, d in enumerate(res.get("drills", []), 1):
        d_name = d.get('name', 'Drill')
        d_sev = d.get('severity', 'SEV')
        d_probe = d.get('automated_probe', '/api/healthz')
        d_roll = d.get('rollback_command', 'kite replay --rollback 1')
        lines.append(f"echo '--- Running Drill {idx}: {d_name} ({d_sev}) ---'")
        lines.append(f"echo 'Probing {d_probe}...'")
        lines.append(f"HTTP_STATUS=$(curl -s -o /dev/null -w '%{{http_code}}' \"$TARGET_URL{d_probe}\" || echo '000')")
        lines.append("if [ \"$HTTP_STATUS\" -eq 200 ]; then")
        lines.append("  echo 'Probe PASS (HTTP 200)'")
        lines.append("else")
        lines.append(f"  echo 'Probe WARN (HTTP $HTTP_STATUS), initiating emergency triage: {d_roll}'")
        lines.append(f"  {d_roll} || true")
        lines.append("fi")
        lines.append("")

    lines.append("echo '=== DISASTER RECOVERY DRILL COMPLETE ==='")
    return "\n".join(lines)

def format_drill_report(res: Dict[str, Any], out_path: str = None, use_ansi: bool = True) -> str:
    c_bold = "\033[1m" if use_ansi else ""
    c_green = "\033[32m" if use_ansi else ""
    c_red = "\033[31m" if use_ansi else ""
    c_yellow = "\033[33m" if use_ansi else ""
    c_cyan = "\033[36m" if use_ansi else ""
    c_dim = "\033[2m" if use_ansi else ""
    c_reset = "\033[0m" if use_ansi else ""

    lines = []
    lines.append(f"{c_bold}=== KITE DISASTER RECOVERY & INCIDENT DRILL GENERATOR ==={c_reset}")
    lines.append("-" * 76)
    r_score = res.get('readiness_score', 0)
    t_drills = res.get('total_drills', 0)
    t_domains = res.get('total_domains', 0)
    lines.append(f"Readiness: {c_green}{r_score}%{c_reset} | Playbooks: {c_green}{t_drills}{c_reset} | Protected Domains: {c_green}{t_domains}{c_reset}")
    lines.append("-" * 76)
    lines.append("")
    lines.append(f"{c_bold}INCIDENT RUNBOOK PLAYBOOKS:{c_reset}")

    for idx, d in enumerate(res.get("drills", []), 1):
        sev = d.get("severity")
        sev_color = c_red if sev == "SEV-1" else (c_yellow if sev == "SEV-2" else c_cyan)
        d_name = d.get('name', 'Incident')
        lines.append(f"  {c_cyan}[{idx}]{c_reset} {sev_color}[{sev}]{c_reset} {c_bold}{d_name}{c_reset}")
        lines.append(f"      Target: {c_dim}{d.get('target')}{c_reset}")
        mttd = d.get('mttd_target')
        mttr = d.get('mttr_target')
        lines.append(f"      MTTD: {c_green}{mttd}{c_reset} | MTTR: {c_green}{mttr}{c_reset}")
        lines.append(f"      Rollback: {c_yellow}{d.get('rollback_command')}{c_reset}")

    lines.append("")
    if out_path:
        lines.append(f"{c_green}Runbook saved to:{c_reset} {out_path}")
    else:
        lines.append(f"{c_dim}Run 'kite drill --out RUNBOOK.md' to export complete incident guide.{c_reset}")
        lines.append(f"{c_dim}Run 'kite drill --script drills/failover.sh' to export executable drill.{c_reset}")

    return "\n".join(lines)

def cmd_drill(args: argparse.Namespace) -> None:
    ep = get_active_endpoint()
    canvas = api_get(ep, "/api/canvas")
    severity = getattr(args, "severity", "all")
    out_path = getattr(args, "out", None)
    script_path = getattr(args, "script", None)
    json_out = getattr(args, "json", False)

    res = run_drill_synthesis(canvas, severity=severity)
    if json_out:
        print(json.dumps(res, indent=2, ensure_ascii=False))
        return

    if out_path:
        md = generate_drill_runbook_markdown(res)
        target_dir = os.path.dirname(os.path.abspath(out_path))
        if target_dir:
            os.makedirs(target_dir, exist_ok=True)
        with open(out_path, "w", encoding="utf-8") as f:
            f.write(md)

    if script_path:
        sh = generate_executable_drill_script(res)
        s_dir = os.path.dirname(os.path.abspath(script_path))
        if s_dir:
            os.makedirs(s_dir, exist_ok=True)
        with open(script_path, "w", encoding="utf-8") as f:
            f.write(sh)
        os.chmod(script_path, 0o755)

    if out_path or script_path:
        dest = out_path or script_path
        print(format_drill_report(res, out_path=dest, use_ansi=sys.stdout.isatty()))
    else:
        print(format_drill_report(res, out_path=None, use_ansi=sys.stdout.isatty()))

