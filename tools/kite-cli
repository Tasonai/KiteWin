        "referenceCards": canvas_cache.get("referenceCards", [])
    }
    canvas_json_bytes = json.dumps(canvas_payload).encode("utf-8")

    latencies: List[float] = []
    errors: int = 0
    successes: int = 0

    def single_request(idx: int) -> Optional[float]:
        nonlocal errors, successes
        t0 = time.perf_counter()
        is_write = False
        if bench_type == "write":
            is_write = True
        elif bench_type == "mixed":
            is_write = (idx % 5 == 0)
        elif bench_type == "read":
            is_write = False

        try:
            if is_write:
                req = urllib.request.Request(
                    f"{endpoint}/api/canvas",
                    data=canvas_json_bytes,
                    headers={"Content-Type": "application/json", "Accept": "application/json"},
                    method="POST"
                )
            else:
                target_path = "/api/status" if idx % 3 == 0 else ("/api/ideas" if idx % 3 == 1 else "/api/canvas")
                req = urllib.request.Request(f"{endpoint}{target_path}", headers={"Accept": "application/json"})

            with urllib.request.urlopen(req, timeout=5.0) as resp:
                _ = resp.read()
            elapsed_ms = (time.perf_counter() - t0) * 1000.0
            return elapsed_ms
        except Exception:
            return None

    t_bench_start = time.perf_counter()
    with concurrent.futures.ThreadPoolExecutor(max_workers=max(1, concurrency)) as executor:
        futures = [executor.submit(single_request, i) for i in range(total_requests)]
        for f in concurrent.futures.as_completed(futures):
            res = f.result()
            if res is not None:
                latencies.append(res)
                successes += 1
            else:
                errors += 1
    total_elapsed = time.perf_counter() - t_bench_start

    sse_latency_ms: Optional[float] = None
    try:
        received_event = threading.Event()
        sse_time = [None]
        def sse_sub():
            sub_req = urllib.request.Request(f"{endpoint}/api/events")
            try:
                with urllib.request.urlopen(sub_req, timeout=3.0) as resp:
                    for line in resp:
                        l_str = line.decode("utf-8").strip()
                        if "canvas_updated" in l_str or "ideas_updated" in l_str:
                            sse_time[0] = time.perf_counter()
                            received_event.set()
                            break
            except Exception:
                pass

        t_sub = threading.Thread(target=sse_sub, daemon=True)
        t_sub.start()
        time.sleep(0.08)

        t_post_start = time.perf_counter()
        post_req = urllib.request.Request(
            f"{endpoint}/api/canvas",
            data=canvas_json_bytes,
            headers={"Content-Type": "application/json"},
            method="POST"
        )
        with urllib.request.urlopen(post_req, timeout=3.0) as r:
            _ = r.read()

        if received_event.wait(timeout=2.0) and sse_time[0]:
            sse_latency_ms = round((sse_time[0] - t_post_start) * 1000.0, 2)
    except Exception:
        sse_latency_ms = None

    latencies.sort()
    count = len(latencies)
    if count > 0:
        min_lat = round(latencies[0], 2)
        max_lat = round(latencies[-1], 2)
        p50 = round(statistics.median(latencies), 2)
        p90 = round(latencies[min(int(count * 0.90), count - 1)], 2)
        p95 = round(latencies[min(int(count * 0.95), count - 1)], 2)
        p99 = round(latencies[min(int(count * 0.99), count - 1)], 2)
        mean_lat = round(statistics.mean(latencies), 2)
    else:
        min_lat = max_lat = p50 = p90 = p95 = p99 = mean_lat = 0.0

    rps = round(total_requests / total_elapsed, 2) if total_elapsed > 0 else 0.0

    if p95 < 100.0:
        rating = "ULTRA_FAST"
    elif p95 < 350.0:
        rating = "HIGH_PERFORMANCE"
    elif p95 < 800.0:
        rating = "ACCEPTABLE"
    else:
        rating = "DEGRADED"

    return {
        "status": "success",
        "endpoint": endpoint,
        "concurrency": concurrency,
        "total_requests": total_requests,
        "success_count": successes,
        "error_count": errors,
        "elapsed_seconds": round(total_elapsed, 3),
        "requests_per_sec": rps,
        "bench_type": bench_type,
        "latencies": {
            "min_ms": min_lat,
            "mean_ms": mean_lat,
            "p50_ms": p50,
            "p90_ms": p90,
            "p95_ms": p95,
            "p99_ms": p99,
            "max_ms": max_lat
        },
        "sse_broadcast_latency_ms": sse_latency_ms,
        "performance_rating": rating
    }

def format_benchmark_report(res: Dict[str, Any], use_ansi: bool = True) -> str:
    C_RESET = "\033[0m" if use_ansi else ""
    C_BOLD = "\033[1m" if use_ansi else ""
    C_CYAN = "\033[1;36m" if use_ansi else ""
    C_GREEN = "\033[1;32m" if use_ansi else ""

    lat = res.get("latencies", {})
    sse = res.get("sse_broadcast_latency_ms")
    sse_str = f"{sse} ms" if sse is not None else "N/A"

    lines = []
    lines.append(f"{C_CYAN}=== KITE AUTOMATED CONCURRENCY & STRESS BENCHMARK ==={C_RESET}")
    lines.append("-" * 74)
    lines.append(f"Target Station:     {C_BOLD}{res.get('endpoint')}{C_RESET}")
    lines.append(f"Workload Profile:   {res.get('bench_type').upper()} ({res.get('total_requests')} reqs @ {res.get('concurrency')} workers)")
    lines.append(f"Duration:           {res.get('elapsed_seconds')}s | Throughput: {C_GREEN}{C_BOLD}{res.get('requests_per_sec')} req/sec{C_RESET}")
    lines.append(f"Success / Errors:   {res.get('success_count')} OK / {res.get('error_count')} Failed")
    lines.append("-" * 74)
    lines.append(f"{C_BOLD}LATENCY PERCENTILES (Round-Trip Time){C_RESET}")
    lines.append(f"  Min:       {lat.get('min_ms'):>8.2f} ms")
    lines.append(f"  Mean:      {lat.get('mean_ms'):>8.2f} ms")
    lines.append(f"  p50 (Med): {lat.get('p50_ms'):>8.2f} ms")
    lines.append(f"  p90:       {lat.get('p90_ms'):>8.2f} ms")
    lines.append(f"  p95:       {lat.get('p95_ms'):>8.2f} ms")
    lines.append(f"  p99:       {lat.get('p99_ms'):>8.2f} ms")
    lines.append(f"  Max:       {lat.get('max_ms'):>8.2f} ms")
    lines.append("-" * 74)
    lines.append(f"Real-Time SSE Delay: {C_CYAN}{sse_str}{C_RESET}")
    lines.append(f"Overall Rating:      {C_BOLD}{C_GREEN}{res.get('performance_rating')}{C_RESET}")
    lines.append("-" * 74)
    return "\n".join(lines)

def cmd_benchmark(args: argparse.Namespace) -> None:
    ep = get_active_endpoint()
    concurrency = getattr(args, "concurrency", 8) or 8
    requests = getattr(args, "requests", 100) or 100
    b_type = getattr(args, "type", "mixed") or "mixed"
    json_out = getattr(args, "json", False)

    res = run_benchmark(ep, concurrency=concurrency, total_requests=requests, bench_type=b_type)
    if json_out:
        print(json.dumps(res, indent=2, ensure_ascii=False))
    else:
        print(format_benchmark_report(res, use_ansi=sys.stdout.isatty()))

# ==================== STRIDE THREAT MODEL AUDIT ENGINE ====================

def run_threat_model_audit(canvas: Dict[str, Any], auto_fix: bool = False, ep: Optional[str] = None) -> Dict[str, Any]:
    frames = canvas.get("frames", [])
    stickies = canvas.get("stickies", [])
    connections = canvas.get("connections", [])

    frame_titles = [f.get("title", "").lower() for f in frames]
    labels = [c.get("label", "").lower() for c in connections]

    has_security = any("secur" in t or "auth" in t for t in frame_titles) or any("secur" in l or "auth" in l for l in labels)
    has_audit = any("audit" in t or "observ" in t or "metric" in t for t in frame_titles) or any("audit" in l for l in labels)
    has_cache = any("cache" in t or "accelerat" in t for t in frame_titles) or any("cache" in l for l in labels)
    has_encapsulation = any("encapsulat" in l for l in labels) or len(connections) > 0

    threats = [
        {
            "id": "THR-S-01",
            "stride": "Spoofing",
            "name": "Unauthenticated Ingress & Token Forgery",
            "severity": "CRITICAL",
            "mitigated": has_security,
            "boundary": "Ingress API / Perimeter",
            "mitigation": "Enforce cryptographic JWT/OAuth2 session validation and mutual TLS at API boundary.",
            "code": "export const authGuard = async (req: Request) => { const token = req.headers.get('Authorization'); if (!token) throw new AuthError('Missing token'); };"
        },
        {
            "id": "THR-T-02",
            "stride": "Tampering",
            "name": "Unsigned Mutation Payloads & State Corruption",
            "severity": "HIGH",
            "mitigated": has_security or any("schema" in t for t in frame_titles),
            "boundary": "State Mutation Pipeline",
            "mitigation": "Verify cryptographic HMAC signatures and validate input payloads with strict Zod/TypeScript schemas.",
            "code": "export const validatePayload = (raw: unknown) => { return MutationSchema.parse(raw); };"
        },
        {
            "id": "THR-R-03",
            "stride": "Repudiation",
            "name": "Audit Blindness & Non-Repudiation Failure",
            "severity": "MEDIUM",
            "mitigated": has_audit,
            "boundary": "Domain Services & Storage",
            "mitigation": "Maintain structured, immutable append-only audit trail with ISO timestamps and actor IDs.",
            "code": "export const auditLog = (event: AuditEvent) => { appendImmutableLog({ ...event, timestamp: new Date().toISOString() }); };"
        },
        {
            "id": "THR-I-04",
            "stride": "Information Disclosure",
            "name": "Direct Persistence Exposure & Secret Leakage",
            "severity": "CRITICAL",
            "mitigated": has_encapsulation,
            "boundary": "Data Persistence Layer",
            "mitigation": "Encapsulate database behind domain service boundaries; prevent public client query access.",
            "code": "export class Repository { private db = getPool(); async query() { /* encapsulated */ } }"
        },
        {
            "id": "THR-D-05",
            "stride": "Denial of Service",
            "name": "Unthrottled Mutation Flood & Resource Starvation",
            "severity": "HIGH",
            "mitigated": has_cache,
            "boundary": "Public Edge & Concurrency",
            "mitigation": "Deploy LRU State Cache & Sliding-Window Rate Limiting (Upstash / Redis).",
            "code": "const limiter = new Ratelimit({ limiter: Ratelimit.slidingWindow(100, '1 m') });"
        },
        {
            "id": "THR-E-06",
            "stride": "Elevation of Privilege",
            "name": "Insecure Direct Object Reference (IDOR) & Broken RBAC",
            "severity": "HIGH",
            "mitigated": has_security,
            "boundary": "Tenant Isolation Barrier",
            "mitigation": "Enforce PostgreSQL Row-Level Security (RLS) and verified role hierarchy checks.",
            "code": "CREATE POLICY tenant_isolation ON entities FOR ALL USING (auth.uid() = tenant_id);"
        }
    ]

    mitigated_count = sum(1 for t in threats if t["mitigated"])
    score = int((mitigated_count / len(threats)) * 100)

    fixed = False
    if auto_fix and score < 100 and ep:
        gaps = []
        if not has_security:
            gaps.append({
                "frame": "Security & Auth Perimeter",
                "sticky": "JWT / OAuth2 Guard + OWASP Firewall",
                "colorHex": "#FCE7F3",
                "label": "Secures"
            })
        if not has_cache:
            gaps.append({
                "frame": "Cache & Acceleration",
                "sticky": "In-Memory LRU Cache + Rate Limiter",
                "colorHex": "#FEF3C7",
                "label": "Caches"
            })
        if not has_audit:
            gaps.append({
                "frame": "Observability & Metrics",
                "sticky": "Structured Audit Trail + OpenTelemetry",
                "colorHex": "#E0E7FF",
                "label": "Audits"
            })

        import time
        now = int(time.time())
        start_x = 100
        if frames:
            start_x = max(f.get("x", 0) + f.get("width", 320) for f in frames) + 60

        for idx, g in enumerate(gaps):
            fid = f"threat-fix-f-{now}-{idx}"
            sid = f"threat-fix-s-{now}-{idx}"
            frames.append({
                "id": fid,
                "title": g["frame"],
                "colorHex": "#EC4899",
                "x": start_x + (idx * 340),
                "y": 100,
                "width": 320,
                "height": 300
            })
            stickies.append({
                "id": sid,
                "text": g["sticky"],
                "colorHex": g["colorHex"],
                "position": [start_x + (idx * 340) + 20, 160]
            })
            if stickies:
                connections.append({
                    "id": f"threat-fix-c-{now}-{idx}",
                    "fromId": sid,
                    "toId": stickies[0]["id"],
                    "label": g["label"],
                    "colorHex": "#10B981"
                })

        payload = {
            "replace": True,
            "frames": frames,
            "stickies": stickies,
            "connections": connections,
            "referenceCards": canvas.get("referenceCards", [])
        }
        api_post(ep, "/api/canvas", payload)
        fixed = True
        for t in threats:
            t["mitigated"] = True
        mitigated_count = len(threats)
        score = 100

    return {
        "status": "success",
        "security_score": score,
        "mitigated_count": mitigated_count,
        "total_threats": len(threats),
        "threats": threats,
        "auto_fixed": fixed
    }

def generate_threat_model_md(audit_res: Dict[str, Any], title: str = "Kite Architecture") -> str:
    lines = []
    lines.append(f"# STRIDE Threat Model & Security Posture: {title}")
    lines.append("")
    lines.append("> Generated by Kite Security Audit Engine according to Google DeepMind Antigravity Craftsmanship Standard.")
    lines.append("")
    lines.append("## Executive Security Summary")
    score = audit_res.get("security_score", 0)
    lines.append(f"- **Security Score:** {score}% ({audit_res.get('mitigated_count')}/{audit_res.get('total_threats')} threats mitigated)")
    status_label = "SECURE / AUDIT PASSED" if score >= 90 else "ACTION REQUIRED"
    lines.append(f"- **Status:** {status_label}")
    lines.append(f"- **Standard:** Apple HIG / Windows 11 BAWA Zero Emojis, OWASP Top 10, STRIDE.")
    lines.append("")
    lines.append("## STRIDE Threat Assessment Matrix")
    lines.append("")
    lines.append("| ID | STRIDE | Threat Description | Severity | Status | Mitigation Pattern |")
    lines.append("|:---|:-------|:-------------------|:---------|:-------|:-------------------|")
    for t in audit_res.get("threats", []):
        st = "MITIGATED" if t.get("mitigated") else "OPEN RISK"
        lines.append(f"| `{t.get('id')}` | **{t.get('stride')}** | {t.get('name')} | `{t.get('severity')}` | **{st}** | {t.get('mitigation')} |")
    lines.append("")
    lines.append("## Required Code Patterns & Defensive Blueprints")
    lines.append("")
    for t in audit_res.get("threats", []):
        lines.append(f"### {t.get('id')}: {t.get('name')} [{t.get('stride')}]")
        lines.append(f"- **Boundary:** `{t.get('boundary')}`")
        lines.append(f"- **Severity:** `{t.get('severity')}`")
        lines.append(f"- **Directive:** {t.get('mitigation')}")
        lines.append("```ts")
        lines.append(t.get("code", "// Defensive pattern"))
        lines.append("```")
        lines.append("")
    lines.append("## Compliance & Antigravity Sign-Off")
    lines.append("All network edge routes, persistence queries, and cross-boundary connectors MUST adhere to this threat model.")
    return "\n".join(lines) + "\n"

def format_threat_model_report(audit_res: Dict[str, Any], use_ansi: bool = True) -> str:
    C_RESET = "\033[0m" if use_ansi else ""
    C_BOLD = "\033[1m" if use_ansi else ""
    C_CYAN = "\033[1;36m" if use_ansi else ""
    C_GREEN = "\033[1;32m" if use_ansi else ""
    C_RED = "\033[1;31m" if use_ansi else ""
    C_YELLOW = "\033[1;33m" if use_ansi else ""

    lines = []
    lines.append(f"{C_CYAN}=== KITE STRIDE THREAT MODEL & SECURITY AUDIT ==={C_RESET}")
    lines.append("-" * 88)
    score = audit_res.get("security_score", 0)
    score_color = C_GREEN if score >= 90 else (C_YELLOW if score >= 70 else C_RED)
    lines.append(f"Security Score:   {score_color}{C_BOLD}{score}%{C_RESET} ({audit_res.get('mitigated_count')}/{audit_res.get('total_threats')} STRIDE vectors secured)")
    if audit_res.get("auto_fixed"):
        lines.append(f"{C_GREEN}[+] Auto-Fix applied: Missing security & cache boundaries injected to canvas.{C_RESET}")
    lines.append("-" * 88)
    lines.append(f"{'ID':<10} {'STRIDE':<24} {'SEV':<10} {'STATUS':<12} {'THREAT NAME'}")
    lines.append("-" * 88)
    for t in audit_res.get("threats", []):
        mit = t.get("mitigated", False)
        status_text = "MITIGATED" if mit else "OPEN RISK"
        status_colored = f"{C_GREEN}{status_text:<12}{C_RESET}" if mit else f"{C_RED}{status_text:<12}{C_RESET}"
        sev_text = t.get("severity", "MEDIUM")
        sev_color = C_RED if sev_text == "CRITICAL" else (C_YELLOW if sev_text == "HIGH" else "")
        sev_colored = f"{sev_color}{sev_text:<10}{C_RESET}"
        tid = f"{t.get('id', ''):<10}"
        stride_field = f"{t.get('stride', ''):<24}"
        name = t.get("name", "")
        lines.append(f"{tid} {stride_field} {sev_colored} {status_colored} {name}")
    lines.append("-" * 88)
    return "\n".join(lines)

def cmd_audit_threats(args: argparse.Namespace) -> None:
    ep = get_active_endpoint()
    canvas = api_get(ep, "/api/canvas")
    auto_fix = getattr(args, "fix", False)
    out_path = getattr(args, "out", None)
    json_out = getattr(args, "json", False)

    res = run_threat_model_audit(canvas, auto_fix=auto_fix, ep=ep)
    if out_path:
        md = generate_threat_model_md(res)
        with open(out_path, "w", encoding="utf-8") as f:
            f.write(md)
        print(f"STRIDE Threat Model generated and saved to {os.path.abspath(out_path)} ({len(md)} bytes).")
    elif json_out:
        print(json.dumps(res, indent=2, ensure_ascii=False))
    else:
        print(format_threat_model_report(res, use_ansi=sys.stdout.isatty()))

# ==================== ARCHITECTURE MIGRATION & REFACTORING ENGINE ====================

def run_architecture_refactor(
    canvas: Dict[str, Any],
    target_frame: Optional[str] = None,
    apply_split: bool = False,
    ep: Optional[str] = None
) -> Dict[str, Any]:
    frames = canvas.get("frames", [])
    stickies = canvas.get("stickies", [])
    connections = canvas.get("connections", [])

    frame_metrics = []
    for f in frames:
        fx = f.get("x", 0)
        fy = f.get("y", 0)
        fw = f.get("width", 320)
        fh = f.get("height", 240)
        fid = f.get("id", "")
        ftitle = f.get("title", "Frame")

        f_stickies = [s for s in stickies if fx <= s.get("position", [0, 0])[0] <= fx + fw and fy <= s.get("position", [0, 0])[1] <= fy + fh]
        s_ids = {s.get("id") for s in f_stickies} | {fid}

        fan_in = sum(1 for c in connections if c.get("toId") in s_ids)
        fan_out = sum(1 for c in connections if c.get("fromId") in s_ids)
        ca = fan_in
        ce = fan_out
        instability = round(ce / (ca + ce), 2) if (ca + ce) > 0 else 0.5
        complexity = round(len(f_stickies) * 1.5 + (ca + ce) * 1.0, 1)

        is_monolith = (len(f_stickies) >= 3 or complexity >= 5.0)
        priority = "HIGH" if complexity >= 5.0 else ("MEDIUM" if complexity >= 3.0 else "LOW")

        frame_metrics.append({
            "id": fid,
            "title": ftitle,
            "x": fx,
            "y": fy,
            "width": fw,
            "height": fh,
            "stickies_count": len(f_stickies),
            "stickies": f_stickies,
            "fan_in": fan_in,
            "fan_out": fan_out,
            "instability": instability,
            "complexity_score": complexity,
            "is_monolith_candidate": is_monolith,
            "priority": priority
        })

    frame_metrics.sort(key=lambda x: x["complexity_score"], reverse=True)

    selected = None
    if target_frame:
        q = target_frame.lower()
        selected = next((fm for fm in frame_metrics if q in fm["title"].lower() or q in fm["id"].lower()), None)

    if not selected and frame_metrics:
        selected = frame_metrics[0]

    split_applied = False
    new_subservices = []
    if selected:
        s_list = selected["stickies"]
        split_idx = max(1, len(s_list) // 2)
        group_a = s_list[:split_idx]
        group_b = s_list[split_idx:]

        sub_a_title = f"{selected['title']} - Core Domain"
        sub_b_title = f"{selected['title']} - State & Repository"

        new_subservices = [
            {
                "title": sub_a_title,
                "role": "Ingress & Domain Execution Logic",
                "stickies": [s.get("text", "") for s in group_a]
            },
            {
                "title": sub_b_title,
                "role": "Persistence, Caching & Encapsulated WAL",
                "stickies": [s.get("text", "") for s in group_b]
            }
        ]

        if apply_split and ep and len(s_list) >= 2:
            import time
            now = int(time.time())
            base_x = selected["x"]
            base_y = selected["y"]
            w = max(320, selected["width"] // 2 - 20)
            h = selected["height"]

            fid_a = f"split-a-{now}"
            fid_b = f"split-b-{now}"

            frame_a = {
                "id": fid_a,
                "title": sub_a_title,
                "colorHex": "#3B82F6",
                "x": base_x,
                "y": base_y,
                "width": w,
                "height": h
            }
            frame_b = {
                "id": fid_b,
                "title": sub_b_title,
                "colorHex": "#10B981",
                "x": base_x + w + 40,
                "y": base_y,
                "width": w,
                "height": h
            }

            updated_stickies = []
            for s in stickies:
                if any(sa.get("id") == s.get("id") for sa in group_a):
                    s_copy = dict(s)
                    s_copy["position"] = [base_x + 20, base_y + 60 + (len(updated_stickies) % 3) * 60]
                    updated_stickies.append(s_copy)
                elif any(sb.get("id") == s.get("id") for sb in group_b):
                    s_copy = dict(s)
                    s_copy["position"] = [base_x + w + 60, base_y + 60 + (len(updated_stickies) % 3) * 60]
                    updated_stickies.append(s_copy)
                else:
                    updated_stickies.append(s)

            remaining_frames = [f for f in frames if f.get("id") != selected["id"]]
            remaining_frames.extend([frame_a, frame_b])

            new_conns = list(connections)
            if group_a and group_b:
                new_conns.append({
                    "id": f"conn-split-{now}",
                    "fromId": group_a[0].get("id"),
                    "toId": group_b[0].get("id"),
                    "label": "Encapsulates",
                    "colorHex": "#10B981"
                })

            payload = {
                "replace": True,
                "frames": remaining_frames,
                "stickies": updated_stickies,
                "connections": new_conns,
                "referenceCards": canvas.get("referenceCards", [])
            }
            api_post(ep, "/api/canvas", payload)
            split_applied = True

    return {
        "status": "success",
        "total_frames": len(frames),
        "monolith_candidates_count": sum(1 for fm in frame_metrics if fm["is_monolith_candidate"]),
        "frame_metrics": frame_metrics,
        "selected_target": selected,
        "proposed_subservices": new_subservices,
        "split_applied": split_applied
    }

