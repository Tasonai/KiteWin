def cmd_status(args: argparse.Namespace) -> None:
    ep = get_active_endpoint()
    status_data = api_get(ep, "/api/status")
    ideas_data = api_get(ep, "/api/ideas")
    canvas_data = api_get(ep, "/api/canvas")

    ideas = ideas_data.get("ideas", [])
    frames = canvas_data.get("frames", [])
    stickies = canvas_data.get("stickies", [])

    print(f"Station:        {status_data.get('app', 'Kite')}")
    print(f"Status:         {status_data.get('status', 'online').upper()}")
    print(f"Endpoint:       {ep}")
    print(f"Version:        {status_data.get('version', '1.0')}")
    print(f"Total Ideas:    {len(ideas)}")
    print(f"Canvas Frames:  {len(frames)}")
    print(f"Canvas Stickies:{len(stickies)}")

def cmd_list(args: argparse.Namespace) -> None:
    ep = get_active_endpoint()
    data = api_get(ep, "/api/ideas")
    ideas = data.get("ideas", [])

    if args.status:
        ideas = [i for i in ideas if i.get("status") == args.status]
    if args.platform:
        ideas = [i for i in ideas if i.get("platform", "").lower() == args.platform.lower()]
    if args.starred:
        ideas = [i for i in ideas if i.get("isStarred") is True]

    if args.json:
        print(json.dumps(ideas, indent=2, ensure_ascii=False))
        return

    if not ideas:
        print("No ideas found matching criteria.")
        return

    print(f"{'STAR':<5} {'ID':<38} {'STATUS':<12} {'PLATFORM':<10} {'TITLE'}")
    print("-" * 80)
    for i in ideas:
        star = "[*]" if i.get("isStarred") else "   "
        iid = i.get("id", "")
        status = i.get("status", "backlog")
        platform = i.get("platform", "web").capitalize()
        title = i.get("title", "Untitled")
        print(f"{star:<5} {iid:<38} {status:<12} {platform:<10} {title}")

def cmd_add(args: argparse.Namespace) -> None:
    ep = get_active_endpoint()
    new_idea = {
        "title": args.title,
        "description": args.concept or "",
        "platform": args.platform or "web",
        "preferredStyle": args.style or "Editorial & Swiss Modern",
        "status": args.status or "backlog",
        "isStarred": args.starred or False,
        "tags": [t.strip() for t in args.tags.split(",")] if args.tags else []
    }

    res = api_post(ep, "/api/ideas", {"ideas": [new_idea]})
    print(f"Added idea: \"{args.title}\" (Imported: {res.get('imported', 1)})")

def cmd_show(args: argparse.Namespace) -> None:
    ep = get_active_endpoint()
    data = api_get(ep, "/api/ideas")
    ideas = data.get("ideas", [])

    query = args.query.lower()
    matched = [i for i in ideas if query in i.get("id", "").lower() or query in i.get("title", "").lower()]

    if not matched:
        print(f"Idea not found matching '{args.query}'.")
        return

    item = matched[0]
    print(f"Title:       {item.get('title')}")
    print(f"ID:          {item.get('id')}")
    print(f"Platform:    {item.get('platform')}")
    print(f"Style:       {item.get('preferredStyle')}")
    print(f"Status:      {item.get('status')}")
    print(f"Starred:     {item.get('isStarred')}")
    print(f"Tags:        {', '.join(item.get('tags', []))}")
    print(f"Created:     {item.get('createdAt')}")
    print("\nConcept:")
    print(item.get("description") or "(none)")

def generate_canvas_mermaid(canvas: Dict[str, Any]) -> str:
    def sanitize_id(s: Any) -> str:
        res = re.sub(r"[^a-zA-Z0-9_]", "_", str(s))
        if res and res[0].isdigit():
            res = "n_" + res
        return res or "node"

    def clean_label(text: str) -> str:
        text = text.replace('"', "'").strip()
        return text[:70] + ("..." if len(text) > 70 else "")

    frames = canvas.get("frames", [])
    stickies = canvas.get("stickies", [])
    connections = canvas.get("connections", [])

    lines = ["flowchart TD"]
    known_nodes = set()
    frame_map: Dict[str, List[Dict[str, Any]]] = {}
    unframed: List[Dict[str, Any]] = []

    for s in stickies:
        pos = s.get("position", [0, 0])
        px, py = pos[0], pos[1]
        assigned = None
        for f in frames:
            fx, fy = f.get("x", 0), f.get("y", 0)
            fw, fh = f.get("width", 300), f.get("height", 300)
            if fx <= px <= fx + fw and fy <= py <= fy + fh:
                assigned = f.get("id")
                break
        if assigned:
            frame_map.setdefault(assigned, []).append(s)
        else:
            unframed.append(s)

    for f in frames:
        fid = sanitize_id(f.get("id"))
        ftitle = clean_label(f.get("title", "Frame"))
        lines.append(f'  subgraph {fid} ["{ftitle}"]')
        f_stickies = frame_map.get(f.get("id"), [])
        if not f_stickies:
            empty_id = f"{fid}_empty"
            lines.append(f'    {empty_id}["Empty Container"]')
            known_nodes.add(empty_id)
        for s in f_stickies:
            sid = sanitize_id(s.get("id"))
            stext = clean_label(s.get("text", "Node"))
            lines.append(f'    {sid}["{stext}"]')
            known_nodes.add(sid)
        lines.append("  end")

    if unframed:
        lines.append('  subgraph unframed ["General Directives"]')
        for s in unframed:
            sid = sanitize_id(s.get("id"))
            stext = clean_label(s.get("text", "Node"))
            lines.append(f'    {sid}["{stext}"]')
            known_nodes.add(sid)
        lines.append("  end")

    for c in connections:
        f_id = sanitize_id(c.get("fromId", ""))
        t_id = sanitize_id(c.get("toId", ""))
        lbl = clean_label(c.get("label", "")).replace("|", "/")
        if f_id not in known_nodes:
            lines.append(f'  {f_id}["{f_id}"]')
            known_nodes.add(f_id)
        if t_id not in known_nodes:
            lines.append(f'  {t_id}["{t_id}"]')
            known_nodes.add(t_id)
        arrow = f'-->|"{lbl}"|' if lbl else "-->"
        lines.append(f"  {f_id} {arrow} {t_id}")

    return "\n".join(lines)

def generate_canvas_plantuml(canvas: Dict[str, Any]) -> str:
    def sanitize_id(s: Any) -> str:
        res = re.sub(r"[^a-zA-Z0-9_]", "_", str(s))
        if res and res[0].isdigit():
            res = "n_" + res
        return res or "node"

    def clean_label(text: str) -> str:
        text = text.replace('"', "'").strip()
        return text[:70] + ("..." if len(text) > 70 else "")

    frames = canvas.get("frames", [])
    stickies = canvas.get("stickies", [])
    connections = canvas.get("connections", [])

    lines = [
        "@startuml",
        "skinparam monochrome true",
        "skinparam shadowing false",
        "skinparam roundcorner 8",
        "skinparam packageStyle rectangle"
    ]
    frame_map: Dict[str, List[Dict[str, Any]]] = {}
    unframed: List[Dict[str, Any]] = []

    for s in stickies:
        pos = s.get("position", [0, 0])
        px, py = pos[0], pos[1]
        assigned = None
        for f in frames:
            fx, fy = f.get("x", 0), f.get("y", 0)
            fw, fh = f.get("width", 300), f.get("height", 300)
            if fx <= px <= fx + fw and fy <= py <= fy + fh:
                assigned = f.get("id")
                break
        if assigned:
            frame_map.setdefault(assigned, []).append(s)
        else:
            unframed.append(s)

    for f in frames:
        fid = sanitize_id(f.get("id"))
        ftitle = clean_label(f.get("title", "Frame"))
        lines.append(f'package "{ftitle}" as {fid} {{')
        for s in frame_map.get(f.get("id"), []):
            sid = sanitize_id(s.get("id"))
            stext = clean_label(s.get("text", "Node"))
            lines.append(f"  component [{stext}] as {sid}")
        lines.append("}")

    if unframed:
        lines.append('package "General Directives" as unframed {')
        for s in unframed:
            sid = sanitize_id(s.get("id"))
            stext = clean_label(s.get("text", "Node"))
            lines.append(f"  component [{stext}] as {sid}")
        lines.append("}")

    for c in connections:
        f_id = sanitize_id(c.get("fromId", ""))
        t_id = sanitize_id(c.get("toId", ""))
        lbl = clean_label(c.get("label", ""))
        if lbl:
            lines.append(f"{f_id} --> {t_id} : {lbl}")
        else:
            lines.append(f"{f_id} --> {t_id}")

    lines.append("@enduml")
    return "\n".join(lines)

def generate_canvas_openapi(canvas: Dict[str, Any]) -> str:
    frames = canvas.get("frames", [])
    stickies = canvas.get("stickies", [])

    def slugify(text: str) -> str:
        clean = re.sub(r"\[.*?\]", "", text)
        slug = re.sub(r"[^a-zA-Z0-9]+", "-", clean.strip().lower()).strip("-")
        return slug or "endpoint"

    def clean_str(text: str) -> str:
        clean = text.replace('"', "").strip()
        return f'"{clean}"'

    tags = []
    paths = []

    for f in frames:
        ftitle = f.get("title", "Module")
        tname = re.sub(r"\[.*?\]", "", ftitle).strip()
        tags.append(f"  - name: {clean_str(tname)}\n    description: {clean_str(ftitle)}")

    for s in stickies:
        text = s.get("text", "Service Endpoint")
        slug = slugify(text)
        op_id = re.sub(r"[^a-zA-Z0-9]", "", slug.title())
        paths.append(
            f"  /api/v1/{slug}:\n"
            f"    get:\n"
            f"      summary: {clean_str(text)}\n"
            f"      operationId: get{op_id}\n"
            f"      responses:\n"
            f"        '200':\n"
            f"          description: Successful response\n"
            f"          content:\n"
            f"            application/json:\n"
            f"              schema:\n"
            f"                $ref: '#/components/schemas/StandardResponse'\n"
            f"        '500':\n"
            f"          description: Internal station error"
        )

    lines = [
        "openapi: 3.1.0",
        "info:",
        "  title: Kite Topology API",
        "  version: 1.3.0",
        "  description: Automatically synthesized OpenAPI 3.1 contract from Kite Architecture Canvas.",
        "servers:",
        "  - url: http://127.0.0.1:24242",
        "    description: macOS Kite Local Station",
        "  - url: http://127.0.0.1:24243",
        "    description: Windows 11 KiteWin Local Station",
        "tags:",
        *(tags if tags else ["  - name: Default\n    description: Primary API"]),
        "paths:",
        *(paths if paths else ["  /api/v1/health:\n    get:\n      summary: Health probe\n      responses:\n        '200':\n          description: Healthy"]),
        "components:",
        "  schemas:",
        "    StandardResponse:",
        "      type: object",
        "      properties:",
        "        status:",
        "          type: string",
        "          example: ok",
        "        data:",
        "          type: object"
    ]
    return "\n".join(lines)

