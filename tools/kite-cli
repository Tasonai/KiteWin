  #viewport.panning { cursor: grabbing; }
  #canvas-container { transform-origin: 0 0; position: absolute; top: 0; left: 0; }
</style>
</head>
<body>
<header>
  <div class="brand">
    <span>KITE LIVE CANVAS VIEWER</span>
    <span class="badge" id="station-badge">Connecting...</span>
  </div>
  <div class="controls">
    <input type="text" id="filter" placeholder="Filter stickies & frames..." />
    <button id="zoom-in">+</button>
    <button id="zoom-out">&minus;</button>
    <button id="zoom-reset">Reset</button>
    <button id="refresh-btn">Sync</button>
  </div>
</header>
<div id="viewport">
  <div id="canvas-container"></div>
</div>
<script>
  let scale = 1, panX = 40, panY = 40;
  let isPanning = false, startX = 0, startY = 0;
  const container = document.getElementById("canvas-container");
  const viewport = document.getElementById("viewport");
  const badge = document.getElementById("station-badge");
  const filterInput = document.getElementById("filter");

  function updateTransform() {
    container.style.transform = `translate(${panX}px, ${panY}px) scale(${scale})`;
  }

  viewport.addEventListener("mousedown", (e) => {
    if (e.target.closest("button") || e.target.closest("input")) return;
    isPanning = true;
    startX = e.clientX - panX;
    startY = e.clientY - panY;
    viewport.classList.add("panning");
  });

  window.addEventListener("mousemove", (e) => {
    if (!isPanning) return;
    panX = e.clientX - startX;
    panY = e.clientY - startY;
    updateTransform();
  });

  window.addEventListener("mouseup", () => {
    isPanning = false;
    viewport.classList.remove("panning");
  });

  viewport.addEventListener("wheel", (e) => {
    e.preventDefault();
    const factor = e.deltaY < 0 ? 1.08 : 0.92;
    const newScale = Math.min(Math.max(scale * factor, 0.2), 3);
    const mouseX = e.clientX - viewport.offsetLeft;
    const mouseY = e.clientY - viewport.offsetTop;
    panX = mouseX - (mouseX - panX) * (newScale / scale);
    panY = mouseY - (mouseY - panY) * (newScale / scale);
    scale = newScale;
    updateTransform();
  }, { passive: false });

  document.getElementById("zoom-in").onclick = () => { scale = Math.min(scale * 1.2, 3); updateTransform(); };
  document.getElementById("zoom-out").onclick = () => { scale = Math.max(scale * 0.8, 0.2); updateTransform(); };
  document.getElementById("zoom-reset").onclick = () => { scale = 1; panX = 40; panY = 40; updateTransform(); };

  async function loadCanvas() {
    try {
      const res = await fetch("/api/canvas-svg");
      if (res.ok) {
        const svgText = await res.text();
        container.innerHTML = svgText;
        badge.textContent = "Live Connected";
        badge.style.color = "#34D399";
        applyFilter();
      }
    } catch(err) {
      badge.textContent = "Offline";
      badge.style.color = "#F87171";
    }
  }

  function applyFilter() {
    const q = filterInput.value.toLowerCase().trim();
    document.querySelectorAll("[id^='sticky-'], [id^='frame-']").forEach(el => {
      if (!q) { el.style.opacity = "1"; return; }
      const text = el.textContent.toLowerCase();
      el.style.opacity = text.includes(q) ? "1" : "0.2";
    });
  }

  filterInput.addEventListener("input", applyFilter);
  document.getElementById("refresh-btn").onclick = loadCanvas;

  loadCanvas();
  setInterval(loadCanvas, 3000);
</script>
</body>
</html>
"""

class CanvasViewerHandler(BaseHTTPRequestHandler):
    endpoint = MAC_ENDPOINT

    def log_message(self, format, *args):
        pass

    def do_GET(self):
        if self.path == "/" or self.path == "/index.html":
            self.send_response(200)
            self.send_header("Content-Type", "text/html; charset=utf-8")
            self.end_headers()
            self.wfile.write(CANVAS_VIEWER_HTML.encode("utf-8"))
        elif self.path == "/api/canvas-svg":
            canvas = api_get(self.endpoint, "/api/canvas")
            svg = render_canvas_svg(canvas)
            self.send_response(200)
            self.send_header("Content-Type", "image/svg+xml; charset=utf-8")
            self.send_header("Cache-Control", "no-cache")
            self.end_headers()
            self.wfile.write(svg.encode("utf-8"))
        elif self.path == "/api/canvas.json":
            canvas = api_get(self.endpoint, "/api/canvas")
            data = json.dumps(canvas).encode("utf-8")
            self.send_response(200)
            self.send_header("Content-Type", "application/json; charset=utf-8")
            self.end_headers()
            self.wfile.write(data)
        elif self.path == "/health":
            self.send_response(200)
            self.send_header("Content-Type", "application/json")
            self.end_headers()
            self.wfile.write(b'{"status":"ok","service":"kite-canvas-viewer"}')
        else:
            self.send_response(404)
            self.end_headers()

def cmd_serve_canvas(args: argparse.Namespace) -> None:
    port = int(getattr(args, "port", 24245) or 24245)
    ep = get_active_endpoint()
    CanvasViewerHandler.endpoint = ep

    server = HTTPServer(("127.0.0.1", port), CanvasViewerHandler)
    url = f"http://127.0.0.1:{port}"
    print("=== KITE LIVE CANVAS WEB SERVER ===")
    print(f"Connected Station: {ep}")
    print(f"Live Web Viewer:   {url}")
    print("Press Ctrl+C to terminate server.\n")

    if getattr(args, "open", False) and sys.platform == "darwin":
        subprocess.run(["open", url])

    if getattr(args, "once", False):
        t = threading.Thread(target=server.serve_forever, daemon=True)
        t.start()
        time.sleep(0.1)
        try:
            req = urllib.request.Request(f"{url}/health")
            with urllib.request.urlopen(req, timeout=1.0) as resp:
                status_code = resp.status
            print(f"Health probe: {status_code} OK")
        except Exception as ex:
            print(f"Health probe error: {ex}")
        server.shutdown()
        server.server_close()
        print("Single-request test completed successfully.")
        return

    try:
        server.serve_forever()
    except KeyboardInterrupt:
        print("\nShutting down canvas web server...")
        server.server_close()

def run_lint_arch(canvas: Dict[str, Any], auto_fix: bool = False, ep: str = "") -> Dict[str, Any]:
    frames = canvas.get("frames", [])
    stickies = canvas.get("stickies", [])
    connections = canvas.get("connections", [])

    nodes_by_id: Dict[str, Dict[str, Any]] = {}
    for f in frames:
        nodes_by_id[f.get("id", "")] = {"id": f.get("id"), "text": f.get("title", ""), "type": "frame"}
    for s in stickies:
        nodes_by_id[s.get("id", "")] = {"id": s.get("id"), "text": s.get("text", ""), "type": "sticky"}

    def classify_layer(text: str) -> str:
        low = text.lower()
        if any(k in low for k in ["auth", "jwt", "session", "security", "guard", "firewall", "rbac"]):
            return "Security"
        if any(k in low for k in ["cache", "lru", "redis", "in-memory", "wal"]):
            return "Cache"
        if any(k in low for k in ["view", "page", "ui", "component", "hud", "presentation", "screen", "frontend"]):
            return "UI"
        if any(k in low for k in ["db", "database", "sqlite", "sql", "postgres", "prisma", "store", "persistence", "repository"]):
            return "Data"
        if any(k in low for k in ["service", "api", "controller", "sync", "router", "worker", "engine", "p2p", "mesh"]):
            return "Service"
        return "Generic"

    violations = []
    direct_db_count = 0
    for c in connections:
        fid = c.get("fromId", "")
        tid = c.get("toId", "")
        f_node = nodes_by_id.get(fid)
        t_node = nodes_by_id.get(tid)
        if f_node and t_node:
            f_layer = classify_layer(f_node.get("text", ""))
            t_layer = classify_layer(t_node.get("text", ""))
            if (f_layer == "UI" and t_layer == "Data") or (f_layer == "Data" and t_layer == "UI"):
                direct_db_count += 1
                f_txt = f_node.get('text', '')
                t_txt = t_node.get('text', '')
                violations.append({
                    "rule": "RULE_NO_DIRECT_DB",
                    "severity": "CRITICAL",
                    "message": f"Direct database access between \"{f_txt}\" and \"{t_txt}\" violates N-Tier architecture.",
                    "from": fid,
                    "to": tid
                })

    adj: Dict[str, List[str]] = {}
    for c in connections:
        fid = c.get("fromId", "")
        tid = c.get("toId", "")
        if fid and tid:
            adj.setdefault(fid, []).append(tid)

    visited: set = set()
    rec_stack: set = set()
    has_cycle = False
    cycle_nodes: List[str] = []

    def dfs(curr: str, path: List[str]) -> bool:
        visited.add(curr)
        rec_stack.add(curr)
        for neighbor in adj.get(curr, []):
            if neighbor not in visited:
                if dfs(neighbor, path + [neighbor]):
                    return True
            elif neighbor in rec_stack:
                cycle_nodes.extend(path + [neighbor])
                return True
        rec_stack.remove(curr)
        return False

    for nid in list(adj.keys()):
        if nid not in visited:
            if dfs(nid, [nid]):
                has_cycle = True
                break

    if has_cycle:
        violations.append({
            "rule": "RULE_NO_CYCLES",
            "severity": "HIGH",
            "message": f"Circular dependency detected in connection graph ({len(cycle_nodes)} nodes involved).",
            "nodes": cycle_nodes
        })

    has_security = any(classify_layer(n["text"]) == "Security" for n in nodes_by_id.values())
    if not has_security and len(nodes_by_id) > 2:
        violations.append({
            "rule": "RULE_SECURITY_GUARD",
            "severity": "HIGH",
            "message": "Canvas lacks dedicated Security & Auth boundary layer."
        })

    has_cache = any(classify_layer(n["text"]) == "Cache" for n in nodes_by_id.values())
    if not has_cache and len(nodes_by_id) > 4:
        violations.append({
            "rule": "RULE_CACHE_ACCEL",
            "severity": "MEDIUM",
            "message": "Canvas topology does not specify a high-throughput Cache / WAL layer."
        })

    connected_ids = set()
    for c in connections:
        connected_ids.add(c.get("fromId", ""))
        connected_ids.add(c.get("toId", ""))
    orphans = [nid for nid in nodes_by_id.keys() if nid not in connected_ids and nodes_by_id[nid]["type"] == "sticky"]
    if orphans and len(orphans) > 2:
        violations.append({
            "rule": "RULE_NO_ORPHANS",
            "severity": "LOW",
            "message": f"Detected {len(orphans)} isolated stickies without connection edges.",
            "orphans": orphans
        })

    penalty = sum(25 if v["severity"] == "CRITICAL" else (15 if v["severity"] == "HIGH" else 8) for v in violations)
    health = max(0, 100 - penalty)

    fixes_applied = 0
    if auto_fix and violations:
        if not has_security:
            sec_frame = canvas_add_frame(canvas, "Security & Auth Perimeter", color="pink", x=60, y=40, width=320, height=220)
            sec_sticky = canvas_add_sticky(canvas, "JWT Guard + Rate Limiter & Secret Shield", color="pink", frame_name="Security & Auth Perimeter", x=80, y=100)
            fixes_applied += 2
        if not has_cache:
            cache_frame = canvas_add_frame(canvas, "Cache & State WAL Acceleration", color="amber", x=60, y=280, width=320, height=220)
            cache_sticky = canvas_add_sticky(canvas, "In-Memory LRU State + SQLite WAL", color="amber", frame_name="Cache & State WAL Acceleration", x=80, y=340)
            fixes_applied += 2

        if ep and fixes_applied > 0:
            canvas["replace"] = True
            api_post(ep, "/api/canvas", canvas)

    return {
        "status": "passed" if not violations else ("warning" if health >= 70 else "failed"),
        "health_score": health,
        "violations": violations,
        "total_violations": len(violations),
        "nodes_analyzed": len(nodes_by_id),
        "connections_analyzed": len(connections),
        "fixes_applied": fixes_applied
    }

def format_lint_arch_report(res: Dict[str, Any], use_ansi: bool = True) -> str:
    C_RESET = "\033[0m" if use_ansi else ""
    C_BOLD = "\033[1m" if use_ansi else ""
    C_CYAN = "\033[1;36m" if use_ansi else ""
    C_GREEN = "\033[1;32m" if use_ansi else ""
    C_YELLOW = "\033[1;33m" if use_ansi else ""
    C_RED = "\033[1;31m" if use_ansi else ""
    C_DIM = "\033[90m" if use_ansi else ""

    lines = []
    lines.append(f"{C_CYAN}=== KITE ARCHITECTURAL RULES LINTER (lint-arch) ==={C_RESET}")
    lines.append("-" * 72)
    score = res.get("health_score", 100)
    sc_col = C_GREEN if score >= 85 else (C_YELLOW if score >= 65 else C_RED)
    nodes_n = res.get('nodes_analyzed', 0)
    conns_n = res.get('connections_analyzed', 0)
    lines.append(f"Topology Health Score: {sc_col}{C_BOLD}{score}%{C_RESET} ({nodes_n} nodes, {conns_n} edges analyzed)")
    lines.append("-" * 72)

    violations = res.get("violations", [])
    if not violations:
        lines.append(f"{C_GREEN}[PASS] No architectural rule violations detected. Topology is N-Tier compliant.{C_RESET}")
    else:
        for v in violations:
            sev = v.get("severity", "LOW")
            sev_col = C_RED if sev == "CRITICAL" else (C_YELLOW if sev == "HIGH" else C_DIM)
            rule = v.get("rule", "")
            msg = v.get("message", "")
            lines.append(f"{sev_col}[{sev:<8}]{C_RESET} {C_BOLD}{rule:<22}{C_RESET} {msg}")

    fixes = res.get("fixes_applied", 0)
    if fixes > 0:
        lines.append("-" * 72)
        lines.append(f"{C_GREEN}[APPLIED]{C_RESET} Successfully auto-fixed {fixes} missing architectural boundaries on Canvas.")

    lines.append("-" * 72)
    st = res.get("status")
    if st == "passed":
        lines.append(f"{C_BOLD}{C_GREEN}ARCHITECTURE CONFORMS TO ENTERPRISE SPECIFICATION{C_RESET}")
    elif st == "warning":
        lines.append(f"{C_BOLD}{C_YELLOW}ARCHITECTURE ACCEPTABLE WITH WARNINGS (Remediations Suggested){C_RESET}")
    else:
        lines.append(f"{C_BOLD}{C_RED}ARCHITECTURE CONTAINS CRITICAL DEFECTS{C_RESET}")
    return "\n".join(lines)

def cmd_lint_arch(args: argparse.Namespace) -> None:
    ep = get_active_endpoint()
    canvas = api_get(ep, "/api/canvas")
    auto_fix = getattr(args, "fix", False)
    json_out = getattr(args, "json", False)

    res = run_lint_arch(canvas, auto_fix=auto_fix, ep=ep)
    if json_out:
        print(json.dumps(res, indent=2, ensure_ascii=False))
    else:
        print(format_lint_arch_report(res, use_ansi=sys.stdout.isatty()))

    if res.get("status") == "failed" and not auto_fix:
        sys.exit(1)

def generate_prd(idea: Dict[str, Any], canvas: Dict[str, Any]) -> str:
    title = idea.get("title", "Kite Project")
    concept = idea.get("description") or idea.get("concept") or "Enterprise application architecture and domain management."
    platform = (idea.get("platform") or "web").capitalize()
    style = idea.get("preferredStyle") or "Editorial & Swiss Modern"
    answers = idea.get("interviewAnswers", [])

    frames = canvas.get("frames", [])
    stickies = canvas.get("stickies", [])
    conns = canvas.get("connections", [])

    now_iso = datetime.datetime.now(datetime.timezone.utc).strftime("%Y-%m-%d")

    lines = []
    lines.append(f"# Product Requirements Document (PRD): {title}")
    lines.append(f"**Date:** {now_iso} | **Status:** Draft (Approved for Engineering) | **Platform:** {platform}")
    lines.append(f"**Design System Preset:** {style} | **Architecture Standard:** Google DeepMind Antigravity")
    lines.append("")

    lines.append("## 1. Executive Summary & Problem Statement")
    lines.append("### 1.1 Context & Vision")
    lines.append(concept.strip())
    lines.append("")
    lines.append("### 1.2 Jobs To Be Done (JTBD)")
    lines.append(f"- **When** users need to design, inspect, and implement reliable software for {title},")
    lines.append("- **I want to** leverage type-safe architectural blueprints, reactive state, and verified local persistence,")
    lines.append("- **So I can** ship production features rapidly with zero drift and guaranteed quality gates.")
    lines.append("")

    if answers:
        lines.append("### 1.3 Interview Decisions & Architectural Trade-offs")
        for idx, a in enumerate(answers):
            q_text = a.get("question", f"Decision {idx+1}")
            choice = a.get("answer") or a.get("selectedOption", "Standard")
            lines.append(f"- **{q_text}:** `{choice}`")
        lines.append("")

    lines.append("## 2. System Architecture & Topology Contract")
    lines.append("The system follows a strict layered architecture validated by Kite Architecture Linter.")
    lines.append("")
    lines.append("### 2.1 Architectural Boundaries (Frames)")
    if frames:
        for f in frames:
            f_title = f.get('title', 'Frame')
            f_w = f.get('width', 360)
            f_h = f.get('height', 420)
            f_x = f.get('x', 0)
            f_y = f.get('y', 0)
            lines.append(f"- **{f_title}:** Bounding box `{f_w}x{f_h}` at position `({f_x}, {f_y})`.")
    else:
        lines.append("- **UI & Presentation Layer:** User interface controls, design tokens, HUD viewports.")
        lines.append("- **Service & Transport Layer:** REST/gRPC endpoints, P2P mesh sync engine, event bus.")
        lines.append("- **Data & Persistence Layer:** SQLite WAL store, SwiftData repository, schema migrations.")
    lines.append("")

    lines.append("### 2.2 Protocols & Integration Edges")
    if conns:
        for c in conns:
            lbl = c.get("label", "Connects")
            fid = c.get("fromId", "")
            tid = c.get("toId", "")
            lines.append(f"- `{fid}` &rarr; `{tid}` via `{lbl}`")
    else:
        lines.append("- View &rarr; Service: Typed HTTP / SSE JSON RPC.")
        lines.append("- Service &rarr; Data: Async repository pattern with Write-Ahead Logging.")
    lines.append("")

    lines.append("## 3. Design System & Grid Standards")
    lines.append(f"- **Preset:** `{style}`")
    lines.append("- **Grid Compliance:**")
    lines.append("  - macOS: Apple Human Interface Guidelines 4pt/8pt rhythm.")
    lines.append("  - Windows: Windows 11 BAWA 4 epx rhythm.")
    lines.append("- **Typography & Symbols:** Strictly 100% native glyphs (SF Symbols / Segoe Fluent Icons). Zero emojis.")
    lines.append("- **Color System:** Dark surface `#0B0D13`, border `#1E293B`, accents `#3B82F6` and `#10B981`.")
    lines.append("")

    lines.append("## 4. Functional Requirements")
    lines.append("### FR-1: Core Workspace & Canvas Management")
    lines.append("- The application shall initialize persistent state upon launch without cloud lock-in.")
    lines.append("- Users can inspect and manipulate architectural stickies, frames, and connections.")
    lines.append("")
    lines.append("### FR-2: Real-time Synchronization & Conflict Resolution")
    lines.append("- Stations broadcast state changes via Server-Sent Events (SSE) within 50ms latency.")
    lines.append("- Multi-node mutations resolve deterministically using union conflict resolution.")
    lines.append("")
    lines.append("### FR-3: AI & Offline Fallback Engine")
    lines.append("- The system routes tasks through Gemini 3.8, falling back to local Ollama or deterministic offline compiler.")
    lines.append("")

    lines.append("## 5. Non-Functional Requirements (NFR)")
    lines.append("- **NFR-1 (Latency):** Interactive canvas interactions shall render at 60 FPS (<16ms frame time).")
    lines.append("- **NFR-2 (Reliability):** 100% passing automated test suite (110 self-tests on macOS, zero gate violations on Windows).")
    lines.append("- **NFR-3 (Accessibility):** WCAG 2.2 Level AA compliance, full keyboard navigation and high-contrast support.")
    lines.append("- **NFR-4 (Security):** Zero plain-text credentials; secrets sanitized before logging or disk persistence.")
    lines.append("")

    lines.append("## 6. Execution Waves & Delivery Plan")
    lines.append("- **Wave 1 (Data & Schema):** Relational tables, WAL store, data models, initial migrations.")
    lines.append("- **Wave 2 (Services & Transport):** Type-safe endpoints, P2P sync engine, event bus, SSE stream.")
    lines.append("- **Wave 3 (Presentation & UI):** Native views, tokens, interactive canvas, accessibility audit.")
    lines.append("- **Wave 4 (QA & Release):** End-to-end integration tests, package DMG/ZIP/Installer, CI/CD matrix.")

    return "\n".join(lines)

def cmd_prd(args: argparse.Namespace) -> None:
    ep = get_active_endpoint()
    ideas = api_get(ep, "/api/ideas").get("ideas", [])
    canvas = api_get(ep, "/api/canvas")

    q = getattr(args, "query", "") or ""
    matched = None
    if q:
        matched = next((i for i in ideas if q.lower() in i.get("title", "").lower() or q.lower() in i.get("id", "").lower()), None)
    else:
        matched = next((i for i in ideas if i.get("isStarred")), ideas[0] if ideas else None)

    if not matched:
        matched = {
            "title": "Kite Architecture Project",
            "concept": "Integrated cross-platform workspace for architecture and system design.",
            "platform": "desktop",
            "preferredStyle": "Editorial & Swiss Modern"
        }

    prd_md = generate_prd(matched, canvas)
    out_path = getattr(args, "out", "") or ""
    json_out = getattr(args, "json", False)

    if out_path:
        with open(out_path, "w", encoding="utf-8") as f:
            f.write(prd_md)
        print(f"PRD generated and saved to {os.path.abspath(out_path)} ({len(prd_md)} bytes).")
    elif json_out:
        res = {
            "title": matched.get("title"),
            "platform": matched.get("platform"),
            "prd": prd_md,
            "bytes": len(prd_md)
        }
        print(json.dumps(res, indent=2, ensure_ascii=False))
    else:
        print(prd_md)

def scaffold_full_project(idea: Dict[str, Any], canvas: Dict[str, Any], out_dir: str, dry_run: bool = False) -> Dict[str, Any]:
    title = idea.get("title", "Kite Project")
    concept = idea.get("description") or idea.get("concept") or "Enterprise application architecture and domain management."
    platform = (idea.get("platform") or "web").lower()
    style = idea.get("preferredStyle") or "Editorial & Swiss Modern"
    slug = "".join(c if c.isalnum() else "-" for c in title.lower()).strip("-") or "kite-project"
    ts_title = "".join(w.capitalize() for w in re.findall(r"[a-zA-Z0-9]+", title)) or "KiteProject"

    frames = canvas.get("frames", [])
    stickies = canvas.get("stickies", [])
    conns = canvas.get("connections", [])

    files: Dict[str, str] = {}

    files["package.json"] = json.dumps({
        "name": slug,
        "version": "1.0.0",
        "description": concept,
        "private": True,
        "scripts": {
            "build": "tsc",
            "dev": "tsx watch src/index.ts",
            "test": "vitest run",
            "lint": "eslint src/ --ext .ts,.tsx"
