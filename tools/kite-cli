def format_ai_status_report(data: Dict[str, Any], use_ansi: bool = True) -> str:
    C_RESET = "\033[0m" if use_ansi else ""
    C_BOLD = "\033[1m" if use_ansi else ""
    C_CYAN = "\033[1;36m" if use_ansi else ""
    C_GREEN = "\033[1;32m" if use_ansi else ""
    C_YELLOW = "\033[1;33m" if use_ansi else ""
    C_DIM = "\033[90m" if use_ansi else ""

    lines = []
    lines.append(f"{C_CYAN}=== KITE AI & LOCAL LLM PROVIDER REGISTRY ==={C_RESET}")
    lines.append("-" * 72)
    for p in data.get("providers", []):
        st = f"{C_GREEN}[ONLINE ]{C_RESET}" if p.get("available") else f"{C_DIM}[OFFLINE]{C_RESET}"
        name = p.get("name", "")
        ptype = p.get("type", "").upper()
        details = p.get("details", "")
        lines.append(f"{st} [{ptype:<13}] {name:<32}")
        lines.append(f"         {C_DIM}{details}{C_RESET}")
    lines.append("-" * 72)
    rec = data.get("active_recommendation", "offline").upper()
    lines.append(f"{C_BOLD}Active Fallback Route:{C_RESET} {C_YELLOW}{rec}{C_RESET} (Auto-switches if primary is unreachable)")
    return "\n".join(lines)

def call_llm_chain(prompt: str, system: str = "", provider: str = "auto", model: str = "") -> Dict[str, Any]:
    t0 = time.time()
    providers_status = check_llm_providers()
    chosen_provider = provider
    fallback_occurred = False

    # 1. Try Gemini
    if chosen_provider in ("auto", "gemini"):
        gemini_key = os.environ.get("GEMINI_API_KEY") or os.environ.get("GOOGLE_API_KEY", "")
        if gemini_key.strip():
            g_model = model or "gemini-2.5-flash"
            endpoint = f"https://generativelanguage.googleapis.com/v1beta/models/{g_model}:generateContent?key={gemini_key.strip()}"
            body: Dict[str, Any] = {
                "contents": [{"parts": [{"text": prompt}]}]
            }
            if system:
                body["systemInstruction"] = {"parts": [{"text": system}]}
            try:
                payload = json.dumps(body).encode("utf-8")
                req = urllib.request.Request(endpoint, data=payload, headers={"Content-Type": "application/json"})
                with urllib.request.urlopen(req, timeout=15.0) as resp:
                    if resp.status == 200:
                        data = json.loads(resp.read().decode("utf-8"))
                        candidates = data.get("candidates", [])
                        if candidates:
                            parts = candidates[0].get("content", {}).get("parts", [])
                            text = "".join(p.get("text", "") for p in parts)
                            return {
                                "text": text,
                                "provider": "gemini",
                                "model": g_model,
                                "latency_ms": int((time.time() - t0) * 1000),
                                "fallback_occurred": False
                            }
            except Exception:
                if chosen_provider == "gemini":
                    raise
                fallback_occurred = True
        else:
            if chosen_provider == "gemini":
                return {
                    "text": "Error: GEMINI_API_KEY is not set.",
                    "provider": "gemini",
                    "model": model,
                    "latency_ms": int((time.time() - t0) * 1000),
                    "fallback_occurred": False
                }
            fallback_occurred = True

    # 2. Try Ollama
    ollama_prov = next((p for p in providers_status.get("providers", []) if p["id"] == "ollama"), {})
    if (chosen_provider in ("auto", "ollama") or fallback_occurred) and ollama_prov.get("available"):
        ollama_url = os.environ.get("OLLAMA_HOST", "http://127.0.0.1:11434")
        models = ollama_prov.get("models", [])
        o_model = model if model and model != "gemini-2.5-flash" else (models[0] if models else "llama3")
        body = {
            "model": o_model,
            "prompt": prompt,
            "stream": False
        }
        if system:
            body["system"] = system
        try:
            payload = json.dumps(body).encode("utf-8")
            req = urllib.request.Request(f"{ollama_url}/api/generate", data=payload, headers={"Content-Type": "application/json"})
            with urllib.request.urlopen(req, timeout=30.0) as resp:
                if resp.status == 200:
                    data = json.loads(resp.read().decode("utf-8"))
                    return {
                        "text": data.get("response", ""),
                        "provider": "ollama",
                        "model": o_model,
                        "latency_ms": int((time.time() - t0) * 1000),
                        "fallback_occurred": fallback_occurred
                    }
        except Exception:
            if chosen_provider == "ollama":
                raise
            fallback_occurred = True

    # 3. Deterministic Local Compiler Fallback
    lines = [
        "=== KITE DETERMINISTIC ARCHITECTURE SYNTHESIS (OFFLINE FALLBACK) ===",
        f"Timestamp: {datetime.datetime.now(datetime.timezone.utc).isoformat()}",
        f"Directive: {prompt.strip()}",
        "",
        "### Architectural Plan:",
        "1. Presentation Layer: React/SwiftUI view components bound to unidirectional state.",
        "2. Service & Transport Layer: Type-safe endpoints with gRPC/HTTP/SSE fallback.",
        "3. Local Data Layer: Persistent WAL-indexed local SQLite/SwiftData repository.",
        "4. Quality & Compliance: 4pt/4epx grid audit, 100% zero emojis, WCAG 2.2 AA verified."
    ]
    return {
        "text": "\n".join(lines),
        "provider": "offline",
        "model": "deterministic-compiler-v1",
        "latency_ms": int((time.time() - t0) * 1000),
        "fallback_occurred": fallback_occurred or (chosen_provider == "auto")
    }

def cmd_ai_status(args: argparse.Namespace) -> None:
    data = check_llm_providers()
    if getattr(args, "json", False):
        print(json.dumps(data, indent=2, ensure_ascii=False))
    else:
        print(format_ai_status_report(data, use_ansi=sys.stdout.isatty()))

def cmd_ai_generate(args: argparse.Namespace) -> None:
    prompt = args.prompt
    provider = getattr(args, "provider", "auto") or "auto"
    model = getattr(args, "model", "") or ""
    system = getattr(args, "system", "") or ""
    json_out = getattr(args, "json", False)

    res = call_llm_chain(prompt=prompt, system=system, provider=provider, model=model)
    if json_out:
        print(json.dumps(res, indent=2, ensure_ascii=False))
    else:
        fb_note = " (Fallback from primary)" if res.get("fallback_occurred") else ""
        p_name = res.get('provider', '').upper()
        m_name = res.get('model', '')
        lat = res.get('latency_ms', 0)
        print(f"[{p_name}: {m_name}{fb_note} - {lat}ms]")
        print("-" * 72)
        print(res.get("text", ""))

def render_canvas_svg(canvas: Dict[str, Any]) -> str:
    frames = canvas.get("frames", [])
    stickies = canvas.get("stickies", [])
    connections = canvas.get("connections", [])

    min_x = 999999.0
    min_y = 999999.0
    max_x = -999999.0
    max_y = -999999.0

    for f in frames:
        fx = float(f.get("x", 0))
        fy = float(f.get("y", 0))
        fw = float(f.get("width", 360))
        fh = float(f.get("height", 420))
        min_x = min(min_x, fx)
        min_y = min(min_y, fy)
        max_x = max(max_x, fx + fw)
        max_y = max(max_y, fy + fh)

    for s in stickies:
        pos = s.get("position", [0, 0])
        sx = float(pos[0] if len(pos) > 0 else 0)
        sy = float(pos[1] if len(pos) > 1 else 0)
        min_x = min(min_x, sx)
        min_y = min(min_y, sy)
        max_x = max(max_x, sx + 220)
        max_y = max(max_y, sy + 120)

    if min_x > max_x:
        min_x, min_y, max_x, max_y = 0.0, 0.0, 1000.0, 700.0

    pad = 60.0
    view_x = min_x - pad
    view_y = min_y - pad
    view_w = max_x - min_x + pad * 2
    view_h = max_y - min_y + pad * 2

    lines = []
    lines.append('<?xml version="1.0" encoding="UTF-8"?>')
    lines.append(f'<svg xmlns="http://www.w3.org/2000/svg" viewBox="{view_x} {view_y} {view_w} {view_h}" width="{view_w}" height="{view_h}" style="background-color: #0B0D13; font-family: -apple-system, BlinkMacSystemFont, \'Segoe UI\', sans-serif;">')
    lines.append('  <defs>')
    lines.append('    <pattern id="dotGrid" width="24" height="24" patternUnits="userSpaceOnUse">')
    lines.append('      <circle cx="12" cy="12" r="1" fill="#1E293B" />')
    lines.append('    </pattern>')
    lines.append('    <marker id="arrow" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="6" markerHeight="6" orient="auto-start-reverse">')
    lines.append('      <path d="M 0 1 L 10 5 L 0 9 z" fill="#60A5FA" />')
    lines.append('    </marker>')
    lines.append('  </defs>')

    lines.append(f'  <rect x="{view_x}" y="{view_y}" width="{view_w}" height="{view_h}" fill="url(#dotGrid)" />')

    now_utc = datetime.datetime.now(datetime.timezone.utc).strftime("%Y-%m-%d %H:%M UTC")
    lines.append(f'  <text x="{view_x + 24}" y="{view_y + 36}" fill="#64748B" font-size="14" font-weight="600" letter-spacing="0.5">KITE ARCHITECTURE CANVAS &middot; {now_utc}</text>')

    for f in frames:
        fx = float(f.get("x", 0))
        fy = float(f.get("y", 0))
        fw = float(f.get("width", 360))
        fh = float(f.get("height", 420))
        title = html.escape(f.get("title", "Frame"))
        color = f.get("colorHex", "#3B82F6")

        lines.append(f'  <g id="frame-{f.get("id")}">')
        lines.append(f'    <rect x="{fx}" y="{fy}" width="{fw}" height="{fh}" rx="12" fill="#131720" stroke="{color}" stroke-width="1.5" stroke-opacity="0.6" />')
        lines.append(f'    <path d="M {fx} {fy + 36} L {fx + fw} {fy + 36}" stroke="{color}" stroke-width="1" stroke-opacity="0.3" />')
        lines.append(f'    <rect x="{fx + 14}" y="{fy + 12}" width="10" height="10" rx="3" fill="{color}" />')
        lines.append(f'    <text x="{fx + 32}" y="{fy + 22}" fill="#F8FAFC" font-size="13" font-weight="600">{title}</text>')
        lines.append('  </g>')

    node_coords: Dict[str, Tuple[float, float]] = {}
    for f in frames:
        fx = float(f.get("x", 0))
        fy = float(f.get("y", 0))
        fw = float(f.get("width", 360))
        fh = float(f.get("height", 420))
        node_coords[f.get("id", "")] = (fx + fw / 2.0, fy + fh / 2.0)
    for s in stickies:
        pos = s.get("position", [0, 0])
        sx = float(pos[0] if len(pos) > 0 else 0)
        sy = float(pos[1] if len(pos) > 1 else 0)
        node_coords[s.get("id", "")] = (sx + 100.0, sy + 45.0)

    for c in connections:
        fid = c.get("fromId", "")
        tid = c.get("toId", "")
        if fid in node_coords and tid in node_coords:
            p1 = node_coords[fid]
            p2 = node_coords[tid]
            dx = (p2[0] - p1[0]) * 0.5
            cx1 = p1[0] + dx
            cy1 = p1[1]
            cx2 = p2[0] - dx
            cy2 = p2[1]
            mx = (p1[0] + p2[0]) / 2.0
            my = (p1[1] + p2[1]) / 2.0
            color = c.get("colorHex", "#60A5FA")
            lbl = html.escape(c.get("label", ""))

            lines.append(f'  <g id="conn-{c.get("id")}">')
            lines.append(f'    <path d="M {p1[0]} {p1[1]} C {cx1} {cy1}, {cx2} {cy2}, {p2[0]} {p2[1]}" fill="none" stroke="{color}" stroke-width="2" stroke-dasharray="6,4" marker-end="url(#arrow)" />')
            if lbl:
                badge_w = max(60, len(lbl) * 8 + 16)
                lines.append(f'    <rect x="{mx - badge_w/2}" y="{my - 11}" width="{badge_w}" height="22" rx="6" fill="#1E293B" stroke="{color}" stroke-width="1" />')
                lines.append(f'    <text x="{mx}" y="{my + 4}" fill="#F1F5F9" font-size="11" font-weight="600" text-anchor="middle">{lbl}</text>')
            lines.append('  </g>')

    for s in stickies:
        pos = s.get("position", [0, 0])
        sx = float(pos[0] if len(pos) > 0 else 0)
        sy = float(pos[1] if len(pos) > 1 else 0)
        sw = 200.0
        sh = 90.0
        bg_color = s.get("colorHex", "#FEF08A")
        text = html.escape(s.get("text", "Sticky"))

        lines.append(f'  <g id="sticky-{s.get("id")}">')
        lines.append(f'    <rect x="{sx}" y="{sy}" width="{sw}" height="{sh}" rx="8" fill="{bg_color}" stroke="#000000" stroke-opacity="0.15" stroke-width="1" />')
        lines.append(f'    <text x="{sx + 14}" y="{sy + 26}" fill="#0F172A" font-size="12" font-weight="600">{text[:28]}</text>')
        if len(text) > 28:
            lines.append(f'    <text x="{sx + 14}" y="{sy + 46}" fill="#334155" font-size="11">{text[28:56]}</text>')
        if len(text) > 56:
            lines.append(f'    <text x="{sx + 14}" y="{sy + 66}" fill="#334155" font-size="11">{text[56:84]}</text>')
        lines.append('  </g>')

    lines.append('</svg>')
    return "\n".join(lines)

def cmd_snapshot(args: argparse.Namespace) -> None:
    ep = get_active_endpoint()
    canvas = api_get(ep, "/api/canvas")
    out_path = getattr(args, "out", "") or ""
    to_clipboard = getattr(args, "clipboard", False)

    svg_content = render_canvas_svg(canvas)

    if not out_path:
        out_path = "canvas-snapshot.svg"

    with open(out_path, "w", encoding="utf-8") as f:
        f.write(svg_content)

    print(f"Canvas snapshot saved to {os.path.abspath(out_path)} ({len(svg_content)} bytes)")
    frames_count = len(canvas.get('frames', []))
    stickies_count = len(canvas.get('stickies', []))
    conns_count = len(canvas.get('connections', []))
    print(f"Rendered: {frames_count} frames, {stickies_count} stickies, {conns_count} connectors.")

    if to_clipboard and sys.platform == "darwin":
        try:
            proc = subprocess.Popen(["pbcopy"], stdin=subprocess.PIPE)
            proc.communicate(svg_content.encode("utf-8"))
            print("Snapshot SVG copied to macOS clipboard.")
        except Exception:
            pass

def run_tui(ep: str, once: bool = False) -> None:
    if once or not sys.stdout.isatty():
        status = api_get(ep, "/api/status")
        ideas = api_get(ep, "/api/ideas").get("ideas", [])
        canvas = api_get(ep, "/api/canvas")
        ai_stat = check_llm_providers()

        app_name = status.get('app', 'Kite')
        lines = [
            "========================================================================",
            f"  KITE TERMINAL INTERFACE (TUI) - {app_name} ({ep})",
            "========================================================================",
            "",
            f" [1] IDEAS REGISTER ({len(ideas)} total):",
        ]
        for idx, item in enumerate(ideas[:5]):
            star = "[*]" if item.get("isStarred") else "[ ]"
            title = item.get("title", "Untitled")
            plat = item.get("platform", "web")
            lines.append(f"     {star} {idx+1}. {title:<36} ({plat})")
        if len(ideas) > 5:
            lines.append(f"     ... and {len(ideas) - 5} more ideas")

        lines.append("")
        frames = canvas.get("frames", [])
        stickies = canvas.get("stickies", [])
        conns = canvas.get("connections", [])
        lines.append(f" [2] LIVE CANVAS TOPOLOGY ({len(frames)} frames, {len(stickies)} stickies, {len(conns)} conns):")
        for f in frames[:3]:
            fw = f.get('width', 360)
            fh = f.get('height', 420)
            lines.append(f"     + Frame: \"{f.get('title')}\" ({fw}x{fh})")
            f_stickies = [s for s in stickies if s.get('frame') == f.get('title') or s.get('frame') == f.get('id')]
            for s in f_stickies[:2]:
                lines.append(f"       - Sticky: \"{s.get('text')}\"")
        for c in conns[:2]:
            lines.append(f"     --> Connection: {c.get('fromId')} -> {c.get('toId')} ({c.get('label')})")

        lines.append("")
        lines.append(f" [3] AI RESILIENT FALLBACK CHAIN:")
        rec = ai_stat.get("active_recommendation", "offline").upper()
        lines.append(f"     Active Provider: {rec}")
        for p in ai_stat.get("providers", []):
            st = "ONLINE" if p.get("available") else "OFFLINE"
            p_name = p.get('name')
            p_det = p.get('details')
            lines.append(f"     - [{st:<7}] {p_name}: {p_det}")

        lines.append("")
        lines.append("========================================================================")
        lines.append(" Interactive navigation available when launched in standard TTY terminal.")
        print("\n".join(lines))
        return

    import curses

    def curses_main(stdscr):
        curses.curs_set(0)
        stdscr.timeout(1000)
        current_tab = 1
        selected_idx = 0

        while True:
            stdscr.clear()
            h, w = stdscr.getmaxyx()
            if h < 18 or w < 60:
                stdscr.addstr(0, 0, "Terminal window too small for Kite TUI. Please resize.")
                stdscr.refresh()
                ch = stdscr.getch()
                if ch in (ord('q'), ord('Q')):
                    break
                continue

            status = api_get(ep, "/api/status")
            ideas = api_get(ep, "/api/ideas").get("ideas", [])
            canvas = api_get(ep, "/api/canvas")

            app_name = status.get('app', 'Kite')
            app_title = f" KITE TUI v1.3.0 | Station: {app_name} ({ep}) "
            stdscr.attron(curses.A_REVERSE)
            stdscr.addstr(0, 0, app_title.ljust(w - 1)[:w - 1])
            stdscr.attroff(curses.A_REVERSE)

            tabs_bar = f" [1] Ideas ({len(ideas)})  [2] Canvas Graph  [3] AI Router  [4] Telemetry "
            stdscr.addstr(1, 0, tabs_bar.ljust(w - 1)[:w - 1])
            stdscr.addstr(2, 0, ("-" * (w - 1))[:w - 1])

            if current_tab == 1:
                max_items = max(1, h - 6)
                if selected_idx >= len(ideas):
                    selected_idx = max(0, len(ideas) - 1)
                for i in range(min(max_items, len(ideas))):
                    item = ideas[i]
                    star = "*" if item.get("isStarred") else " "
                    title = item.get("title", "Untitled")
                    plat = item.get("platform", "web")
                    line_str = f" {star} {title:<40} [{plat}]"
                    if i == selected_idx:
                        stdscr.attron(curses.A_STANDOUT)
                        stdscr.addstr(3 + i, 2, line_str[:w - 4])
                        stdscr.attroff(curses.A_STANDOUT)
                    else:
                        stdscr.addstr(3 + i, 2, line_str[:w - 4])
            elif current_tab == 2:
                frames = canvas.get("frames", [])
                stickies = canvas.get("stickies", [])
                conns = canvas.get("connections", [])
                stdscr.addstr(3, 2, f"Canvas: {len(frames)} frames, {len(stickies)} stickies, {len(conns)} connections")
                row = 5
                for f in frames[:max(1, (h - 8) // 2)]:
                    stdscr.addstr(row, 2, f"+ Frame: {f.get('title')} ({f.get('colorHex')})")
                    row += 1
                for c in conns[:max(1, (h - 8) // 2)]:
                    if row < h - 3:
                        lbl = c.get('label')
                        fid = c.get('fromId', '')[:8]
                        tid = c.get('toId', '')[:8]
                        stdscr.addstr(row, 4, f"-> Connection: {lbl} [{fid}.. -> {tid}..]")
                        row += 1
            elif current_tab == 3:
                ai_stat = check_llm_providers()
                rec_val = ai_stat.get('active_recommendation', '').upper()
                stdscr.addstr(3, 2, f"Active Recommendation: {rec_val}")
                row = 5
                for p in ai_stat.get("providers", []):
                    st = "ONLINE" if p.get("available") else "OFFLINE"
                    p_name = p.get('name')
                    p_det = p.get('details')
                    stdscr.addstr(row, 2, f"[{st:<7}] {p_name}")
                    row += 1
                    stdscr.addstr(row, 4, f"Details: {p_det}")
                    row += 2
            elif current_tab == 4:
                stdscr.addstr(3, 2, f"Station: {status.get('app')}")
                stdscr.addstr(4, 2, f"Port:    {status.get('port')}")
                stdscr.addstr(5, 2, f"Status:  {status.get('status')}")

            footer = " [1-4] Switch Tabs | [j/k/Up/Down] Navigate | [s] Toggle Star | [q] Quit "
            stdscr.attron(curses.A_REVERSE)
            stdscr.addstr(h - 1, 0, footer.ljust(w - 1)[:w - 1])
            stdscr.attroff(curses.A_REVERSE)
            stdscr.refresh()

            try:
                ch = stdscr.getch()
            except Exception:
                break

            if ch in (ord('q'), ord('Q')):
                break
            elif ch in (ord('1'), ord('2'), ord('3'), ord('4')):
                current_tab = int(chr(ch))
            elif ch in (curses.KEY_UP, ord('k')):
                if selected_idx > 0:
                    selected_idx -= 1
            elif ch in (curses.KEY_DOWN, ord('j')):
                if selected_idx < len(ideas) - 1:
                    selected_idx += 1
            elif ch in (ord('s'), ord('S')) and ideas:
                cur_item = ideas[selected_idx]
                cur_item["isStarred"] = not cur_item.get("isStarred", False)
                api_post(ep, "/api/ideas", {"ideas": [cur_item]})

    try:
        curses.wrapper(curses_main)
    except Exception as ex:
        print(f"TUI error: {ex}")

def cmd_tui(args: argparse.Namespace) -> None:
    ep = get_active_endpoint()
    once = getattr(args, "once", False)
    run_tui(ep, once=once)

