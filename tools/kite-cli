class CockpitMonitor:
    def __init__(self, endpoint: str = MAC_ENDPOINT) -> None:
        self.endpoint = endpoint
        self.events: deque = deque(maxlen=8)
        self.running = True
        self.lock = threading.Lock()
        self.sse_thread = threading.Thread(target=self._sse_loop, daemon=True)
        self.sse_thread.start()

    def stop(self) -> None:
        self.running = False

    def _sse_loop(self) -> None:
        while self.running:
            try:
                req = urllib.request.Request(f"{self.endpoint}/api/events")
                with urllib.request.urlopen(req, timeout=10.0) as resp:
                    for line in resp:
                        if not self.running:
                            break
                        line_str = line.decode("utf-8", errors="ignore").strip()
                        if line_str.startswith("data:"):
                            payload_str = line_str[5:].strip()
                            t_str = time.strftime("%H:%M:%S")
                            try:
                                d = json.loads(payload_str)
                                ev_type = str(d.get("type", "EVENT")).upper()
                                if ev_type == "CONNECTED":
                                    app_name = d.get("app", "Kite")
                                    app_port = d.get("port", 24242)
                                    desc = f"Connected to {app_name} (port {app_port})"
                                elif ev_type == "CANVAS_UPDATED":
                                    desc = "Canvas topology updated"
                                elif ev_type == "IDEAS_UPDATED":
                                    count = d.get("payload", {}).get("imported", 0)
                                    desc = f"Ideas catalog updated (count: {count})"
                                else:
                                    p = d.get("payload") or d
                                    desc = json.dumps(p)
                                with self.lock:
                                    self.events.append(f"[{t_str}] [{ev_type}] {desc}")
                            except Exception:
                                with self.lock:
                                    self.events.append(f"[{t_str}] [RAW] {payload_str[:60]}")
            except Exception:
                time.sleep(2.0)

    def snapshot(self) -> Dict[str, Any]:
        def probe(url: str) -> Optional[Dict[str, Any]]:
            try:
                req = urllib.request.Request(url, headers={"Accept": "application/json"})
                with urllib.request.urlopen(req, timeout=1.0) as resp:
                    return json.loads(resp.read().decode("utf-8"))
            except Exception:
                return None

        status_mac = probe(f"{MAC_ENDPOINT}/api/status")
        status_win = probe(f"{WIN_ENDPOINT}/api/status")
        peers = probe(f"{self.endpoint}/api/peers") or []
        ideas_obj = probe(f"{self.endpoint}/api/ideas") or {}
        canvas_obj = probe(f"{self.endpoint}/api/canvas") or {}

        ideas = ideas_obj.get("ideas", [])
        frames = canvas_obj.get("frames", [])
        stickies = canvas_obj.get("stickies", [])
        connectors = canvas_obj.get("connections", []) or canvas_obj.get("connectors", [])

        starred = sum(1 for i in ideas if i.get("isStarred"))
        in_prog = sum(1 for i in ideas if i.get("status") == "in_progress")
        shipped = sum(1 for i in ideas if i.get("status") in ["shipped", "done"])
        backlog = sum(1 for i in ideas if i.get("status") in ["backlog", "idea", "todo"])

        with self.lock:
            ev_list = list(self.events)

        return {
            "endpoint": self.endpoint,
            "mac": status_mac,
            "win": status_win,
            "peers": peers,
            "ideas_total": len(ideas),
            "ideas_starred": starred,
            "ideas_in_prog": in_prog,
            "ideas_shipped": shipped,
            "ideas_backlog": backlog,
            "canvas_frames": len(frames),
            "canvas_stickies": len(stickies),
            "canvas_connectors": len(connectors),
            "events": ev_list
        }

def render_cockpit(snap: Dict[str, Any], use_ansi: bool = True) -> str:
    C_RESET = "\033[0m" if use_ansi else ""
    C_BOLD = "\033[1m" if use_ansi else ""
    C_CYAN = "\033[1;36m" if use_ansi else ""
    C_DIM = "\033[90m" if use_ansi else ""

    W = 74
    lines = []
    lines.append(f"{C_CYAN}┌" + "─" * W + f"┐{C_RESET}")
    hdr = "  KITE TELEMETRY COCKPIT | ECOSYSTEM MONITOR"
    lines.append(f"{C_CYAN}│{C_RESET} {C_BOLD}{hdr:<72}{C_RESET} {C_CYAN}│{C_RESET}")
    lines.append(f"{C_CYAN}├" + "─" * W + f"┤{C_RESET}")

    # Stations & Mesh Topology
    sec1 = "1. STATIONS & MESH TOPOLOGY"
    lines.append(f"{C_CYAN}│{C_RESET} {C_BOLD}{sec1:<72}{C_RESET} {C_CYAN}│{C_RESET}")

    mac = snap.get("mac")
    if mac:
        m_app = mac.get("app", "Kite")
        m_ver = mac.get("version", "1.0")
        m_port = mac.get("port", 24242)
        mac_line = f"  * macOS Station:   ONLINE  ({m_app}, v{m_ver}, port {m_port})"
    else:
        mac_line = "  * macOS Station:   OFFLINE (port 24242)"
    lines.append(f"{C_CYAN}│{C_RESET} {mac_line:<72} {C_CYAN}│{C_RESET}")

    win = snap.get("win")
    if win:
        w_app = win.get("app", "KiteWin")
        w_ver = win.get("version", "1.0")
        w_port = win.get("port", 24243)
        win_line = f"  * Windows Station: ONLINE  ({w_app}, v{w_ver}, port {w_port})"
    else:
        win_line = "  * Windows Station: STANDBY / OFFLINE (listening on port 24243)"
    lines.append(f"{C_CYAN}│{C_RESET} {win_line:<72} {C_CYAN}│{C_RESET}")

    peers = snap.get("peers", [])
    peer_line = f"  * LAN Peer Mesh:   {len(peers)} active peer(s) discovered (UDP 24244)"
    lines.append(f"{C_CYAN}│{C_RESET} {peer_line:<72} {C_CYAN}│{C_RESET}")
    for p in peers[:3]:
        p_name = p.get("name", "Kite")
        p_ip = p.get("ip", "127.0.0.1")
        p_port = p.get("port", 24242)
        p_info = f"    - Node: {p_name} @ {p_ip}:{p_port}"
        lines.append(f"{C_CYAN}│{C_RESET} {p_info:<72} {C_CYAN}│{C_RESET}")

    lines.append(f"{C_CYAN}├" + "─" * W + f"┤{C_RESET}")

    # Workspace & Topology
    sec2 = "2. WORKSPACE & TOPOLOGY INVENTORY"
    lines.append(f"{C_CYAN}│{C_RESET} {C_BOLD}{sec2:<72}{C_RESET} {C_CYAN}│{C_RESET}")

    i_tot = snap.get("ideas_total", 0)
    i_star = snap.get("ideas_starred", 0)
    i_act = snap.get("ideas_in_prog", 0)
    i_ship = snap.get("ideas_shipped", 0)
    ideas_line = f"  * Ideas Catalog:   {i_tot} total | {i_star} starred | {i_act} in-progress | {i_ship} shipped"
    lines.append(f"{C_CYAN}│{C_RESET} {ideas_line:<72} {C_CYAN}│{C_RESET}")

    c_fr = snap.get("canvas_frames", 0)
    c_st = snap.get("canvas_stickies", 0)
    c_cn = snap.get("canvas_connectors", 0)
    canvas_line = f"  * Topology Canvas: {c_fr} frames | {c_st} stickies | {c_cn} connectors"
    lines.append(f"{C_CYAN}│{C_RESET} {canvas_line:<72} {C_CYAN}│{C_RESET}")

    lines.append(f"{C_CYAN}├" + "─" * W + f"┤{C_RESET}")

    # SSE Event Stream
    sec3 = "3. LIVE TELEMETRY BUS (SSE: /api/events)"
    lines.append(f"{C_CYAN}│{C_RESET} {C_BOLD}{sec3:<72}{C_RESET} {C_CYAN}│{C_RESET}")
    events = snap.get("events", [])
    if events:
        for ev in events[-5:]:
            clean_ev = f"  {ev[:70]}"
            lines.append(f"{C_CYAN}│{C_RESET} {clean_ev:<72} {C_CYAN}│{C_RESET}")
