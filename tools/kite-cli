export interface DomainEvent<T = any> {{
  id: string;
  topic: string;
  timestamp: string;
  payload: T;
}}

export type EventHandler<T> = (event: DomainEvent<T>) => void | Promise<void>;

export class EventBus {{
  private listeners = new Map<string, EventHandler<any>[]>();

  subscribe<T>(topic: string, handler: EventHandler<T>): () => void {{
    const current = this.listeners.get(topic) || [];
    current.push(handler);
    this.listeners.set(topic, current);

    return () => {{
      const updated = (this.listeners.get(topic) || []).filter(h => h !== handler);
      this.listeners.set(topic, updated);
    }};
  }}

  async publish<T>(topic: string, payload: T): Promise<void> {{
    const event: DomainEvent<T> = {{
      id: crypto.randomUUID(),
      topic,
      timestamp: new Date().toISOString(),
      payload
    }};

    const handlers = this.listeners.get(topic) || [];
    await Promise.all(handlers.map(h => h(event)));
  }}
}}
