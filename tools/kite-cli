def cmd_sync(args: argparse.Namespace) -> None:
    local_ep = get_active_endpoint()
    peer_ep = args.peer or ("http://127.0.0.1:24243" if "24242" in local_ep else "http://127.0.0.1:24242")
    print(f"Syncing local station ({local_ep}) with peer ({peer_ep})...")
    try:
        p_status = api_get(peer_ep, "/api/status")
        print(f"Peer is online: {p_status.get('app')} ({p_status.get('version')})")
        peer_ideas = api_get(peer_ep, "/api/ideas")
        res = api_post(local_ep, "/api/ideas", peer_ideas)
        print(f"Imported {res.get('imported', 0)} ideas from peer.")
        peer_canvas = api_get(peer_ep, "/api/canvas")
        c_res = api_post(local_ep, "/api/canvas", peer_canvas)
        print(f"Canvas sync status: {c_res.get('status')}")
    except Exception as ex:
        print(f"Sync error: {ex}")

