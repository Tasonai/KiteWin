                    canvas = api_get(ep, "/api/canvas")
                    matched = None
                    if q:
                        matched = next((i for i in ideas if q.lower() in i.get("title", "").lower() or q.lower() in i.get("id", "").lower()), None)
                    else:
                        matched = next((i for i in ideas if i.get("isStarred")), ideas[0] if ideas else None)

                    if not matched:
                        matched = {
                            "title": "Kite Architecture Project",
                            "concept": "Integrated cross-platform workspace for architecture and system design.",
                            "platform": "desktop",
                            "preferredStyle": "Editorial & Swiss Modern"
                        }
                    slug = "".join(c if c.isalnum() else "-" for c in matched.get("title", "app").lower()).strip("-") or "kite-project"
                    target_dir = out_path or f"./exported-{slug}"
                    res = scaffold_full_project(matched, canvas, out_dir=target_dir, dry_run=dry_run)
                    rendered = format_export_project_report(res, use_ansi=False)
                    send_response({
                        "jsonrpc": "2.0",
                        "id": msg_id,
                        "result": {
                            "content": [{"type": "text", "text": rendered}]
                        }
                    })

                elif tool_name == "kite_replay":
                    action = args.get("action", "list")
                    target = args.get("target")
                    msg = args.get("message")
                    canvas = api_get(ep, "/api/canvas")
                    cur_hash = compute_canvas_hash(canvas)
                    history = load_replay_history()
                    if not history:
                        baseline = record_replay_checkpoint(canvas, "Initial architecture baseline")
                        history = [baseline]

                    if action == "record":
                        rec_msg = msg or "Architecture mutation checkpoint"
                        new_rec = record_replay_checkpoint(canvas, rec_msg)
                        out_text = f"Recorded architecture checkpoint #{new_rec['index']} ({new_rec['hash']}): {rec_msg}"
                    elif action == "rollback":
                        if not target:
                            out_text = "Error: target checkpoint index or hash is required for rollback."
                        else:
                            matched = None
                            for r in history:
                                if str(r.get("index")) == target or r.get("id") == target or r.get("hash", "").startswith(target):
                                    matched = r
                                    break
                            if not matched:
                                out_text = f"Error: Checkpoint '{target}' not found in history."
                            else:
                                payload = {
                                    "replace": True,
                                    "frames": matched["state"].get("frames", []),
                                    "stickies": matched["state"].get("stickies", []),
                                    "connections": matched["state"].get("connections", []),
                                    "referenceCards": matched["state"].get("referenceCards", [])
                                }
                                api_post(ep, "/api/canvas", payload)
                                record_replay_checkpoint(matched["state"], f"Rollback to checkpoint #{matched['index']} ({matched['hash']})")
                                out_text = f"Successfully rolled back live canvas to checkpoint #{matched['index']} [{matched['hash']}]: {matched['message']}"
                    elif action == "diff":
                        matched = None
                        if target:
                            for r in history:
                                if str(r.get("index")) == target or r.get("id") == target or r.get("hash", "").startswith(target):
                                    matched = r
                                    break
                        else:
                            matched = history[-1]
                        if not matched:
                            out_text = f"Error: Checkpoint '{target}' not found."
                        else:
                            diff = compute_replay_diff(matched.get("state", {}), canvas)
                            from_desc = f"Checkpoint #{matched['index']} ({matched['hash']})"
                            to_desc = f"Live Canvas ({cur_hash})"
                            out_text = format_replay_diff_report(diff, from_desc, to_desc, use_ansi=False)
                    elif action == "step":
                        out_text = format_replay_step_evolution(history, use_ansi=False)
                    else:
                        out_text = format_replay_list(history, cur_hash, use_ansi=False)

                    send_response({
                        "jsonrpc": "2.0",
                        "id": msg_id,
                        "result": {
                            "content": [{"type": "text", "text": out_text}]
                        }
                    })

                else:
                    send_response({
                        "jsonrpc": "2.0",
                        "id": msg_id,
                        "error": {
                            "code": -32601,
                            "message": f"Method {tool_name} not found"
                        }
                    })

            elif msg_id is not None:
                send_response({
                    "jsonrpc": "2.0",
                    "id": msg_id,
                    "error": {
                        "code": -32601,
                        "message": f"Unrecognized method {method}"
                    }
                })

        except Exception as ex:
            sys.stderr.write(f"MCP Server error: {ex}\n")

