def scaffold_project_files(parent_folder: str, title: str, concept: str = "", platform: str = "web", style: str = "Editorial & Swiss Modern", git_branch: bool = True) -> Dict[str, Any]:
    slug = "".join(c if c.isalnum() else "-" for c in title.lower()).strip("-")
    if not slug:
        slug = "kite-project"
    project_dir = os.path.join(parent_folder, slug)
    os.makedirs(project_dir, exist_ok=True)
    planning_dir = os.path.join(project_dir, ".planning")
    phases_dir = os.path.join(planning_dir, "phases", "01-foundation")
    os.makedirs(phases_dir, exist_ok=True)

    files_created = []

    def write_f(path, content):
        with open(path, "w", encoding="utf-8") as f:
            f.write(content)
        files_created.append(os.path.relpath(path, project_dir))

    write_f(os.path.join(project_dir, "README.md"), f"# {title}\n\n> Platform: {platform}\n> Style: {style}\n> Scaffolded by Kite Studio\n\n## Concept\n{concept or 'User scenario and problem statement.'}\n")
    spec_content = f"# PRD & Specification: {title}\n\n## Target Platform\n{platform}\n\n## Style System\n{style}\n\n## Architecture\n- Local-first architecture\n- Zero Emojis compliance\n- 4pt/8pt modular grid\n"
    write_f(os.path.join(project_dir, "SPEC.md"), spec_content)
    write_f(os.path.join(project_dir, "PRD.md"), spec_content)
    write_f(os.path.join(project_dir, "PLAN.md"), f"# Implementation Plan: {title}\n\n## Phase 1: Foundation\n- Setup project structure\n- Local persistence\n\n## Phase 2: Feature Development\n- Core business flow\n")
    write_f(os.path.join(project_dir, "DESIGN.md"), f"# Design System: {style}\n\n## Tokens\n- Modular Grid: 4pt/8pt\n- Elevation: Clean borders, soft shadows\n")
    write_f(os.path.join(planning_dir, "PROJECT.md"), f"# Project Constitution: {title}\n\n## Mission\n{concept or title}\n")
    write_f(os.path.join(planning_dir, "ROADMAP.md"), f"# Roadmap: {title}\n\n## Phase 1: Foundation\n- [ ] Data models and storage\n\n## Phase 2: User Interface\n- [ ] Visual polish\n")
    write_f(os.path.join(planning_dir, "STATE.md"), f"# Project State\n\n- Active Phase: Phase 1\n- Status: In Progress\n")
    write_f(os.path.join(phases_dir, "PLAN.md"), f"# Phase 1 Plan\n\n1. Initialize repository\n2. Setup storage\n3. Verify tests\n")
    write_f(os.path.join(project_dir, "CLAUDE.md"), f"# Engineering Guidelines for {title}\n\n## Standard\n- Zero Emojis\n- 4pt/8pt modular grid\n- Local-first persistence\n")
    write_f(os.path.join(project_dir, ".gitignore"), ".DS_Store\nnode_modules/\nbin/\nobj/\ndist/\n*.log\n")

    git_message = ""
    if git_branch:
        try:
            import subprocess
            subprocess.run(["git", "init"], cwd=project_dir, stdout=subprocess.PIPE, stderr=subprocess.PIPE)
            branch = f"feature/kite-{slug}"
            subprocess.run(["git", "checkout", "-B", branch], cwd=project_dir, stdout=subprocess.PIPE, stderr=subprocess.PIPE)
            subprocess.run(["git", "add", "."], cwd=project_dir, stdout=subprocess.PIPE, stderr=subprocess.PIPE)
            subprocess.run(["git", "commit", "-m", f"feat: scaffold planning specs for {title}"], cwd=project_dir, stdout=subprocess.PIPE, stderr=subprocess.PIPE)
            git_message = f"Git branch '{branch}' created with initial commit."
        except Exception as e:
            git_message = f"Git error: {e}"

    return {
        "directory": project_dir,
        "files": files_created,
        "gitMessage": git_message
    }

def cmd_import_repo(args: argparse.Namespace) -> None:
    folder = os.path.abspath(args.path or ".")
    name = os.path.basename(folder)
    ep = get_active_endpoint()
    print(f"Analyzing codebase at {folder}...")

    project_type = "Generic Project"
    ui_nodes = []
    service_nodes = []
    data_nodes = []

    if os.path.exists(os.path.join(folder, "Package.swift")):
        project_type = "Swift SPM Package"
    elif any(f.endswith(".csproj") or f.endswith(".sln") for f in os.listdir(folder) if os.path.isfile(os.path.join(folder, f))):
        project_type = ".NET 10 / WinUI 3"
    elif os.path.exists(os.path.join(folder, "package.json")):
        project_type = "TypeScript / Modern Web"

    for root, dirs, files in os.walk(folder):
        if any(skip in root for skip in [".git", "node_modules", "bin", "obj", ".build"]):
            continue
        for d in dirs:
            low = d.lower()
            if any(k in low for k in ["view", "page", "ui", "component"]):
                ui_nodes.append(d)
            elif any(k in low for k in ["service", "sync", "controller", "api", "kit"]):
                service_nodes.append(d)
            elif any(k in low for k in ["model", "data", "store", "db", "persistence"]):
                data_nodes.append(d)

    if not ui_nodes: ui_nodes = ["Views & Controls", "Design Tokens", "Navigation HUD"]
    if not service_nodes: service_nodes = ["P2P Sync Engine", "AI Generator Service", "REST Client"]
    if not data_nodes: data_nodes = ["Local Store (WAL)", "Cache Index", "Schema Models"]

    frames = [
        {"id": "frame-ui", "title": f"UI & Presentation Layer ({project_type})", "colorHex": "#3B82F6", "x": 80, "y": 80, "width": 340, "height": 420},
        {"id": "frame-srv", "title": "Domain Services & P2P", "colorHex": "#10B981", "x": 480, "y": 80, "width": 340, "height": 420},
        {"id": "frame-db", "title": "Data Persistence & State", "colorHex": "#8B5CF6", "x": 880, "y": 80, "width": 340, "height": 420}
    ]

    stickies = []
    connections = []

    last_ui_id = ""
    for idx, node in enumerate(ui_nodes[:3]):
        sid = f"s-ui-{idx}"
        stickies.append({"id": sid, "text": f"UI: {node}", "colorHex": "#DBEAFE", "position": [100, 140 + idx * 110]})
        last_ui_id = sid

    last_srv_id = ""
    for idx, node in enumerate(service_nodes[:3]):
        sid = f"s-srv-{idx}"
        stickies.append({"id": sid, "text": f"Service: {node}", "colorHex": "#D1FAE5", "position": [500, 140 + idx * 110]})
        last_srv_id = sid

    last_db_id = ""
    for idx, node in enumerate(data_nodes[:3]):
        sid = f"s-db-{idx}"
        stickies.append({"id": sid, "text": f"Storage: {node}", "colorHex": "#EDE9FE", "position": [900, 140 + idx * 110]})
        last_db_id = sid

    if last_ui_id and last_srv_id:
        connections.append({"id": "conn-ui-srv", "fromId": last_ui_id, "toId": last_srv_id, "label": "HTTP / SSE", "colorHex": "#3B82F6"})
    if last_srv_id and last_db_id:
        connections.append({"id": "conn-srv-db", "fromId": last_srv_id, "toId": last_db_id, "label": "WAL Query", "colorHex": "#10B981"})

    canvas_payload = {
        "version": 1,
        "exportedAt": "2026-11-06T12:00:00Z",
        "frames": frames,
        "stickies": stickies,
        "referenceCards": [],
        "connections": connections
    }

    res = api_post(ep, "/api/canvas", canvas_payload)
    print(f"Imported architecture for '{name}' ({project_type}):")
    print(f"  + Frames: {len(frames)}")
    print(f"  + Stickies: {len(stickies)}")
    print(f"  + Connections: {len(connections)}")
    print(f"Live status: {res.get('status', 'ok')}")

def cmd_co_architect(args: argparse.Namespace) -> None:
    ep = get_active_endpoint()
    canvas = api_get(ep, "/api/canvas")
    frames = canvas.get("frames", [])
    stickies = canvas.get("stickies", [])
    connections = canvas.get("connections", [])

    print(f"AI Co-Architect: Analyzing canvas ({len(frames)} frames, {len(stickies)} stickies)...")

    gaps = [
        {
            "frame": "Security & Auth Boundary",
            "sticky": "JWT / Session Guard + Rate Limiter",
            "colorHex": "#FCE7F3",
            "from": stickies[0]["id"] if stickies else None,
            "label": "Secures"
        },
        {
            "frame": "Cache & Acceleration",
            "sticky": "In-Memory State WAL + LRU Cache",
            "colorHex": "#FEF3C7",
            "from": stickies[1]["id"] if len(stickies) > 1 else None,
            "label": "Caches"
        },
        {
            "frame": "Observability & Metrics",
            "sticky": "Structured Audit Log + Prometheus / OpenTelemetry",
            "colorHex": "#E0E7FF",
            "from": stickies[0]["id"] if stickies else None,
            "label": "Audits"
        }
    ]

    import time
    start_x = 100
    if frames:
        start_x = max(f.get("x", 0) + f.get("width", 320) for f in frames) + 60

    added = 0
    now = int(time.time())
    for idx, g in enumerate(gaps):
        fid = f"frame-ai-{now}-{idx}"
        sid = f"sticky-ai-{now}-{idx}"
        frames.append({
            "id": fid,
            "title": g["frame"],
            "colorHex": "#EC4899",
            "x": start_x,
            "y": 100,
            "width": 320,
            "height": 300
        })
        stickies.append({
            "id": sid,
            "text": g["sticky"],
            "colorHex": g["colorHex"],
            "position": [start_x + 20, 160]
        })
        if g.get("from"):
            connections.append({
                "id": f"conn-ai-{now}-{idx}",
                "fromId": g["from"],
                "toId": sid,
                "label": g["label"],
                "colorHex": "#EC4899"
            })
        start_x += 360
        added += 1

    canvas_payload = {
        "version": 1,
        "exportedAt": "2026-11-06T12:00:00Z",
        "frames": frames,
        "stickies": stickies,
        "referenceCards": [],
        "connections": connections
    }
    res = api_post(ep, "/api/canvas", canvas_payload)
    print(f"AI Co-Architect: Added {added} architectural defense modules with arrows.")
    print(f"Canvas updated: {res.get('status', 'ok')}")

