    C_BOLD = "\033[1m" if use_ansi else ""
    C_CYAN = "\033[1;36m" if use_ansi else ""
    C_DIM = "\033[90m" if use_ansi else ""

    W = 74
    lines = []
    lines.append(f"{C_CYAN}┌" + "─" * W + f"┐{C_RESET}")
    hdr = "  KITE TELEMETRY COCKPIT | ECOSYSTEM MONITOR"
    lines.append(f"{C_CYAN}│{C_RESET} {C_BOLD}{hdr:<72}{C_RESET} {C_CYAN}│{C_RESET}")
    lines.append(f"{C_CYAN}├" + "─" * W + f"┤{C_RESET}")

    # Stations & Mesh Topology
    sec1 = "1. STATIONS & MESH TOPOLOGY"
    lines.append(f"{C_CYAN}│{C_RESET} {C_BOLD}{sec1:<72}{C_RESET} {C_CYAN}│{C_RESET}")

