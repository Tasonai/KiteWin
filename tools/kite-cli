def canvas_add_sticky(canvas: Dict[str, Any], text: str, color: Optional[str] = None, frame_name: Optional[str] = None, x: Optional[float] = None, y: Optional[float] = None) -> Dict[str, Any]:
    hex_color = CANVAS_COLOR_MAP.get((color or "").lower(), color if (color and color.startswith("#")) else "#FEF08A")
    sticky_id = str(uuid.uuid4())
    frames = canvas.get("frames", [])
    target_frame = None
    if frame_name:
        fn = frame_name.lower()
        target_frame = next((f for f in frames if fn in f.get("title", "").lower() or fn == f.get("id", "").lower()), None)

    if x is not None and y is not None:
        pos_x, pos_y = float(x), float(y)
    elif target_frame:
        fx = target_frame.get("x", 100)
        fy = target_frame.get("y", 100)
        fw = target_frame.get("width", 360)
        fh = target_frame.get("height", 420)
        inside = [s for s in canvas.get("stickies", []) if fx <= (s.get("position", [0, 0])[0] if isinstance(s.get("position"), list) else s.get("position", {}).get("x", 0)) <= fx + fw and fy <= (s.get("position", [0, 0])[1] if isinstance(s.get("position"), list) else s.get("position", {}).get("y", 0)) <= fy + fh]
        pos_x = fx + 40
        pos_y = fy + 80 + len(inside) * 60
    else:
        existing = canvas.get("stickies", [])
        idx = len(existing)
        pos_x = 120 + (idx % 4) * 240
        pos_y = 120 + (idx // 4) * 160

    new_sticky = {
        "id": sticky_id,
        "text": text,
        "colorHex": hex_color,
        "position": [pos_x, pos_y]
    }
    stickies = canvas.get("stickies", [])
    stickies.append(new_sticky)
    canvas["stickies"] = stickies
    return new_sticky

def canvas_add_frame(canvas: Dict[str, Any], title: str, color: Optional[str] = None, x: Optional[float] = None, y: Optional[float] = None, width: Optional[float] = None, height: Optional[float] = None) -> Dict[str, Any]:
    hex_color = CANVAS_FRAME_COLOR_MAP.get((color or "").lower(), color if (color and color.startswith("#")) else "#3B82F6")
    frame_id = str(uuid.uuid4())
    frames = canvas.get("frames", [])

    if x is not None and y is not None:
        pos_x, pos_y = float(x), float(y)
    else:
        pos_x = 80 + len(frames) * 400
        pos_y = 80

    w = float(width or 360)
    h = float(height or 440)

    new_frame = {
        "id": frame_id,
        "title": title,
        "colorHex": hex_color,
        "x": pos_x,
        "y": pos_y,
        "width": w,
        "height": h
    }
    frames.append(new_frame)
    canvas["frames"] = frames
    return new_frame

def canvas_connect(canvas: Dict[str, Any], from_query: str, to_query: str, label: str = "", proto: str = "REST") -> Optional[Dict[str, Any]]:
    stickies = canvas.get("stickies", [])
    frames = canvas.get("frames", [])

    def find_node(q: str) -> Optional[str]:
        ql = q.lower()
        for s in stickies:
            if s.get("id", "").lower() == ql:
                return s.get("id")
        for f in frames:
            if f.get("id", "").lower() == ql:
                return f.get("id")
        for s in stickies:
            if ql in s.get("text", "").lower():
                return s.get("id")
        for f in frames:
            if ql in f.get("title", "").lower():
                return f.get("id")
        return None

    from_id = find_node(from_query)
    to_id = find_node(to_query)

    if not from_id or not to_id:
        return None

    proto_name = proto if proto in CANVAS_PROTO_COLOR_MAP else "REST"
    proto_color = CANVAS_PROTO_COLOR_MAP.get(proto_name, "#3B82F6")
    conn_id = str(uuid.uuid4())
    conn_label = label or proto_name

    new_conn = {
        "id": conn_id,
        "fromId": from_id,
        "toId": to_id,
        "label": conn_label,
        "colorHex": proto_color
    }

    conns = canvas.get("connections", []) or canvas.get("connectors", [])
    conns.append(new_conn)
    canvas["connections"] = conns
    return new_conn

def canvas_delete_node(canvas: Dict[str, Any], target_query: str) -> int:
    tq = target_query.lower()
    del_count = 0
    del_ids = set()

    orig_s = canvas.get("stickies", [])
    new_s = []
    for s in orig_s:
        if s.get("id", "").lower() == tq or tq in s.get("text", "").lower():
            del_count += 1
            del_ids.add(s.get("id"))
        else:
            new_s.append(s)
    canvas["stickies"] = new_s

    orig_f = canvas.get("frames", [])
    new_f = []
    for f in orig_f:
        if f.get("id", "").lower() == tq or tq in f.get("title", "").lower():
            del_count += 1
            del_ids.add(f.get("id"))
        else:
            new_f.append(f)
    canvas["frames"] = new_f

    orig_c = canvas.get("connections", []) or canvas.get("connectors", [])
    new_c = [c for c in orig_c if c.get("fromId") not in del_ids and c.get("toId") not in del_ids]
    canvas["connections"] = new_c

    return del_count

def canvas_clear(canvas: Dict[str, Any]) -> None:
    canvas["frames"] = []
    canvas["stickies"] = []
    canvas["connections"] = []
    canvas["referenceCards"] = []

def cmd_canvas(args: argparse.Namespace) -> None:
    action = getattr(args, "action", "export")
    ep = get_active_endpoint()
    canvas = api_get(ep, "/api/canvas")

    if action == "export":
        fmt = getattr(args, "format", "stitch")
        if fmt == "json":
            print(json.dumps(canvas, indent=2, ensure_ascii=False))
        elif fmt == "stitch":
            print("# Google Stitch — DESIGN.md")
            print("\n## Canvas Architecture Blueprint")
            print(f"- Exported At: {canvas.get('exportedAt', '')}")
            print(f"- Total Frames: {len(canvas.get('frames', []))}")
            print(f"- Total Stickies: {len(canvas.get('stickies', []))}")
            print("\n### Frames:")
            for f in canvas.get("frames", []):
                print(f"- {f.get('title')} ({f.get('width')}x{f.get('height')})")
            print("\n### Stickies & Architectural Directives:")
            for s in canvas.get("stickies", []):
                print(f"- {s.get('text')}")
        elif fmt == "mermaid":
            print(generate_canvas_mermaid(canvas))
        elif fmt == "plantuml":
            print(generate_canvas_plantuml(canvas))
        elif fmt == "openapi":
            print(generate_canvas_openapi(canvas))
        else:
            print(json.dumps(canvas, indent=2, ensure_ascii=False))
        return

    if action == "add-sticky":
        text = getattr(args, "target", "") or ""
        if not text:
            print("Error: sticky text is required (e.g. kite canvas add-sticky \"API Gateway\")")
            sys.exit(1)
        color = getattr(args, "color", "")
        frame_name = getattr(args, "frame", "")
        x = getattr(args, "x", None)
        y = getattr(args, "y", None)

        sticky = canvas_add_sticky(canvas, text, color=color, frame_name=frame_name, x=x, y=y)
        canvas["replace"] = True
        res = api_post(ep, "/api/canvas", canvas)
        pos = sticky.get("position", [0, 0])
        print(f"[+] Added sticky to canvas: \"{text}\" (ID: {sticky['id']}, pos: [{pos[0]:.0f}, {pos[1]:.0f}], status: {res.get('status', 'ok')})")
        return

    if action == "add-frame":
        title = getattr(args, "target", "") or ""
        if not title:
            print("Error: frame title is required (e.g. kite canvas add-frame \"Domain Services\")")
            sys.exit(1)
        color = getattr(args, "color", "")
        x = getattr(args, "x", None)
        y = getattr(args, "y", None)
        w = getattr(args, "width", 360)
        h = getattr(args, "height", 420)

        frame = canvas_add_frame(canvas, title, color=color, x=x, y=y, width=w, height=h)
        canvas["replace"] = True
        res = api_post(ep, "/api/canvas", canvas)
        print(f"[+] Added frame to canvas: \"{title}\" (ID: {frame['id']}, size: {w:.0f}x{h:.0f}, status: {res.get('status', 'ok')})")
        return

    if action == "connect":
        from_q = getattr(args, "target", "")
        to_q = getattr(args, "target2", "")
        if not from_q or not to_q:
            print("Error: source and destination are required (e.g. kite canvas connect \"Client\" \"API\" --proto REST)")
            sys.exit(1)
        label = getattr(args, "label", "")
        proto = getattr(args, "proto", "REST")

        conn = canvas_connect(canvas, from_q, to_q, label=label, proto=proto)
        if not conn:
            print(f"Error: Could not locate nodes matching \"{from_q}\" and \"{to_q}\" on canvas.")
            sys.exit(1)
        canvas["replace"] = True
        res = api_post(ep, "/api/canvas", canvas)
        print(f"[+] Connected \"{from_q}\" -> \"{to_q}\" via {conn['label']} (proto: {proto}, color: {conn['colorHex']}, status: {res.get('status', 'ok')})")
        return

    if action == "delete":
        target = getattr(args, "target", "")
        if not target:
            print("Error: target node ID, title, or text is required (e.g. kite canvas delete \"API Gateway\")")
            sys.exit(1)
        del_count = canvas_delete_node(canvas, target)
        if del_count == 0:
            print(f"Warning: No node matching \"{target}\" found on canvas.")
            return
        canvas["replace"] = True
        res = api_post(ep, "/api/canvas", canvas)
        print(f"[+] Deleted {del_count} node(s) and cleaned orphan connections matching \"{target}\" (status: {res.get('status', 'ok')})")
        return

    if action == "clear":
        canvas_clear(canvas)
        canvas["replace"] = True
        res = api_post(ep, "/api/canvas", canvas)
        print(f"[+] Canvas cleared completely (status: {res.get('status', 'ok')})")
        return

