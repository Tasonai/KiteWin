def run_build_dist(version: str = "1.3.0", update_cask: bool = True) -> Dict[str, Any]:
    mac_root = "/Users/tasonai/Developer/Kite"
    dmg_script = os.path.join(mac_root, "tools", "make_dmg.sh")
    cask_path = os.path.join(mac_root, "packaging", "homebrew", "kite.rb")
    dist_dir = os.path.join(mac_root, "dist")

    if not os.path.isfile(dmg_script):
        return {"status": "error", "message": "tools/make_dmg.sh not found"}

    proc = subprocess.run(["zsh", dmg_script, version], cwd=mac_root, capture_output=True, text=True)
    if proc.returncode != 0:
        err_msg = proc.stderr or proc.stdout
        return {
            "status": "failed",
            "message": f"make_dmg.sh failed: {err_msg}",
            "stdout": proc.stdout,
            "stderr": proc.stderr
        }

    dmg_file = os.path.join(dist_dir, f"Kite-{version}-macOS.dmg")
    zip_file = os.path.join(dist_dir, f"Kite-{version}-macOS.zip")
    chk_file = os.path.join(dist_dir, "checksums.txt")

    dmg_sha = ""
    zip_sha = ""
    if os.path.isfile(chk_file):
        with open(chk_file, "r", encoding="utf-8") as f:
            for line in f:
                parts = line.strip().split()
                if len(parts) == 2:
                    sha, fname = parts[0], parts[1]
                    if fname.endswith(".dmg"):
                        dmg_sha = sha
                    elif fname.endswith(".zip"):
                        zip_sha = sha

    cask_updated = False
    if update_cask and dmg_sha and os.path.isfile(cask_path):
        try:
            with open(cask_path, "r", encoding="utf-8") as f:
                cask_content = f.read()
            new_content = re.sub(r'sha256\s+"[a-f0-9]+"', f'sha256 "{dmg_sha}"', cask_content)
            new_content = re.sub(r'version\s+"[^"]+"', f'version "{version}"', new_content)
            with open(cask_path, "w", encoding="utf-8") as f:
                f.write(new_content)
            cask_updated = True
        except Exception:
            cask_updated = False

    mount_ok = False
    if os.path.isfile(dmg_file):
        chk = subprocess.run(["hdiutil", "attach", dmg_file, "-nobrowse"], capture_output=True, text=True)
        if chk.returncode == 0:
            vol_kite = "/Volumes/Kite"
            if os.path.isdir(os.path.join(vol_kite, "Kite.app")):
                mount_ok = True
            subprocess.run(["hdiutil", "detach", vol_kite, "-force"], capture_output=True, text=True)

    dmg_size = os.path.getsize(dmg_file) if os.path.isfile(dmg_file) else 0
    zip_size = os.path.getsize(zip_file) if os.path.isfile(zip_file) else 0

    return {
        "status": "passed" if mount_ok and dmg_sha else "failed",
        "version": version,
        "dmg": {
            "path": dmg_file,
            "size": dmg_size,
            "sha256": dmg_sha,
            "mount_verified": mount_ok
        },
        "zip": {
            "path": zip_file,
            "size": zip_size,
            "sha256": zip_sha
        },
        "cask_updated": cask_updated,
        "cask_path": cask_path
    }

