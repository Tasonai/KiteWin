                            text = f"Synthesized {len(artifacts)} engineering artifacts for '{matched.get('title')}':\n\n{files_list}"

                    send_response({
                        "jsonrpc": "2.0",
                        "id": msg_id,
                        "result": {
                            "content": [{"type": "text", "text": text}]
                        }
                    })

                elif tool_name == "kite_diff_canvas":
                    path = args.get("path", ".")
                    apply_sync = args.get("apply", False)
                    canvas = api_get(ep, "/api/canvas")
                    diff = analyze_architecture_drift(os.path.abspath(path), canvas)
                    summary = (
                        f"Architecture Drift Report for {diff['folder']}:\n"
                        f"- Health Score: {diff['health_score']}%\n"
                        f"- Drift Score: {diff['drift_score']}%\n"
                        f"- Total Modules: {diff['total_modules']}\n"
                        f"- Charted: {len(diff['charted'])}\n"
                        f"- Uncharted: {len(diff['uncharted'])}\n"
                        f"- Unimplemented: {len(diff['unimplemented'])}\n"
                    )
                    if apply_sync and diff["uncharted"]:
                        stickies = canvas.get("stickies", [])
                        new_count = 0
                        layer_colors = {"UI": "#DBEAFE", "Service": "#D1FAE5", "Data": "#EDE9FE"}
                        for idx, mod in enumerate(diff["uncharted"][:6]):
                            sid = f"drift-sync-{int(time.time())}-{idx}"
                            stickies.append({
                                "id": sid,
                                "text": f"[{mod['layer']}] {mod['name']}",
                                "colorHex": layer_colors.get(mod["layer"], "#FEF3C7"),
                                "position": [100.0, 560.0 + idx * 100.0]
                            })
                            new_count += 1
                        canvas["stickies"] = stickies
                        res = api_post(ep, "/api/canvas", canvas)
                        summary += f"\nApplied {new_count} uncharted modules to Canvas ({res.get('status', 'ok')})."

                    send_response({
                        "jsonrpc": "2.0",
                        "id": msg_id,
                        "result": {
                            "content": [{"type": "text", "text": summary}]
                        }
                    })

                elif tool_name == "kite_generate_skill":
                    q = args.get("title", "")
                    install_flag = args.get("install", False)
                    canvas = api_get(ep, "/api/canvas")
                    ideas = api_get(ep, "/api/ideas").get("ideas", [])
                    matched = None
                    if q:
                        matched = next((i for i in ideas if q.lower() in i.get("title", "").lower() or q.lower() in i.get("id", "").lower()), None)
                    else:
                        matched = next((i for i in ideas if i.get("isStarred")), ideas[0] if ideas else None)

                    if not matched:
                        matched = {
                            "title": "Kite Architecture",
                            "concept": "Integrated system architecture and synchronization engine.",
                            "platform": "desktop",
                            "preferredStyle": "Editorial & Swiss Modern"
                        }

                    res_skill = generate_antigravity_skill(matched, canvas)
                    skill_name = res_skill["skill_name"]
                    skill_md = res_skill["content"]

                    if install_flag:
                        home = os.path.expanduser("~")
                        dest_dir = os.path.join(home, ".gemini", "config", "skills", skill_name)
                        file_path = os.path.join(dest_dir, "SKILL.md")
                        os.makedirs(dest_dir, exist_ok=True)
                        with open(file_path, "w", encoding="utf-8") as f:
                            f.write(skill_md)
                        out_text = f"Skill successfully installed to {file_path} (name: {skill_name})."
                    else:
                        out_text = f"Synthesized Skill: {skill_name}\n\n```markdown\n{skill_md}\n```"

                    send_response({
                        "jsonrpc": "2.0",
                        "id": msg_id,
                        "result": {
                            "content": [{"type": "text", "text": out_text}]
                        }
                    })

                elif tool_name == "kite_cockpit":
                    m = CockpitMonitor(ep)
                    time.sleep(0.3)
                    snap = m.snapshot()
                    m.stop()
                    rendered = render_cockpit(snap, use_ansi=False)
                    send_response({
                        "jsonrpc": "2.0",
                        "id": msg_id,
                        "result": {
                            "content": [{"type": "text", "text": rendered}]
                        }
                    })

                else:
                    send_response({
                        "jsonrpc": "2.0",
                        "id": msg_id,
                        "error": {
                            "code": -32601,
                            "message": f"Method {tool_name} not found"
                        }
                    })

            elif msg_id is not None:
                send_response({
                    "jsonrpc": "2.0",
                    "id": msg_id,
                    "error": {
                        "code": -32601,
                        "message": f"Unrecognized method {method}"
                    }
                })

        except Exception as ex:
            sys.stderr.write(f"MCP Server error: {ex}\n")

# ==================== MCP SETUP & CLIENT INTEGRATIONS ====================

def get_mcp_client_targets() -> List[Dict[str, Any]]:
    home = os.path.expanduser("~")
    is_win = sys.platform == "win32"
    appdata = os.environ.get("APPDATA", os.path.join(home, "AppData", "Roaming"))
    return [
        {
            "id": "claude",
            "name": "Claude Desktop",
            "path": os.path.join(appdata, "Claude", "claude_desktop_config.json") if is_win else os.path.join(home, "Library", "Application Support", "Claude", "claude_desktop_config.json"),
            "app_dir": os.path.join(appdata, "Claude") if is_win else os.path.join(home, "Library", "Application Support", "Claude"),
            "key": "mcpServers"
        },
        {
            "id": "cursor",
            "name": "Cursor IDE",
            "path": os.path.join(home, ".cursor", "mcp.json"),
            "app_dir": os.path.join(home, ".cursor"),
            "key": "mcpServers"
        },
        {
            "id": "windsurf",
            "name": "Windsurf (Codeium)",
            "path": os.path.join(home, ".codeium", "windsurf", "mcp_config.json"),
            "app_dir": os.path.join(home, ".codeium", "windsurf"),
            "key": "mcpServers"
        },
        {
            "id": "cline",
            "name": "Cline / Roo Code",
            "path": os.path.join(appdata, "Code", "User", "globalStorage", "saoudrizwan.claude-dev", "settings", "cline_mcp_settings.json") if is_win else os.path.join(home, "Library", "Application Support", "Code", "User", "globalStorage", "saoudrizwan.claude-dev", "settings", "cline_mcp_settings.json"),
            "app_dir": os.path.join(appdata, "Code") if is_win else os.path.join(home, "Library", "Application Support", "Code"),
            "key": "mcpServers"
        }
    ]

def resolve_kite_command() -> str:
    which_kite = shutil.which("kite")
    if which_kite:
        return which_kite
    if sys.platform != "win32" and os.path.exists("/usr/local/bin/kite"):
        return "/usr/local/bin/kite"
    return os.path.abspath(sys.argv[0])

def cmd_mcp_setup(action: str = "install", dry_run: bool = False) -> None:
    targets = get_mcp_client_targets()
    kite_cmd = resolve_kite_command()
    mcp_entry = {
        "command": kite_cmd,
        "args": ["mcp"]
    }

    print("=== Kite MCP Integration Manager ===")
    print(f"Action:     {action.upper()}")
    print(f"Kite CLI:   {kite_cmd}")
    if dry_run:
        print("Mode:       DRY RUN (preview only, no files modified)\n")
    else:
        print()

    if action == "status":
        for t in targets:
            name = t["name"]
            path = t["path"]
            app_dir = t["app_dir"]
            if not os.path.exists(path):
                if os.path.exists(app_dir):
                    status_str = "NOT CONFIGURED (App directory detected)"
                else:
                    status_str = "NOT INSTALLED (Client not detected)"
                print(f"  [-] {name:<18} : {status_str}")
                print(f"      Path: {path}")
            else:
                try:
                    with open(path, "r", encoding="utf-8") as f:
                        cfg = json.load(f)
                    servers = cfg.get(t["key"], {})
                    if "kite" in servers:
                        kcfg = servers["kite"]
                        cmd = kcfg.get("command", "")
                        args = " ".join(kcfg.get("args", []))
                        print(f"  [+] {name:<18} : CONFIGURED ({cmd} {args})")
                        print(f"      Path: {path}")
                    else:
                        print(f"  [~] {name:<18} : OTHER MCP SERVERS PRESENT (Kite not added)")
                        print(f"      Path: {path}")
                except Exception as ex:
                    print(f"  [!] {name:<18} : ERROR READING CONFIG ({ex})")
        return

    if action == "install":
        installed_count = 0
        for t in targets:
            name = t["name"]
            path = t["path"]
            app_dir = t["app_dir"]

            if not os.path.exists(path) and not os.path.exists(app_dir):
                if t["id"] != "cursor":
                    continue

            print(f"Configuring {name}...")
            print(f"  Target: {path}")

            cfg: Dict[str, Any] = {}
            if os.path.exists(path):
                try:
                    with open(path, "r", encoding="utf-8") as f:
                        cfg = json.load(f)
                except Exception as ex:
                    print(f"  [!] Warning: could not parse existing JSON ({ex}). Creating backup.")
                    if not dry_run:
                        shutil.copy2(path, path + ".broken.bak")
                    cfg = {}

            if t["key"] not in cfg or not isinstance(cfg[t["key"]], dict):
                cfg[t["key"]] = {}

            existing = cfg[t["key"]].get("kite")
            if existing == mcp_entry:
                print(f"  [=] Kite MCP is already configured with identical parameters.")
                installed_count += 1
                continue

            cfg[t["key"]]["kite"] = mcp_entry

            if dry_run:
                print(f"  [DRY-RUN] Target JSON preview:")
                print("  " + json.dumps({t["key"]: {"kite": mcp_entry}}, indent=2).replace("\n", "\n  "))
            else:
                if os.path.exists(path):
                    shutil.copy2(path, path + ".bak")
                else:
                    os.makedirs(os.path.dirname(path), exist_ok=True)
                with open(path, "w", encoding="utf-8") as f:
                    json.dump(cfg, f, indent=2, ensure_ascii=False)
                    f.write("\n")
                print(f"  [+] Successfully registered Kite MCP server in {name}.")
            installed_count += 1

        print(f"\nSummary: {installed_count} client target(s) processed.")
        return

    if action == "uninstall":
        removed_count = 0
        for t in targets:
            name = t["name"]
            path = t["path"]
            if not os.path.exists(path):
                continue

            try:
                with open(path, "r", encoding="utf-8") as f:
                    cfg = json.load(f)
            except Exception:
                continue

            servers = cfg.get(t["key"], {})
            if "kite" in servers:
                print(f"Removing Kite MCP from {name} ({path})...")
                del cfg[t["key"]]["kite"]
                if dry_run:
                    print("  [DRY-RUN] Key 'kite' would be removed.")
                else:
                    shutil.copy2(path, path + ".bak")
                    with open(path, "w", encoding="utf-8") as f:
                        json.dump(cfg, f, indent=2, ensure_ascii=False)
                        f.write("\n")
                    print(f"  [-] Successfully uninstalled Kite MCP from {name}.")
                removed_count += 1

        print(f"\nSummary: {removed_count} client target(s) updated.")
        return

