        lines.append(f"  {c_dim}... and {t_ep - 8} additional scoped endpoints{c_reset}")

    lines.append("")
    lines.append(f"{c_bold}SYNTHESIZED EVENT CHANNELS (AsyncAPI 3.0):{c_reset}")
    for idx, ch in enumerate(res.get("channels", []), 1):
        lines.append(f"  {c_blue}[{idx}]{c_reset} Channel: {c_bold}{ch.get('channel')}{c_reset}")
        lines.append(f"      Broadcast: {c_dim}{ch.get('summary')}{c_reset}")

    lines.append("")
    if out_path:
        lines.append(f"{c_green}Contract specification saved to:{c_reset} {out_path}")
    else:
        lines.append(f"{c_dim}Run 'kite contract --out openapi.json' to export full OpenAPI 3.1 schema.{c_reset}")
        lines.append(f"{c_dim}Run 'kite contract --format pact --out tests/contract.spec.ts' for Pact tests.{c_reset}")

    return "\n".join(lines)

def cmd_contract(args: argparse.Namespace) -> None:
    ep = get_active_endpoint()
    canvas = api_get(ep, "/api/canvas")
    fmt = getattr(args, "format", "openapi")
    out_path = getattr(args, "out", None)
    json_out = getattr(args, "json", False)

    res = run_contract_synthesis(canvas, format_type=fmt)
    if json_out:
        print(json.dumps(res, indent=2, ensure_ascii=False))
        return

    if out_path:
        target_dir = os.path.dirname(os.path.abspath(out_path))
        if target_dir:
            os.makedirs(target_dir, exist_ok=True)
        if fmt == "asyncapi":
            content = generate_asyncapi_spec(res)
        elif fmt == "pact":
            content = generate_pact_contract_tests(res)
        else:
            content = generate_openapi_spec(res)
        with open(out_path, "w", encoding="utf-8") as f:
            f.write(content)
        print(format_contract_report(res, out_path=out_path, use_ansi=sys.stdout.isatty()))
    else:
        print(format_contract_report(res, out_path=None, use_ansi=sys.stdout.isatty()))

