    for mod in diff["uncharted"][:6]:
        print(f"  - [{mod['layer']}] {mod['name']}")
    if len(diff["uncharted"]) > 6:
        print(f"  ... and {len(diff['uncharted']) - 6} more uncharted modules")

    print("\n[?] Unimplemented Canvas Directives (No matching code files):")
    for node in diff["unimplemented"][:6]:
        print(f"  - [{node['type'].upper()}] \"{node['text']}\"")
    if len(diff["unimplemented"]) > 6:
        print(f"  ... and {len(diff['unimplemented']) - 6} more directives")

    if getattr(args, "apply", False) and diff["uncharted"]:
        print("\nApplying architecture sync to Canvas...")
        stickies = canvas.get("stickies", [])
        new_count = 0
        layer_colors = {"UI": "#DBEAFE", "Service": "#D1FAE5", "Data": "#EDE9FE"}
        for idx, mod in enumerate(diff["uncharted"][:6]):
            sid = f"drift-sync-{int(time.time())}-{idx}"
