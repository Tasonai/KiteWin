def analyze_architecture_drift(folder: str, canvas: Dict[str, Any]) -> Dict[str, Any]:
    arch_modules = []
    for root, dirs, files in os.walk(folder):
        if any(s in root for s in [".git", ".build", "node_modules", "dist", "tools", "Tests"]):
            continue
        for f in files:
            if f.endswith((".swift", ".cs", ".ts", ".tsx")) and not f.startswith("."):
                base = os.path.splitext(f)[0]
                if base in ("Package",):
                    continue
                low = base.lower()
                layer = "Service"
                if any(k in low for k in ["view", "page", "popover", "toolbar", "sheet", "dialog", "hud"]):
                    layer = "UI"
                elif any(k in low for k in ["store", "model", "data", "schema", "entity", "item"]):
                    layer = "Data"
                arch_modules.append({"name": base, "layer": layer})

    canvas_nodes = []
    for f in canvas.get("frames", []):
        canvas_nodes.append({"type": "frame", "id": f.get("id"), "text": f.get("title", "")})
    for s in canvas.get("stickies", []):
        canvas_nodes.append({"type": "sticky", "id": s.get("id"), "text": s.get("text", "")})

    def extract_keywords(s: str) -> set:
        words = re.findall(r"[A-Z]?[a-z]+|[A-Z]+(?=[A-Z][a-z]|\d|\W|$)|\d+", s)
        return set(w.lower() for w in words if len(w) > 2)

    charted = []
    uncharted = []

    for mod in arch_modules:
        mod_kw = extract_keywords(mod["name"])
        matched_cn = None
        for cn in canvas_nodes:
            cn_kw = extract_keywords(cn["text"])
            if mod_kw & cn_kw:
                matched_cn = cn
                break
        if matched_cn:
            charted.append({"module": mod, "canvas": matched_cn})
        else:
            uncharted.append(mod)

    unimplemented = []
    for cn in canvas_nodes:
        cn_kw = extract_keywords(cn["text"])
        matched_mod = False
        for mod in arch_modules:
            mod_kw = extract_keywords(mod["name"])
            if cn_kw & mod_kw:
                matched_mod = True
                break
        if not matched_mod:
            unimplemented.append(cn)

    total = len(arch_modules)
    health = int((len(charted) / total * 100)) if total > 0 else 100
    drift = 100 - health

    return {
        "folder": folder,
        "total_modules": total,
        "charted": charted,
        "uncharted": uncharted,
        "unimplemented": unimplemented,
        "health_score": health,
        "drift_score": drift
    }

