    p_add.add_argument("--status", choices=["backlog", "in_progress", "completed"], default="backlog", help="Status")
    p_add.add_argument("--tags", help="Comma-separated tags")
    p_add.add_argument("--starred", action="store_true", help="Mark as starred")

    # show
    p_show = subparsers.add_parser("show", help="Show details of an idea")
    p_show.add_argument("query", help="ID or title substring to find")

    # canvas
    p_canvas = subparsers.add_parser("canvas", help="Export canvas layout, diagrams, and API contracts")
    p_canvas.add_argument("--format", choices=["stitch", "json", "mermaid", "plantuml", "openapi"], default="stitch", help="Output format (stitch, json, mermaid, plantuml, openapi)")

    # scaffold
    p_scaffold = subparsers.add_parser("scaffold", help="Scaffold project constitution and planning directory")
    p_scaffold.add_argument("title", help="Project title")
    p_scaffold.add_argument("--folder", default=".", help="Target parent directory")
    p_scaffold.add_argument("--concept", help="Project concept / JTBD")
    p_scaffold.add_argument("--platform", choices=["web", "mobile", "desktop"], default="web", help="Platform")
    p_scaffold.add_argument("--style", default="Editorial & Swiss Modern", help="Design system preset")
    p_scaffold.add_argument("--no-git", action="store_true", help="Do not initialize git feature branch")

    # sync
    p_sync = subparsers.add_parser("sync", help="Trigger bidirectional P2P sync with remote station")
    p_sync.add_argument("--peer", help="Remote station endpoint (e.g. http://127.0.0.1:24243)")
    p_sync.add_argument("--watch", action="store_true", help="Keep connection open and watch for incoming real-time events")

    # watch
    p_watch = subparsers.add_parser("watch", help="Listen to real-time P2P SSE event stream")
    p_watch.add_argument("--auto-sync", action="store_true", help="Automatically trigger sync on incoming change events")
    p_watch.add_argument("--peer", help="Peer endpoint to sync with when events arrive")

    # spec
    p_spec = subparsers.add_parser("spec", help="Read generated specification or plan for an idea")
    p_spec.add_argument("title", help="Idea title or ID")

    # import-repo
    p_import_repo = subparsers.add_parser("import-repo", help="Scan repository structure and place 3-layer architecture on canvas")
    p_import_repo.add_argument("path", nargs="?", default=".", help="Directory to analyze")

    # co-architect
    subparsers.add_parser("co-architect", help="AI Co-Architect gap analysis (Security, Cache, Observability)")

    # roadmap
    p_roadmap = subparsers.add_parser("roadmap", help="Generate or display execution waves HUD on canvas")
    p_roadmap.add_argument("--path", help="Optional path to ROADMAP.md")

    # import-figma
    p_figma = subparsers.add_parser("import-figma", help="Import Figma / Stitch tokens and components onto canvas")
    p_figma.add_argument("spec", nargs="?", default="", help="Design file or specification name")

    # voice-session
    p_voice = subparsers.add_parser("voice-session", help="Process natural language voice transcript into idea and architecture")
    p_voice.add_argument("transcript", help="Transcript or user voice directive")

    # synthesize
    p_syn = subparsers.add_parser("synthesize", help="Synthesize 4-wave production engineering artifacts for an idea")
    p_syn.add_argument("query", nargs="?", default="", help="Idea title or substring to synthesize")
    p_syn.add_argument("--wave", choices=["1", "2", "3", "4", "all"], default="all", help="Engineering wave (1: Data, 2: Services, 3: UI, 4: QA, all)")
    p_syn.add_argument("--out", default="artifacts", help="Destination directory (default: ./artifacts)")
    p_syn.add_argument("--dry-run", action="store_true", help="Preview generated files without writing to disk")

    # diff-canvas
    p_diff = subparsers.add_parser("diff-canvas", help="Detect architecture drift between codebase and live canvas")
    p_diff.add_argument("path", nargs="?", default=".", help="Repository path to analyze (default: .)")
    p_diff.add_argument("--apply", action="store_true", help="Sync uncharted modules directly to Canvas")

    # skill-gen
    p_skill = subparsers.add_parser("skill-gen", help="Synthesize Antigravity SKILL.md from architecture directives")
    p_skill.add_argument("query", nargs="?", default="", help="Idea title or substring to base skill on")
    p_skill.add_argument("--install", action="store_true", help="Install directly to ~/.gemini/config/skills/")
    p_skill.add_argument("--out", help="Custom output path for SKILL.md")
    p_skill.add_argument("--dry-run", action="store_true", help="Preview skill without writing file")

    # cockpit
    p_cockpit = subparsers.add_parser("cockpit", help="Launch live station telemetry cockpit and SSE monitor")
    p_cockpit.add_argument("--once", action="store_true", help="Render single dashboard snapshot and exit")
    p_cockpit.add_argument("--rate", type=float, default=2.0, help="Refresh interval in seconds (default: 2.0)")

    # mcp
    p_mcp = subparsers.add_parser("mcp", help="Run MCP server over stdio or manage AI client integrations")
    p_mcp.add_argument("action", nargs="?", choices=["run", "setup", "install", "status", "uninstall"], default="run", help="Action: run (default), setup/install, status, or uninstall")
    p_mcp.add_argument("--dry-run", action="store_true", help="Preview configuration changes without writing files")

    # mcp-setup alias
    p_setup = subparsers.add_parser("mcp-setup", help="Configure Claude Desktop, Cursor, and VS Code for Kite MCP")
    p_setup.add_argument("action", nargs="?", choices=["install", "setup", "status", "uninstall"], default="install", help="Action: install (default), status, or uninstall")
    p_setup.add_argument("--status", action="store_true", help="Show status of MCP client configurations")
    p_setup.add_argument("--uninstall", action="store_true", help="Remove Kite from MCP client configurations")
    p_setup.add_argument("--dry-run", action="store_true", help="Preview configuration changes without writing files")

    args = parser.parse_args()

    if args.subcommand == "status":
        cmd_status(args)
    elif args.subcommand == "list":
        cmd_list(args)
    elif args.subcommand == "add":
        cmd_add(args)
    elif args.subcommand == "show":
        cmd_show(args)
    elif args.subcommand == "canvas":
        cmd_canvas_export(args)
    elif args.subcommand == "scaffold":
        cmd_scaffold(args)
    elif args.subcommand == "sync":
        cmd_sync(args)
    elif args.subcommand == "watch":
        cmd_watch(args)
    elif args.subcommand == "spec":
        cmd_spec(args)
    elif args.subcommand == "import-repo":
        cmd_import_repo(args)
    elif args.subcommand == "co-architect":
        cmd_co_architect(args)
    elif args.subcommand == "roadmap":
        cmd_roadmap(args)
    elif args.subcommand == "import-figma":
        cmd_import_figma(args)
    elif args.subcommand == "voice-session":
        cmd_voice_session(args)
    elif args.subcommand == "synthesize":
        cmd_synthesize(args)
    elif args.subcommand == "diff-canvas":
        cmd_diff_canvas(args)
    elif args.subcommand == "skill-gen":
        cmd_skill_gen(args)
    elif args.subcommand == "cockpit":
        cmd_cockpit(args)
    elif args.subcommand == "mcp":
        action = getattr(args, "action", "run")
        if action == "run":
            run_mcp_server()
        elif action in ("setup", "install"):
            cmd_mcp_setup(action="install", dry_run=getattr(args, "dry_run", False))
        elif action == "uninstall":
            cmd_mcp_setup(action="uninstall", dry_run=getattr(args, "dry_run", False))
        elif action == "status":
            cmd_mcp_setup(action="status", dry_run=False)
    elif args.subcommand == "mcp-setup":
        action = "install"
        if getattr(args, "status", False) or getattr(args, "action", None) == "status":
            action = "status"
        elif getattr(args, "uninstall", False) or getattr(args, "action", None) == "uninstall":
            action = "uninstall"
        cmd_mcp_setup(action=action, dry_run=getattr(args, "dry_run", False))
    else:
        parser.print_help()

if __name__ == "__main__":
    main()
