    lines.append(f"{C_DIM}{ctrl_line}{C_RESET}")
    return "\n".join(lines)

def check_stdin_key(timeout: float) -> Optional[str]:
    if not sys.stdin.isatty():
        time.sleep(timeout)
        return None
    try:
        if os.name == "nt":
            import msvcrt
            t_end = time.time() + timeout
            while time.time() < t_end:
                if msvcrt.kbhit():
                    return msvcrt.getch().decode("utf-8", errors="ignore")
                time.sleep(0.05)
            return None
        else:
            import select, termios, tty
            fd = sys.stdin.fileno()
            old_settings = termios.tcgetattr(fd)
            try:
                tty.setcbreak(fd)
                rlist, _, _ = select.select([sys.stdin], [], [], timeout)
                if rlist:
                    return sys.stdin.read(1)
                return None
            finally:
                termios.tcsetattr(fd, termios.TCSADRAIN, old_settings)
    except Exception:
        time.sleep(timeout)
        return None

def cmd_cockpit(args: argparse.Namespace) -> None:
    ep = get_active_endpoint()
    once = getattr(args, "once", False)
    rate = getattr(args, "rate", 2.0)

    monitor = CockpitMonitor(ep)
    time.sleep(0.3)

    if once or not sys.stdout.isatty():
        snap = monitor.snapshot()
        monitor.stop()
        print(render_cockpit(snap, use_ansi=sys.stdout.isatty()))
        return

    try:
        # Hide cursor
        sys.stdout.write("\033[?25l")
        sys.stdout.flush()

        while True:
            snap = monitor.snapshot()
            rendered = render_cockpit(snap, use_ansi=True)
            # Clear screen and redraw
            sys.stdout.write("\033[2J\033[H")
            sys.stdout.write(rendered + "\n")
            sys.stdout.flush()

            key = check_stdin_key(rate)
            if key in ["q", "Q"]:
                break
            elif key in ["r", "R"]:
                continue
            elif key in ["s", "S"]:
                try:
                    _ = api_get(ep, "/api/status")
                except Exception:
                    pass
    except KeyboardInterrupt:
        pass
    finally:
        monitor.stop()
        # Restore cursor
        sys.stdout.write("\033[?25h\n")
        sys.stdout.flush()

