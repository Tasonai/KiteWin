  title: string;
  retries: number;
  lastError: string | null;
}}

export function transition(state: MachineState, event: MachineEvent, ctx: MachineContext): [MachineState, MachineContext] {{
  switch (state) {{
    case "idle":
      if (event.type === "INIT") return ["loading", {{ ...ctx, retries: 0, lastError: null }}];
      break;

    case "loading":
      if (event.type === "FETCH_SUCCESS") return ["ready", ctx];
      if (event.type === "FETCH_ERROR") return ["error", {{ ...ctx, lastError: event.error }}];
      break;

    case "ready":
      if (event.type === "START_MUTATION") return ["mutating", ctx];
      break;

    case "mutating":
      if (event.type === "MUTATION_COMPLETE") return ["ready", ctx];
      if (event.type === "FETCH_ERROR") return ["error", {{ ...ctx, lastError: event.error }}];
      break;

    case "error":
      if (event.type === "RETRY") return ["loading", {{ ...ctx, retries: ctx.retries + 1 }}];
      break;
  }}
  return [state, ctx];
}}
