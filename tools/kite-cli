# ==================== LAN PEER-TO-PEER MESH TOPOLOGY VISUALIZER ====================

def run_mesh_topology(
    nodes: Optional[List[str]] = None,
    ping_samples: int = 4
) -> Dict[str, Any]:
    default_endpoints = [
        "http://127.0.0.1:24242",
        "http://127.0.0.1:24243"
    ]
    candidate_endpoints = nodes if nodes else default_endpoints

    scanned_nodes = []
    online_nodes = []

    for ep in candidate_endpoints:
        status_url = f"{ep}/api/status"
        lats = []
        app_info = {}
        is_online = False

        for _ in range(max(1, ping_samples)):
            t0 = time.perf_counter()
            try:
                with urllib.request.urlopen(status_url, timeout=0.6) as r:
                    data = json.loads(r.read())
                    lats.append((time.perf_counter() - t0) * 1000.0)
                    app_info = data
                    is_online = True
            except Exception:
                pass

        if not is_online:
            scanned_nodes.append({
                "endpoint": ep,
                "online": False,
                "app": "Kite Station (Offline)",
                "version": "N/A",
                "ping_avg_ms": None,
                "ideas_count": 0,
                "canvas_hash": "N/A",
                "components_count": 0
            })
            continue

        ping_avg = round(sum(lats) / len(lats), 2) if lats else 0.0
        ping_min = round(min(lats), 2) if lats else 0.0
        ping_max = round(max(lats), 2) if lats else 0.0

        ideas_cnt = 0
        try:
            with urllib.request.urlopen(f"{ep}/api/ideas", timeout=0.8) as r:
                ideas_cnt = len(json.loads(r.read()).get("ideas", []))
        except Exception:
            pass

        c_hash = "N/A"
        comps_cnt = 0
        try:
            with urllib.request.urlopen(f"{ep}/api/canvas", timeout=0.8) as r:
                c_data = json.loads(r.read())
                c_hash = compute_canvas_hash(c_data)
                comps_cnt = len(c_data.get("frames", [])) + len(c_data.get("stickies", [])) + len(c_data.get("connections", []))
        except Exception:
            pass

        node_data = {
            "endpoint": ep,
            "online": True,
            "app": app_info.get("app", "Kite Station"),
            "version": app_info.get("version", "1.0.0"),
            "ping_avg_ms": ping_avg,
            "ping_min_ms": ping_min,
            "ping_max_ms": ping_max,
            "ideas_count": ideas_cnt,
            "canvas_hash": c_hash,
            "components_count": comps_cnt
        }
        scanned_nodes.append(node_data)
        online_nodes.append(node_data)

    if len(online_nodes) > 1:
        hashes = {n["canvas_hash"] for n in online_nodes if n["canvas_hash"] != "N/A"}
        if len(hashes) == 1:
            state_drift = "IN_SYNC"
            drift_message = "All online stations maintain identical architecture state."
            health_score = 100
        else:
            state_drift = "DIVERGENT"
            drift_message = "Detected state drift across stations. Run 'kite sync' to reconcile."
            health_score = 65
    elif len(online_nodes) == 1:
        state_drift = "STANDALONE_QUORUM"
        drift_message = "Single active station running healthy local quorum."
        health_score = 90
    else:
        state_drift = "CLUSTER_OFFLINE"
        drift_message = "No active stations reachable on the local mesh."
        health_score = 0

    return {
        "status": "success",
        "total_nodes": len(scanned_nodes),
        "online_nodes_count": len(online_nodes),
        "mesh_health_score": health_score,
        "state_drift": state_drift,
        "drift_message": drift_message,
        "nodes": scanned_nodes
    }

