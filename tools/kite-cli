def format_e2e_gen_report(res: Dict[str, Any], out_path: str = None, use_ansi: bool = True) -> str:
    c_bold = "\033[1m" if use_ansi else ""
    c_green = "\033[32m" if use_ansi else ""
    c_blue = "\033[34m" if use_ansi else ""
    c_cyan = "\033[36m" if use_ansi else ""
    c_dim = "\033[2m" if use_ansi else ""
    c_reset = "\033[0m" if use_ansi else ""

    lines = []
    lines.append(f"{c_bold}=== KITE AUTOMATED E2E SCENARIO GENERATOR ==={c_reset}")
    lines.append("-" * 72)
    runner_upper = res.get('runner', 'playwright').upper()
    total_j = res.get('total_journeys', 0)
    total_s = res.get('total_steps', 0)
    total_a = res.get('total_a11y_scans', 0)
    total_v = res.get('total_visual_checks', 0)
    lines.append(f"Runner: {c_cyan}{runner_upper}{c_reset} | Journeys: {c_green}{total_j}{c_reset} | Test Steps: {c_green}{total_s}{c_reset} | A11y Audits: {c_green}{total_a}{c_reset} | Visual Snapshots: {c_green}{total_v}{c_reset}")
    lines.append("-" * 72)
    lines.append("")
    lines.append(f"{c_bold}SYNTHESIZED USER JOURNEYS:{c_reset}")

    for idx, j in enumerate(res.get("journeys", []), 1):
        step_cnt = len(j.get("steps", []))
        a11y_cnt = sum(1 for s in j.get("steps", []) if s.get("check_a11y"))
        vis_cnt = sum(1 for s in j.get("steps", []) if s.get("visual_check"))
        j_title = j.get('title', 'Journey')
        j_route = j.get('route', '/')
        lines.append(f"  {c_blue}[{idx}]{c_reset} {c_bold}{j_title}{c_reset}")
        lines.append(f"      Initial Route: {c_cyan}{j_route}{c_reset}")
        lines.append(f"      Coverage: {step_cnt} sequential steps, {a11y_cnt} WCAG 2.2 checks, {vis_cnt} visual regressions")
        for s_idx, s in enumerate(j.get("steps", []), 1):
            check_flag = f"{c_green}[A11Y]{c_reset}" if s.get("check_a11y") else ""
            vis_flag = f"{c_cyan}[VISUAL]{c_reset}" if s.get("visual_check") else ""
            s_name = s.get('name', 'Step')
            lines.append(f"        {c_dim}{s_idx}.{c_reset} {s_name} {check_flag} {vis_flag}")

    lines.append("")
    if out_path:
        lines.append(f"{c_green}Test suite exported to:{c_reset} {out_path}")
    elif res.get("dry_run"):
        lines.append(f"{c_dim}Dry run complete. Use --out <file.spec.ts> to write executable test suite.{c_reset}")
    else:
        lines.append(f"{c_dim}Run 'kite e2e-gen --out e2e/user-journey.spec.ts' to export runnable test suite.{c_reset}")

    return "\n".join(lines)

def cmd_e2e_gen(args: argparse.Namespace) -> None:
    ep = get_active_endpoint()
    canvas = api_get(ep, "/api/canvas")
    runner = getattr(args, "runner", "playwright")
    dry_run = getattr(args, "dry_run", False)
    out_path = getattr(args, "out", None)
    json_out = getattr(args, "json", False)

    res = run_e2e_gen_synthesis(canvas, runner=runner, dry_run=dry_run)
    if json_out:
        print(json.dumps(res, indent=2, ensure_ascii=False))
        return

    if out_path and not dry_run:
        suite = generate_playwright_e2e_suite(res) if runner == "playwright" else generate_cypress_e2e_suite(res)
        target_dir = os.path.dirname(os.path.abspath(out_path))
        if target_dir:
            os.makedirs(target_dir, exist_ok=True)
        with open(out_path, "w", encoding="utf-8") as f:
            f.write(suite)
        print(format_e2e_gen_report(res, out_path=out_path, use_ansi=sys.stdout.isatty()))
    else:
        print(format_e2e_gen_report(res, out_path=None, use_ansi=sys.stdout.isatty()))

