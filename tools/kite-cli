    if answers:
        lines.append("### 1.3 Interview Decisions & Architectural Trade-offs")
        for idx, a in enumerate(answers):
            q_text = a.get("question", f"Decision {idx+1}")
            choice = a.get("answer") or a.get("selectedOption", "Standard")
            lines.append(f"- **{q_text}:** `{choice}`")
