# ==================== MCP SETUP & CLIENT INTEGRATIONS ====================

def get_mcp_client_targets() -> List[Dict[str, Any]]:
    home = os.path.expanduser("~")
    is_win = sys.platform == "win32"
    appdata = os.environ.get("APPDATA", os.path.join(home, "AppData", "Roaming"))
    return [
        {
            "id": "claude",
            "name": "Claude Desktop",
            "path": os.path.join(appdata, "Claude", "claude_desktop_config.json") if is_win else os.path.join(home, "Library", "Application Support", "Claude", "claude_desktop_config.json"),
            "app_dir": os.path.join(appdata, "Claude") if is_win else os.path.join(home, "Library", "Application Support", "Claude"),
            "key": "mcpServers"
        },
        {
            "id": "cursor",
            "name": "Cursor IDE",
            "path": os.path.join(home, ".cursor", "mcp.json"),
            "app_dir": os.path.join(home, ".cursor"),
            "key": "mcpServers"
        },
        {
            "id": "windsurf",
            "name": "Windsurf (Codeium)",
            "path": os.path.join(home, ".codeium", "windsurf", "mcp_config.json"),
            "app_dir": os.path.join(home, ".codeium", "windsurf"),
            "key": "mcpServers"
        },
        {
            "id": "cline",
            "name": "Cline / Roo Code",
            "path": os.path.join(appdata, "Code", "User", "globalStorage", "saoudrizwan.claude-dev", "settings", "cline_mcp_settings.json") if is_win else os.path.join(home, "Library", "Application Support", "Code", "User", "globalStorage", "saoudrizwan.claude-dev", "settings", "cline_mcp_settings.json"),
            "app_dir": os.path.join(appdata, "Code") if is_win else os.path.join(home, "Library", "Application Support", "Code"),
            "key": "mcpServers"
        }
    ]

def resolve_kite_command() -> str:
    which_kite = shutil.which("kite")
    if which_kite:
        return which_kite
    if sys.platform != "win32" and os.path.exists("/usr/local/bin/kite"):
        return "/usr/local/bin/kite"
    return os.path.abspath(sys.argv[0])

def cmd_mcp_setup(action: str = "install", dry_run: bool = False) -> None:
    targets = get_mcp_client_targets()
    kite_cmd = resolve_kite_command()
    mcp_entry = {
        "command": kite_cmd,
        "args": ["mcp"]
    }

    print("=== Kite MCP Integration Manager ===")
    print(f"Action:     {action.upper()}")
    print(f"Kite CLI:   {kite_cmd}")
    if dry_run:
        print("Mode:       DRY RUN (preview only, no files modified)\n")
    else:
        print()

    if action == "status":
        for t in targets:
            name = t["name"]
            path = t["path"]
            app_dir = t["app_dir"]
            if not os.path.exists(path):
                if os.path.exists(app_dir):
                    status_str = "NOT CONFIGURED (App directory detected)"
                else:
                    status_str = "NOT INSTALLED (Client not detected)"
                print(f"  [-] {name:<18} : {status_str}")
                print(f"      Path: {path}")
            else:
                try:
                    with open(path, "r", encoding="utf-8") as f:
                        cfg = json.load(f)
                    servers = cfg.get(t["key"], {})
                    if "kite" in servers:
                        kcfg = servers["kite"]
                        cmd = kcfg.get("command", "")
                        args = " ".join(kcfg.get("args", []))
                        print(f"  [+] {name:<18} : CONFIGURED ({cmd} {args})")
                        print(f"      Path: {path}")
                    else:
                        print(f"  [~] {name:<18} : OTHER MCP SERVERS PRESENT (Kite not added)")
                        print(f"      Path: {path}")
                except Exception as ex:
                    print(f"  [!] {name:<18} : ERROR READING CONFIG ({ex})")
        return

    if action == "install":
        installed_count = 0
        for t in targets:
            name = t["name"]
            path = t["path"]
            app_dir = t["app_dir"]

            if not os.path.exists(path) and not os.path.exists(app_dir):
                if t["id"] != "cursor":
                    continue

            print(f"Configuring {name}...")
            print(f"  Target: {path}")

            cfg: Dict[str, Any] = {}
            if os.path.exists(path):
                try:
                    with open(path, "r", encoding="utf-8") as f:
                        cfg = json.load(f)
                except Exception as ex:
                    print(f"  [!] Warning: could not parse existing JSON ({ex}). Creating backup.")
                    if not dry_run:
                        shutil.copy2(path, path + ".broken.bak")
                    cfg = {}

            if t["key"] not in cfg or not isinstance(cfg[t["key"]], dict):
                cfg[t["key"]] = {}

            existing = cfg[t["key"]].get("kite")
            if existing == mcp_entry:
                print(f"  [=] Kite MCP is already configured with identical parameters.")
                installed_count += 1
                continue

            cfg[t["key"]]["kite"] = mcp_entry

            if dry_run:
                print(f"  [DRY-RUN] Target JSON preview:")
                print("  " + json.dumps({t["key"]: {"kite": mcp_entry}}, indent=2).replace("\n", "\n  "))
            else:
                if os.path.exists(path):
                    shutil.copy2(path, path + ".bak")
                else:
                    os.makedirs(os.path.dirname(path), exist_ok=True)
                with open(path, "w", encoding="utf-8") as f:
                    json.dump(cfg, f, indent=2, ensure_ascii=False)
                    f.write("\n")
                print(f"  [+] Successfully registered Kite MCP server in {name}.")
            installed_count += 1

        print(f"\nSummary: {installed_count} client target(s) processed.")
        return

    if action == "uninstall":
        removed_count = 0
        for t in targets:
            name = t["name"]
            path = t["path"]
            if not os.path.exists(path):
                continue

            try:
                with open(path, "r", encoding="utf-8") as f:
                    cfg = json.load(f)
            except Exception:
                continue

            servers = cfg.get(t["key"], {})
            if "kite" in servers:
                print(f"Removing Kite MCP from {name} ({path})...")
                del cfg[t["key"]]["kite"]
                if dry_run:
                    print("  [DRY-RUN] Key 'kite' would be removed.")
                else:
                    shutil.copy2(path, path + ".bak")
                    with open(path, "w", encoding="utf-8") as f:
                        json.dump(cfg, f, indent=2, ensure_ascii=False)
                        f.write("\n")
                    print(f"  [-] Successfully uninstalled Kite MCP from {name}.")
                removed_count += 1

        print(f"\nSummary: {removed_count} client target(s) updated.")
        return

# ==================== MAIN DISPATCHER ====================

def main() -> None:
    parser = argparse.ArgumentParser(
        prog="kite",
        description="Kite Agent CLI & MCP Server — drives the running Kite macOS / Windows app live."
    )
    subparsers = parser.add_subparsers(dest="subcommand", help="Subcommand to execute")

    # status
    subparsers.add_parser("status", help="Show connection status and statistics")

    # list
    p_list = subparsers.add_parser("list", help="List project ideas")
    p_list.add_argument("--status", choices=["backlog", "in_progress", "completed"], help="Filter by status")
    p_list.add_argument("--platform", choices=["web", "mobile", "desktop"], help="Filter by platform")
    p_list.add_argument("--starred", action="store_true", help="Only starred items")
    p_list.add_argument("--json", action="store_true", help="Output raw JSON")

    # add
    p_add = subparsers.add_parser("add", help="Add a new project idea")
    p_add.add_argument("title", help="Title of the project")
    p_add.add_argument("--concept", help="JTBD concept and user scenario")
    p_add.add_argument("--platform", choices=["web", "mobile", "desktop"], default="web", help="Platform")
    p_add.add_argument("--style", default="Editorial & Swiss Modern", help="Design system preset")
    p_add.add_argument("--status", choices=["backlog", "in_progress", "completed"], default="backlog", help="Status")
    p_add.add_argument("--tags", help="Comma-separated tags")
    p_add.add_argument("--starred", action="store_true", help="Mark as starred")

    # show
    p_show = subparsers.add_parser("show", help="Show details of an idea")
    p_show.add_argument("query", help="ID or title substring to find")

    # canvas
    p_canvas = subparsers.add_parser("canvas", help="Export canvas layout and tokens")
    p_canvas.add_argument("--format", choices=["stitch", "json"], default="stitch", help="Output format")

    # scaffold
    p_scaffold = subparsers.add_parser("scaffold", help="Scaffold project constitution and planning directory")
    p_scaffold.add_argument("title", help="Project title")
    p_scaffold.add_argument("--folder", default=".", help="Target parent directory")
    p_scaffold.add_argument("--concept", help="Project concept / JTBD")
    p_scaffold.add_argument("--platform", choices=["web", "mobile", "desktop"], default="web", help="Platform")
    p_scaffold.add_argument("--style", default="Editorial & Swiss Modern", help="Design system preset")
    p_scaffold.add_argument("--no-git", action="store_true", help="Do not initialize git feature branch")

    # sync
    p_sync = subparsers.add_parser("sync", help="Trigger bidirectional P2P sync with remote station")
    p_sync.add_argument("--peer", help="Remote station endpoint (e.g. http://127.0.0.1:24243)")

    # spec
    p_spec = subparsers.add_parser("spec", help="Read generated specification or plan for an idea")
    p_spec.add_argument("title", help="Idea title or ID")

    # import-repo
    p_import_repo = subparsers.add_parser("import-repo", help="Scan repository structure and place 3-layer architecture on canvas")
    p_import_repo.add_argument("path", nargs="?", default=".", help="Directory to analyze")

    # co-architect
    subparsers.add_parser("co-architect", help="AI Co-Architect gap analysis (Security, Cache, Observability)")

    # roadmap
    p_roadmap = subparsers.add_parser("roadmap", help="Generate or display execution waves HUD on canvas")
    p_roadmap.add_argument("--path", help="Optional path to ROADMAP.md")

    # import-figma
    p_figma = subparsers.add_parser("import-figma", help="Import Figma / Stitch tokens and components onto canvas")
    p_figma.add_argument("spec", nargs="?", default="", help="Design file or specification name")

    # voice-session
    p_voice = subparsers.add_parser("voice-session", help="Process natural language voice transcript into idea and architecture")
    p_voice.add_argument("transcript", help="Transcript or user voice directive")

    # mcp
    p_mcp = subparsers.add_parser("mcp", help="Run MCP server over stdio or manage AI client integrations")
    p_mcp.add_argument("action", nargs="?", choices=["run", "setup", "install", "status", "uninstall"], default="run", help="Action: run (default), setup/install, status, or uninstall")
    p_mcp.add_argument("--dry-run", action="store_true", help="Preview configuration changes without writing files")

    # mcp-setup alias
    p_setup = subparsers.add_parser("mcp-setup", help="Configure Claude Desktop, Cursor, and VS Code for Kite MCP")
    p_setup.add_argument("action", nargs="?", choices=["install", "setup", "status", "uninstall"], default="install", help="Action: install (default), status, or uninstall")
    p_setup.add_argument("--status", action="store_true", help="Show status of MCP client configurations")
    p_setup.add_argument("--uninstall", action="store_true", help="Remove Kite from MCP client configurations")
    p_setup.add_argument("--dry-run", action="store_true", help="Preview configuration changes without writing files")

    args = parser.parse_args()

    if args.subcommand == "status":
        cmd_status(args)
    elif args.subcommand == "list":
        cmd_list(args)
    elif args.subcommand == "add":
        cmd_add(args)
    elif args.subcommand == "show":
        cmd_show(args)
    elif args.subcommand == "canvas":
        cmd_canvas_export(args)
    elif args.subcommand == "scaffold":
        cmd_scaffold(args)
    elif args.subcommand == "sync":
        cmd_sync(args)
    elif args.subcommand == "spec":
        cmd_spec(args)
    elif args.subcommand == "import-repo":
        cmd_import_repo(args)
    elif args.subcommand == "co-architect":
        cmd_co_architect(args)
    elif args.subcommand == "roadmap":
        cmd_roadmap(args)
    elif args.subcommand == "import-figma":
        cmd_import_figma(args)
    elif args.subcommand == "voice-session":
        cmd_voice_session(args)
    elif args.subcommand == "mcp":
        action = getattr(args, "action", "run")
        if action == "run":
            run_mcp_server()
        elif action in ("setup", "install"):
            cmd_mcp_setup(action="install", dry_run=getattr(args, "dry_run", False))
        elif action == "uninstall":
            cmd_mcp_setup(action="uninstall", dry_run=getattr(args, "dry_run", False))
        elif action == "status":
            cmd_mcp_setup(action="status", dry_run=False)
    elif args.subcommand == "mcp-setup":
        action = "install"
        if getattr(args, "status", False) or getattr(args, "action", None) == "status":
            action = "status"
        elif getattr(args, "uninstall", False) or getattr(args, "action", None) == "uninstall":
            action = "uninstall"
        cmd_mcp_setup(action=action, dry_run=getattr(args, "dry_run", False))
    else:
        parser.print_help()

if __name__ == "__main__":
    main()
