            "zod": "^3.23.8"
        },
        "devDependencies": {
            "@types/node": "^22.0.0",
            "typescript": "^5.6.0",
            "tsx": "^4.19.0",
            "vitest": "^2.1.0"
        }
    }, indent=2) + "\n"

    files["tsconfig.json"] = json.dumps({
        "compilerOptions": {
            "target": "ES2022",
            "module": "NodeNext",
            "moduleResolution": "NodeNext",
            "strict": True,
            "esModuleInterop": True,
            "skipLibCheck": True,
            "forceConsistentCasingInFileNames": True,
            "outDir": "./dist",
            "rootDir": "./src"
        },
        "include": ["src/**/*", "tests/**/*"]
    }, indent=2) + "\n"

    files["README.md"] = f"""# {title}

