def format_chaos_report(res: Dict[str, Any], out_path: str = None, use_ansi: bool = True) -> str:
    c_bold = "\033[1m" if use_ansi else ""
    c_green = "\033[32m" if use_ansi else ""
    c_red = "\033[31m" if use_ansi else ""
    c_yellow = "\033[33m" if use_ansi else ""
    c_cyan = "\033[36m" if use_ansi else ""
    c_dim = "\033[2m" if use_ansi else ""
    c_reset = "\033[0m" if use_ansi else ""

    lines = []
    lines.append(f"{c_bold}=== KITE CHAOS ENGINEERING & RESILIENCE SIMULATOR ==={c_reset}")
    lines.append("-" * 76)
    r_score = res.get("resilience_score", 0)
    score_color = c_green if r_score >= 80 else (c_yellow if r_score >= 50 else c_red)
    passed_s = res.get("passed_scenarios", 0)
    total_s = res.get("total_scenarios", 0)
    status_text = "RESILIENT" if r_score >= 80 else "DEGRADED"
    lines.append(f"Resilience Score: {score_color}{r_score}%{c_reset} | Passed Modes: {c_green}{passed_s}/{total_s}{c_reset} | Status: {score_color}{status_text}{c_reset}")
    lines.append("-" * 76)
    lines.append("")
    lines.append(f"{c_bold}FAULT INJECTION SCENARIOS:{c_reset}")

    for idx, s in enumerate(res.get("scenarios", []), 1):
        s_name = s.get("name", "Scenario")
        s_target = s.get("target", "Target")
        s_status = s.get("status", "FAIL")
        st_color = c_green if s_status == "PASS" else c_red
        cb_state = s.get("circuit_breaker", "CB")
        lines.append(f"  {c_cyan}[{idx}]{c_reset} {c_bold}{s_name}{c_reset} -> {st_color}[{s_status}]{c_reset}")
        lines.append(f"      Target: {c_dim}{s_target}{c_reset}")
        s_resp = s.get("system_response", "")
        lines.append(f"      Reaction: {s_resp}")
        lines.append(f"      Circuit Breaker: {c_yellow}{cb_state}{c_reset}")
        if s_status == "FAIL":
            s_rem = s.get("remediation", "")
            lines.append(f"      Remediation: {c_red}{s_rem}{c_reset}")

    lines.append("")
    if out_path:
        lines.append(f"{c_green}Chaos resilience report exported to:{c_reset} {out_path}")
    else:
        lines.append(f"{c_dim}Run 'kite chaos --out CHAOS_REPORT.md' to export full drill specification.{c_reset}")

    return "\n".join(lines)

def cmd_chaos(args: argparse.Namespace) -> None:
    ep = get_active_endpoint()
    canvas = api_get(ep, "/api/canvas")
    scenario = getattr(args, "scenario", "all")
    heal = getattr(args, "heal", False)
    out_path = getattr(args, "out", None)
    json_out = getattr(args, "json", False)

    res = run_chaos_simulation(canvas, scenario_filter=scenario)

    if heal and res.get("failed_scenarios", 0) > 0:
        injected = heal_chaos_deficiencies(ep, canvas, res)
        if injected > 0:
            updated_canvas = api_get(ep, "/api/canvas")
            res = run_chaos_simulation(updated_canvas, scenario_filter=scenario)

    if json_out:
        print(json.dumps(res, indent=2, ensure_ascii=False))
        return

    if out_path:
        md = generate_chaos_report_markdown(res)
        target_dir = os.path.dirname(os.path.abspath(out_path))
        if target_dir:
            os.makedirs(target_dir, exist_ok=True)
        with open(out_path, "w", encoding="utf-8") as f:
            f.write(md)
        print(format_chaos_report(res, out_path=out_path, use_ansi=sys.stdout.isatty()))
    else:
        print(format_chaos_report(res, out_path=None, use_ansi=sys.stdout.isatty()))

