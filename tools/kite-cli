def generate_playwright_e2e_suite(res: Dict[str, Any], title: str = "Kite Architecture") -> str:
    lines = []
    lines.append("/**")
    lines.append(" * AUTO-GENERATED BY KITE E2E SCENARIO GENERATOR (kite e2e-gen)")
    lines.append(" * Google DeepMind Antigravity Craftsmanship Standard")
    lines.append(f" * Target: {title}")
    lines.append(" * Zero Emojis Compliance: 100% Strict")
    lines.append(" */")
    lines.append("")
    lines.append("import { test, expect } from '@playwright/test';")
    lines.append("import AxeBuilder from '@axe-core/playwright';")
    lines.append("")
    lines.append("test.describe.configure({ mode: 'serial' });")
    lines.append("")
    lines.append(f"test.describe('E2E Enterprise User Journeys: {title}', () => {{")
    lines.append("  test.beforeEach(async ({ page }) => {")
    lines.append("    // Enforce standardized desktop viewport adhering to Apple HIG and Windows 11 grids")
    lines.append("    await page.setViewportSize({ width: 1440, height: 900 });")
    lines.append("  });")
    lines.append("")

    for j_idx, j in enumerate(res.get("journeys", []), 1):
        j_id = j.get("id", f"journey_{j_idx}")
        j_title = j.get("title", f"Journey {j_idx}")
        j_route = j.get("route", "/")
        lines.append(f"  test('Journey {j_idx}: {j_title}', async ({{ page }}) => {{")
        lines.append("    // Base navigation to initial route")
        lines.append(f"    await page.goto('{j_route}', {{ waitUntil: 'networkidle' }});")
        lines.append("")

        for s_idx, s in enumerate(j.get("steps", []), 1):
            s_name = s.get("name", f"Step {s_idx}")
            s_action = s.get("action", "click")
            s_selector = s.get("selector", "body")
            safe_sel = s_selector.replace('"', '\\"')
            s_assertion = s.get("assertion", "is visible")
            check_a11y = s.get("check_a11y", False)
            visual_check = s.get("visual_check", False)

            lines.append(f"    // Step {s_idx}: {s_name}")
            if s_action == "navigate":
                target_route = s.get("route", "/")
                lines.append(f"    await page.goto('{target_route}', {{ waitUntil: 'domcontentloaded' }});")
            elif s_action == "click":
                lines.append(f'    await page.locator("{safe_sel}").first().click();')
            elif s_action == "fill_and_submit":
                lines.append(f'    await page.locator("{safe_sel}").first().fill("tenant-enterprise-preview");')
                lines.append('    await page.locator(\'button[type="submit"]\').click();')
            elif s_action == "wait_for_url":
                target_route = s.get("route", "/dashboard")
                lines.append(f"    await page.waitForURL('**{target_route}');")
            elif s_action == "assert_response":
                lines.append(f'    const response_{s_idx} = await page.request.get("{safe_sel}");')
                lines.append(f"    expect(response_{s_idx}.ok()).toBeTruthy();")

            lines.append(f"    // Assertion: {s_assertion}")
            lines.append(f'    await expect(page.locator("{safe_sel}").first()).toBeVisible();')

            if check_a11y:
                lines.append("    // WCAG 2.2 AA Automated Accessibility Audit")
                lines.append(f"    const a11y_{s_idx} = await new AxeBuilder({{ page }})")
                lines.append("      .withTags(['wcag2a', 'wcag2aa', 'wcag21a', 'wcag21aa', 'wcag22aa'])")
                lines.append("      .analyze();")
                lines.append(f"    expect(a11y_{s_idx}.violations).toEqual([]);")

            if visual_check:
                snapshot_name = f"{j_id}-step-{s_idx}.png"
                lines.append("    // Pixel-Perfect Visual Regression Snapshot")
                lines.append(f"    await expect(page).toHaveScreenshot('{snapshot_name}', {{")
                lines.append("      maxDiffPixelRatio: 0.01,")
                lines.append("      animations: 'disabled',")
                lines.append("    });")

            lines.append("")

        lines.append("  });")
        lines.append("")

    lines.append("});")
    lines.append("")
    return "\n".join(lines)

