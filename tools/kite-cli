                "colorHex": "#93C5FD",
                "position": [620, 240 + injected_count * 100]
            })
            injected_count += 1
        elif s_id == "chaos_network_partition":
            stickies.append({
                "id": f"sticky-chaos-crdt-{now_ts}-{idx}",
