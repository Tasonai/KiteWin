# ==================== MULTI-TENANT RBAC POLICY & PERMISSION MATRIX ENGINE ====================

def run_rbac_matrix_synthesis(canvas: Dict[str, Any], verify: bool = False) -> Dict[str, Any]:
    frames = canvas.get("frames", [])
    resources = []
    for f in frames:
        ftitle = f.get("title", "Resource")
        f_ascii = "".join(c if (c.isascii() and c.isalnum()) else "_" for c in ftitle.lower())
        slug = re.sub(r"_+", "_", f_ascii).strip("_") or f"resource_{len(resources)+1}"
        resources.append({
            "id": f.get("id", ""),
            "title": ftitle,
            "slug": slug
        })

    if not resources:
        resources.append({"id": "res-core", "title": "System Architecture Core", "slug": "system_core"})

    roles = [
        {"name": "Owner", "description": "Full root tenant authority, billing management, destructive drop", "level": 100},
        {"name": "Admin", "description": "Tenant administrator, member management, service provisioning", "level": 80},
        {"name": "Architect", "description": "System designer, schema & API route mutation, export builder", "level": 60},
        {"name": "Auditor", "description": "Compliance auditor, security log review, telemetry inspect", "level": 40},
        {"name": "Viewer", "description": "Read-only workspace consumer and mock inspector", "level": 20}
    ]

    matrix: Dict[str, Dict[str, List[str]]] = {}
    for r in roles:
        r_name = r["name"]
        matrix[r_name] = {}
        for res in resources:
            r_slug = res["slug"]
            t_lower = res["title"].lower()
            if r_name == "Owner":
                matrix[r_name][r_slug] = ["read", "write", "execute", "delete", "audit"]
            elif r_name == "Admin":
                matrix[r_name][r_slug] = ["read", "write", "execute", "delete"]
            elif r_name == "Architect":
                if "secur" in t_lower or "audit" in t_lower or "observ" in t_lower:
                    matrix[r_name][r_slug] = ["read"]
                else:
                    matrix[r_name][r_slug] = ["read", "write", "execute"]
            elif r_name == "Auditor":
                if "secur" in t_lower or "audit" in t_lower or "observ" in t_lower:
                    matrix[r_name][r_slug] = ["read", "audit"]
                else:
                    matrix[r_name][r_slug] = ["read"]
            else:
                if "secur" in t_lower:
                    matrix[r_name][r_slug] = []
                else:
                    matrix[r_name][r_slug] = ["read"]

    least_privilege_violations = []
    for r_slug in [res["slug"] for res in resources]:
        if "write" in matrix["Viewer"].get(r_slug, []):
            least_privilege_violations.append(f"Viewer has write on {r_slug}")
        if "delete" in matrix["Auditor"].get(r_slug, []):
            least_privilege_violations.append(f"Auditor has delete on {r_slug}")

    compliance_score = 100 if not least_privilege_violations else max(50, 100 - len(least_privilege_violations) * 15)

    return {
        "status": "success",
        "total_resources": len(resources),
        "total_roles": len(roles),
        "roles": roles,
        "resources": resources,
        "matrix": matrix,
        "compliance_score": compliance_score,
        "is_verified": len(least_privilege_violations) == 0,
        "violations": least_privilege_violations
    }

def generate_rbac_markdown(res: Dict[str, Any], title: str = "Kite Architecture") -> str:
    lines = []
    lines.append(f"# MULTI-TENANT RBAC POLICY & AUTHORIZATION MATRIX: {title.upper()}")
    lines.append("")
    lines.append("> Generated by Kite RBAC Matrix Engine following Google DeepMind Antigravity Craftsmanship Standard.")
    lines.append("")
    lines.append("## 1. Executive Access Control Profile")
    lines.append(f"- **Least Privilege Compliance:** `{res.get('compliance_score')}%`")
    lines.append(f"- **Protected Resources:** `{res.get('total_resources')}` domain containers")
    lines.append(f"- **Role Hierarchy:** `{res.get('total_roles')}` organizational tiers (Owner -> Admin -> Architect -> Auditor -> Viewer)")
    lines.append("- **Tenancy Invariant:** Every query, cache key, and event MUST be strictly bounded by `tenant_id`.")
    lines.append("")
    lines.append("## 2. Role-to-Resource Permission Matrix")
    lines.append("")
    headers = ["Role"] + [r["slug"] for r in res.get("resources", [])]
    lines.append("| " + " | ".join(headers) + " |")
    lines.append("| " + " | ".join([":---"] * len(headers)) + " |")
    matrix = res.get("matrix", {})
    for r in res.get("roles", []):
        r_name = r["name"]
        row = [f"**{r_name}**"]
        for res_obj in res.get("resources", []):
            acts = matrix.get(r_name, {}).get(res_obj["slug"], [])
            row.append(", ".join(acts) if acts else "DENIED")
        lines.append("| " + " | ".join(row) + " |")
    lines.append("")
    lines.append("## 3. PostgreSQL Row-Level Security (RLS) Defensive Policies")
    lines.append("```sql")
    for res_obj in res.get("resources", []):
        s = res_obj["slug"]
        lines.append(f"-- RLS Tenant Isolation for {res_obj['title']}")
        lines.append(f"ALTER TABLE tenant_{s} ENABLE ROW LEVEL SECURITY;")
        lines.append(f"CREATE POLICY tenant_isolation_{s} ON tenant_{s}")
        lines.append(f"  AS RESTRICTIVE USING (tenant_id = current_setting('app.current_tenant_id', true));")
        lines.append("")
    lines.append("```")
    lines.append("")
    lines.append("## 4. Casbin Model Definition (ABAC / RBAC)")
    lines.append("```ini")
    lines.append("[request_definition]")
    lines.append("r = sub, tenant, obj, act")
    lines.append("")
    lines.append("[policy_definition]")
    lines.append("p = sub, tenant, obj, act, eft")
    lines.append("")
    lines.append("[role_definition]")
    lines.append("g = _, _, _")
    lines.append("")
    lines.append("[policy_effect]")
    lines.append("e = some(where (p.eft == allow))")
    lines.append("")
    lines.append("[matchers]")
    lines.append("m = g(r.sub, p.sub, r.tenant) && r.tenant == p.tenant && keyMatch2(r.obj, p.obj) && regexMatch(r.act, p.act)")
    lines.append("```")
    lines.append("")
    lines.append("## 5. Antigravity Zero-Leakage Mandate")
    lines.append("Cross-tenant querying without explicit tenant context is strictly forbidden across all API routes.")
    return "\n".join(lines) + "\n"

