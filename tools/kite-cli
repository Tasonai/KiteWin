def run_mcp_server() -> None:
    """
    Standard Model Context Protocol (MCP) server running over stdio.
    Exposes Kite tools to Claude Desktop, Cursor, Antigravity, and other MCP clients.
    """
    def send_response(response: Dict[str, Any]) -> None:
        raw = json.dumps(response, ensure_ascii=False)
        sys.stdout.write(raw + "\n")
        sys.stdout.flush()

    while True:
        try:
            line = sys.stdin.readline()
            if not line:
                break
            line = line.strip()
            if not line:
                continue

            msg = json.loads(line)
            msg_id = msg.get("id")
            method = msg.get("method")
            params = msg.get("params", {})

            if method == "initialize":
                send_response({
                    "jsonrpc": "2.0",
                    "id": msg_id,
                    "result": {
                        "protocolVersion": "2024-11-05",
                        "serverInfo": {
                            "name": "kite-mcp-server",
                            "version": "1.0.0"
                        },
                        "capabilities": {
                            "tools": {}
                        }
                    }
                })

            elif method == "notifications/initialized":
                # Client acknowledges init
                continue

            elif method == "tools/list":
                send_response({
                    "jsonrpc": "2.0",
                    "id": msg_id,
                    "result": {
                        "tools": [
                            {
                                "name": "kite_status",
                                "description": "Returns status, active endpoint, version, and item counts of the running Kite app.",
                                "inputSchema": {
                                    "type": "object",
                                    "properties": {}
                                }
                            },
