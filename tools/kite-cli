    style = idea.get("preferredStyle") or "Editorial & Swiss Modern"
    slug = "".join(c if c.isalnum() else "-" for c in title.lower()).strip("-") or "kite-project"
    ts_title = "".join(w.capitalize() for w in re.findall(r"[a-zA-Z0-9]+", title)) or "KiteProject"

    frames = canvas.get("frames", [])
    stickies = canvas.get("stickies", [])
    conns = canvas.get("connections", [])

    files: Dict[str, str] = {}

    files["package.json"] = json.dumps({
        "name": slug,
        "version": "1.0.0",
