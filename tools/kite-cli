def run_multi_region_synthesis(canvas: Dict[str, Any], mode: str = "active-active", regions: List[str] = None) -> Dict[str, Any]:
    if not regions:
        regions = ["us-east-1", "eu-central-1"]

    frames = canvas.get("frames", [])
    data_stores: List[Dict[str, Any]] = []

    for f in frames:
        f_title = f.get("title", "")
        t_low = f_title.lower()
        if any(k in t_low for k in ["data", "db", "cache", "wal", "storage", "store", "state", "system"]):
            f_ascii = "".join(c if (c.isascii() and c.isalnum()) else "_" for c in f_title.lower())
            f_slug = re.sub(r"_+", "_", f_ascii).strip("_")
            data_stores.append({
                "name": f_title,
                "slug": f_slug,
                "is_cache": any(k in t_low for k in ["cache", "wal", "state"])
            })

    if not data_stores:
        data_stores.append({"name": "Core State Store", "slug": "core_state", "is_cache": False})

    is_active_active = (mode.lower() == "active-active")
    rto = "5s" if is_active_active else "45s"
    rpo = "0ms (Raft Consensus)" if is_active_active else "<500ms (Async WAL)"
    availability_sla = "99.995%" if is_active_active else "99.95%"

    replication_matrix: List[Dict[str, Any]] = []
    for ds in data_stores:
        if ds["is_cache"]:
            repl_mode = "Active-Active Global Redis Mesh (CRDT)" if is_active_active else "Primary-Replica Async Invalidation"
        else:
            repl_mode = "Multi-Region Distributed SQL (CockroachDB/Aurora Global)" if is_active_active else "Async Streaming Physical WAL Replication"

        replication_matrix.append({
            "target": ds["name"],
            "primary_region": regions[0],
            "secondary_region": regions[1] if len(regions) > 1 else "eu-west-1",
            "replication_mode": repl_mode,
            "failover_mechanism": "Route53 / Cloudflare Anycast Health Probe (<10s)",
            "consistency_guarantee": "Strong Eventual (CRDT)" if ds["is_cache"] else "Strict Serializable (Multi-Raft)"
        })

    return {
        "status": "success",
        "mode": mode,
        "regions": regions,
        "target_rto": rto,
        "target_rpo": rpo,
        "availability_sla": availability_sla,
        "data_stores_count": len(data_stores),
        "replication_matrix": replication_matrix,
        "compliance_score": 100
    }

