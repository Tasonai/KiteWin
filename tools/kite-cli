            tid = c.get("toId", "")
            lines.append(f"- `{fid}` &rarr; `{tid}` via `{lbl}`")
    else:
        lines.append("- View &rarr; Service: Typed HTTP / SSE JSON RPC.")
        lines.append("- Service &rarr; Data: Async repository pattern with Write-Ahead Logging.")
    lines.append("")

    lines.append("## 3. Design System & Grid Standards")
    lines.append(f"- **Preset:** `{style}`")
    lines.append("- **Grid Compliance:**")
    lines.append("  - macOS: Apple Human Interface Guidelines 4pt/8pt rhythm.")
    lines.append("  - Windows: Windows 11 BAWA 4 epx rhythm.")
    lines.append("- **Typography & Symbols:** Strictly 100% native glyphs (SF Symbols / Segoe Fluent Icons). Zero emojis.")
    lines.append("- **Color System:** Dark surface `#0B0D13`, border `#1E293B`, accents `#3B82F6` and `#10B981`.")
    lines.append("")

    lines.append("## 4. Functional Requirements")
    lines.append("### FR-1: Core Workspace & Canvas Management")
    lines.append("- The application shall initialize persistent state upon launch without cloud lock-in.")
    lines.append("- Users can inspect and manipulate architectural stickies, frames, and connections.")
    lines.append("")
    lines.append("### FR-2: Real-time Synchronization & Conflict Resolution")
    lines.append("- Stations broadcast state changes via Server-Sent Events (SSE) within 50ms latency.")
    lines.append("- Multi-node mutations resolve deterministically using union conflict resolution.")
    lines.append("")
    lines.append("### FR-3: AI & Offline Fallback Engine")
    lines.append("- The system routes tasks through Gemini 3.8, falling back to local Ollama or deterministic offline compiler.")
    lines.append("")

    lines.append("## 5. Non-Functional Requirements (NFR)")
    lines.append("- **NFR-1 (Latency):** Interactive canvas interactions shall render at 60 FPS (<16ms frame time).")
    lines.append("- **NFR-2 (Reliability):** 100% passing automated test suite (110 self-tests on macOS, zero gate violations on Windows).")
    lines.append("- **NFR-3 (Accessibility):** WCAG 2.2 Level AA compliance, full keyboard navigation and high-contrast support.")
    lines.append("- **NFR-4 (Security):** Zero plain-text credentials; secrets sanitized before logging or disk persistence.")
    lines.append("")

    lines.append("## 6. Execution Waves & Delivery Plan")
    lines.append("- **Wave 1 (Data & Schema):** Relational tables, WAL store, data models, initial migrations.")
    lines.append("- **Wave 2 (Services & Transport):** Type-safe endpoints, P2P sync engine, event bus, SSE stream.")
    lines.append("- **Wave 3 (Presentation & UI):** Native views, tokens, interactive canvas, accessibility audit.")
    lines.append("- **Wave 4 (QA & Release):** End-to-end integration tests, package DMG/ZIP/Installer, CI/CD matrix.")

    return "\n".join(lines)

def cmd_prd(args: argparse.Namespace) -> None:
    ep = get_active_endpoint()
    ideas = api_get(ep, "/api/ideas").get("ideas", [])
    canvas = api_get(ep, "/api/canvas")

    q = getattr(args, "query", "") or ""
    matched = None
    if q:
        matched = next((i for i in ideas if q.lower() in i.get("title", "").lower() or q.lower() in i.get("id", "").lower()), None)
    else:
        matched = next((i for i in ideas if i.get("isStarred")), ideas[0] if ideas else None)

    if not matched:
        matched = {
            "title": "Kite Architecture Project",
            "concept": "Integrated cross-platform workspace for architecture and system design.",
            "platform": "desktop",
            "preferredStyle": "Editorial & Swiss Modern"
        }

    prd_md = generate_prd(matched, canvas)
    out_path = getattr(args, "out", "") or ""
    json_out = getattr(args, "json", False)

    if out_path:
        with open(out_path, "w", encoding="utf-8") as f:
            f.write(prd_md)
        print(f"PRD generated and saved to {os.path.abspath(out_path)} ({len(prd_md)} bytes).")
    elif json_out:
        res = {
            "title": matched.get("title"),
            "platform": matched.get("platform"),
            "prd": prd_md,
            "bytes": len(prd_md)
        }
        print(json.dumps(res, indent=2, ensure_ascii=False))
    else:
        print(prd_md)

def scaffold_full_project(idea: Dict[str, Any], canvas: Dict[str, Any], out_dir: str, dry_run: bool = False) -> Dict[str, Any]:
    title = idea.get("title", "Kite Project")
