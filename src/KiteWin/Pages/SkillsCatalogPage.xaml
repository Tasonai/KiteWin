<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="KiteWin.Pages.SkillsCatalogPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:core="using:KiteWin.Core"
    xmlns:ui="using:KiteWin.UI"
    NavigationCacheMode="Required">

    <Page.Resources>
        <Style x:Key="SkillCardStyle" TargetType="Border">
            <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="{ThemeResource OverlayCornerRadius}" />
            <Setter Property="Padding" Value="16" />
        </Style>
    </Page.Resources>

    <Grid
        Padding="{StaticResource PageMargin}"
        ui:GridArea.Name="page"
        ui:GridArea.Inset="{StaticResource SpaceXxl}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Margin="{StaticResource PageHeaderMargin}">
            <StackPanel Spacing="2">
                <TextBlock Style="{StaticResource TitleTextBlockStyle}" Text="База знаний Antigravity" />
                <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="355 специализированных скиллов и 18 расширений экосистемы для генерации и синхронизации." />
            </StackPanel>
        </Grid>

        <!-- Search and Filter Bar -->
        <Grid Grid.Row="1" Margin="0,0,0,16" ColumnSpacing="{StaticResource SpaceMd}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBox
                x:Name="SearchBox"
                PlaceholderText="Поиск по скиллам, плагинам, тегам и описанию..."
                TextChanged="OnSearchTextChanged">
                <TextBox.Header>
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE721;" FontSize="12" />
                        <TextBlock Text="Быстрый поиск" />
                    </StackPanel>
                </TextBox.Header>
            </TextBox>

            <StackPanel Grid.Column="1" VerticalAlignment="Bottom" Orientation="Horizontal" Spacing="{StaticResource SpaceSm}">
                <RadioButton
                    x:Name="SkillsRadio"
                    Content="Скиллы"
                    IsChecked="True"
                    Checked="OnCategoryTabChanged" />
                <RadioButton
                    x:Name="PluginsRadio"
                    Content="Плагины"
                    Checked="OnCategoryTabChanged" />
            </StackPanel>
        </Grid>

        <!-- Content Area -->
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="{StaticResource SpaceMd}">
                <!-- Skills Grid View -->
                <ItemsControl x:Name="SkillsList">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <ItemsWrapGrid Orientation="Horizontal" MaximumRowsOrColumns="3" ItemWidth="340" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="core:AntigravitySkillInfo">
                            <Border Margin="0,0,12,12" Style="{StaticResource SkillCardStyle}">
                                <Grid RowSpacing="8">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <!-- Top Badges -->
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <Border Background="{ThemeResource SubtleFillColorSecondaryBrush}" CornerRadius="4" Padding="6,2">
                                                <TextBlock FontSize="11" FontWeight="SemiBold" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" Text="{x:Bind Category}" />
                                            </Border>
                                        </StackPanel>

                                        <Button
                                            Grid.Column="1"
                                            Padding="4"
                                            Click="OnCopySkillNameClick"
                                            Tag="{x:Bind Name}"
                                            ToolTipService.ToolTip="Скопировать вызов скилла">
                                            <FontIcon Glyph="&#xE8C8;" FontSize="12" />
                                        </Button>
                                    </Grid>

                                    <!-- Name and Summary -->
                                    <StackPanel Grid.Row="1" Spacing="4">
                                        <TextBlock FontSize="15" FontWeight="SemiBold" Text="{x:Bind Name}" />
                                        <TextBlock
                                            FontSize="12"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            MaxLines="2"
                                            Text="{x:Bind Summary}"
                                            TextWrapping="Wrap" />
                                    </StackPanel>

                                    <!-- Footer info -->
                                    <TextBlock
                                        Grid.Row="2"
                                        FontSize="11"
                                        Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                        Text="{x:Bind Description}"
                                        TextTrimming="CharacterEllipsis" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Plugins Grid View -->
                <ItemsControl x:Name="PluginsList" Visibility="Collapsed">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <ItemsWrapGrid Orientation="Horizontal" MaximumRowsOrColumns="3" ItemWidth="340" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="core:AntigravityPluginInfo">
                            <Border Margin="0,0,12,12" Style="{StaticResource SkillCardStyle}">
                                <Grid RowSpacing="8">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <!-- Top Badges -->
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <Border Background="{ThemeResource AccentFillColorDefaultBrush}" CornerRadius="4" Padding="6,2">
                                                <TextBlock FontSize="11" FontWeight="SemiBold" Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" Text="{x:Bind Version}" />
                                            </Border>
                                            <Border Background="{ThemeResource SubtleFillColorSecondaryBrush}" CornerRadius="4" Padding="6,2">
                                                <TextBlock FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{x:Bind Category}" />
                                            </Border>
                                        </StackPanel>

                                        <Button
                                            Grid.Column="1"
                                            Padding="4"
                                            Click="OnCopyPluginIdClick"
                                            Tag="{x:Bind Id}"
                                            ToolTipService.ToolTip="Скопировать ID плагина">
                                            <FontIcon Glyph="&#xE8C8;" FontSize="12" />
                                        </Button>
                                    </Grid>

                                    <!-- Name and Summary -->
                                    <StackPanel Grid.Row="1" Spacing="4">
                                        <TextBlock FontSize="15" FontWeight="SemiBold" Text="{x:Bind Name}" />
                                        <TextBlock
                                            FontSize="12"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            MaxLines="3"
                                            Text="{x:Bind Summary}"
                                            TextWrapping="Wrap" />
                                    </StackPanel>

                                    <!-- Author and Skills Count -->
                                    <Grid Grid.Row="2">
                                        <TextBlock FontSize="11" Foreground="{ThemeResource TextFillColorTertiaryBrush}" Text="{x:Bind Author}" />
                                        <TextBlock
                                            HorizontalAlignment="Right"
                                            FontSize="11"
                                            FontWeight="SemiBold"
                                            Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                            Text="{x:Bind SkillsCount, ConverterParameter='скиллов', Mode=OneWay}" />
                                    </Grid>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
