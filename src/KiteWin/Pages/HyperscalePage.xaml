<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="KiteWin.Pages.HyperscalePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="using:KiteWin.UI"
    NavigationCacheMode="Required">

    <Page.Resources>
        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="{ThemeResource OverlayCornerRadius}" />
        </Style>
    </Page.Resources>

    <Grid
        Padding="{StaticResource PageMargin}"
        ui:GridArea.Name="page"
        ui:GridArea.Inset="{StaticResource SpaceXxl}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header: Title matches SidebarPage.Hyperscale.Title() for SelfTest -->
        <Grid Margin="{StaticResource PageHeaderMargin}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Spacing="4">
                <TextBlock Style="{StaticResource TitleTextBlockStyle}" Text="Гиперскейл и 3D" />
                <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="Инспектор 3D-топологии Z-страт, ядра eBPF, глобальной сети WASI, FinOps/DR, TLA+ и постквантового шифрования." />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <Button Click="OnRefreshAllClicked">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE72C;" FontSize="12" />
                        <TextBlock Text="Обновить телеметрию" />
                    </StackPanel>
                </Button>
                <Button Click="OnCopyGltfClicked" Style="{StaticResource AccentButtonStyle}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE8C8;" FontSize="12" />
                        <TextBlock Text="Экспорт glTF 2.0" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel MaxWidth="1000" HorizontalAlignment="Left" Spacing="{StaticResource SpaceLg}">

                <!-- Status Banner -->
                <InfoBar
                    x:Name="ActionStatusBar"
                    IsOpen="True"
                    IsClosable="False"
                    Severity="Informational"
                    Message="Все 10 движков Milestone 4.0 и 5.0 активны и синхронизированы в реальном времени." />

                <!-- 1. 3D Spatial Topology & Z-Strata -->
                <Border Padding="{StaticResource CardPadding}" Style="{StaticResource CardStyle}">
                    <StackPanel Spacing="{StaticResource SpaceMd}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Spacing="4">
                                <TextBlock FontWeight="SemiBold" FontSize="16" Text="3D Пространственная топология (5 Z-страт)" />
                                <TextBlock x:Name="SpatialSummaryText" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="" />
                            </StackPanel>
                            <Button Grid.Column="1" Click="OnRelax3DLayoutClicked">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE945;" FontSize="12" />
                                    <TextBlock Text="Релаксация 3D сил" />
                                </StackPanel>
                            </Button>
                        </Grid>
                        <TextBlock x:Name="SpatialNodesListText" FontFamily="Consolas" FontSize="12" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <!-- 2. eBPF Kernel Flows & WASI Edge PoPs -->
                <Border Padding="{StaticResource CardPadding}" Style="{StaticResource CardStyle}">
                    <StackPanel Spacing="{StaticResource SpaceMd}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Spacing="4">
                                <TextBlock FontWeight="SemiBold" FontSize="16" Text="Телеметрия ядра eBPF и глобальная сеть WASI Preview 2" />
                                <TextBlock x:Name="EbpfEdgeSummaryText" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="" />
                            </StackPanel>
                            <Button Grid.Column="1" Click="OnCopyEbpfPolicyClicked">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE72E;" FontSize="12" />
                                    <TextBlock Text="Скопировать Cilium Policy" />
                                </StackPanel>
                            </Button>
                        </Grid>
                        <TextBlock x:Name="EbpfFlowsListText" FontFamily="Consolas" FontSize="12" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <!-- 3. Active-Active DR & FinOps Carbon Arbitrage -->
                <Border Padding="{StaticResource CardPadding}" Style="{StaticResource CardStyle}">
                    <StackPanel Spacing="{StaticResource SpaceMd}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Spacing="4">
                                <TextBlock FontWeight="SemiBold" FontSize="16" Text="Аварийное переключение DR и углеродный FinOps-арбитраж" />
                                <TextBlock x:Name="DrFinopsSummaryText" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="" />
                            </StackPanel>
                            <Button Grid.Column="1" Click="OnSimulateFailoverClicked">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE7BA;" FontSize="12" />
                                    <TextBlock Text="Симуляция отказа региона" />
                                </StackPanel>
                            </Button>
                        </Grid>
                        <TextBlock x:Name="DrFinopsDetailText" FontFamily="Consolas" FontSize="12" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <!-- 4. Formal TLA+, Post-Quantum Crypto, SLO Gate & Federation -->
                <Border Padding="{StaticResource CardPadding}" Style="{StaticResource CardStyle}">
                    <StackPanel Spacing="{StaticResource SpaceMd}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Spacing="4">
                                <TextBlock FontWeight="SemiBold" FontSize="16" Text="Формальная верификация TLA+, постквантовый шифр NIST и SLO-гейт" />
                                <TextBlock x:Name="GovernanceSummaryText" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                                <Button Click="OnRotatePqcClicked">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon Glyph="&#xE8D7;" FontSize="12" />
                                        <TextBlock Text="Ротация ML-KEM/DSA" />
                                    </StackPanel>
                                </Button>
                                <Button Click="OnRunMapeKClicked">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon Glyph="&#xE99A;" FontSize="12" />
                                        <TextBlock Text="Авто-откат Canary" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Grid>
                        <TextBlock x:Name="GovernanceDetailText" FontFamily="Consolas" FontSize="12" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
