<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="KiteWin.Pages.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:toolkit="using:CommunityToolkit.WinUI.Controls"
    xmlns:ui="using:KiteWin.UI">

    <!-- Settings looks like Windows 11 Settings: one card per setting, grouped neatly. -->
    <ScrollViewer>
        <Grid>
            <StackPanel
                MaxWidth="{StaticResource ContentMaxWidth}"
                Padding="{StaticResource PageMargin}"
                ui:GridArea.Name="page"
                ui:GridArea.Inset="{StaticResource SpaceXxl}">

                <!-- Page Header -->
                <TextBlock
                    Margin="{StaticResource PageHeaderMargin}"
                    Style="{StaticResource TitleTextBlockStyle}"
                    Text="Настройки"
                    ui:GridProbe.Area="page"
                    ui:GridProbe.Name="title" />

                <!-- P2P Sync Section -->
                <TextBlock
                    Margin="0,0,0,8"
                    Style="{StaticResource BodyStrongTextBlockStyle}"
                    Text="Синхронизация P2P с macOS"
                    ui:GridProbe.Area="page"
                    ui:GridProbe.Name="sync-header" />
                <StackPanel Spacing="{StaticResource SpaceXs}" ui:GridProbe.Area="page" ui:GridProbe.Name="sync-cards">
                    <toolkit:SettingsCard Description="URL адрес REST-сервера Kite на macOS (по умолчанию порт 24242)." Header="Адрес Kite macOS">
                        <toolkit:SettingsCard.HeaderIcon>
                            <FontIcon Glyph="&#xE895;" />
                        </toolkit:SettingsCard.HeaderIcon>
                        <TextBox
                            x:Name="MacEndpointBox"
                            MinWidth="260"
                            PlaceholderText="http://127.0.0.1:24242"
                            TextChanged="OnMacEndpointChanged" />
                    </toolkit:SettingsCard>

                    <toolkit:SettingsCard Description="Фоновая репликация банка идей каждые 30 секунд при доступности Mac." Header="Авто-синхронизация">
                        <toolkit:SettingsCard.HeaderIcon>
                            <FontIcon Glyph="&#xE945;" />
                        </toolkit:SettingsCard.HeaderIcon>
                        <ToggleSwitch x:Name="AutoSyncSwitch" Toggled="OnAutoSyncChanged" />
                    </toolkit:SettingsCard>
                </StackPanel>

                <!-- Appearance Section -->
                <TextBlock
                    Margin="{StaticResource GroupHeaderMargin}"
                    Style="{StaticResource BodyStrongTextBlockStyle}"
                    Text="Внешний вид и стиль"
                    ui:GridProbe.Area="page"
                    ui:GridProbe.Name="appearance" />
                <StackPanel Spacing="{StaticResource SpaceXs}" ui:GridProbe.Area="page" ui:GridProbe.Name="appearance-cards">
                    <toolkit:SettingsCard Description="Светлая, темная или системная тема Windows 11 с эффектом Mica." Header="Тема приложения">
                        <toolkit:SettingsCard.HeaderIcon>
                            <FontIcon Glyph="&#xE793;" />
                        </toolkit:SettingsCard.HeaderIcon>
                        <ComboBox x:Name="ThemeBox" MinWidth="200" SelectionChanged="OnThemeChanged" />
                    </toolkit:SettingsCard>
                    <toolkit:SettingsCard Description="Цвет акцентов кнопок, переключателей и индикаторов." Header="Акцентный цвет">
                        <toolkit:SettingsCard.HeaderIcon>
                            <FontIcon Glyph="&#xE790;" />
                        </toolkit:SettingsCard.HeaderIcon>
                        <ComboBox x:Name="AccentBox" MinWidth="200" SelectionChanged="OnAccentChanged" />
                    </toolkit:SettingsCard>
                </StackPanel>

                <!-- AI Provider Section -->
                <TextBlock
                    Margin="{StaticResource GroupHeaderMargin}"
                    Style="{StaticResource BodyStrongTextBlockStyle}"
                    Text="Искусственный интеллект"
                    ui:GridProbe.Area="page"
                    ui:GridProbe.Name="ai-header" />
                <StackPanel Spacing="{StaticResource SpaceXs}">
                    <toolkit:SettingsCard Description="Провайдер для генерации AI-спецификаций и архитектурных планов." Header="AI Движок">
                        <toolkit:SettingsCard.HeaderIcon>
                            <FontIcon Glyph="&#xE70F;" />
                        </toolkit:SettingsCard.HeaderIcon>
                        <ComboBox x:Name="AiProviderBox" MinWidth="200" SelectionChanged="OnAiProviderChanged">
                            <ComboBoxItem Content="Google Gemini API (2.5 Flash / Pro)" Tag="gemini" />
                            <ComboBoxItem Content="Локальная нейросеть Ollama" Tag="ollama" />
                            <ComboBoxItem Content="Офлайн-компилятор Stitch (без API)" Tag="offline" />
                        </ComboBox>
                    </toolkit:SettingsCard>

                    <toolkit:SettingsCard Description="Ключ авторизации Google AI Studio для генерации без ограничений." Header="Gemini API Key">
                        <toolkit:SettingsCard.HeaderIcon>
                            <FontIcon Glyph="&#xE8D7;" />
                        </toolkit:SettingsCard.HeaderIcon>
                        <PasswordBox
                            x:Name="GeminiApiKeyBox"
                            MinWidth="240"
                            PasswordChanged="OnGeminiKeyChanged"
                            PlaceholderText="AIzaSy..." />
                    </toolkit:SettingsCard>

                    <toolkit:SettingsCard Description="Выбор модели Gemini 2.5 (Flash для быстрого отклика, Pro для сложной логики)." Header="Модель Gemini">
                        <toolkit:SettingsCard.HeaderIcon>
                            <FontIcon Glyph="&#xE945;" />
                        </toolkit:SettingsCard.HeaderIcon>
                        <ComboBox x:Name="GeminiModelBox" MinWidth="240" SelectionChanged="OnGeminiModelChanged">
                            <ComboBoxItem Content="gemini-2.5-flash (Рекомендуется)" Tag="gemini-2.5-flash" />
                            <ComboBoxItem Content="gemini-2.5-pro (Глубокий анализ)" Tag="gemini-2.5-pro" />
                        </ComboBox>
                    </toolkit:SettingsCard>

                    <toolkit:SettingsCard Description="Локальный эндпоинт Ollama для автономной работы без интернета." Header="Эндпоинт Ollama">
                        <toolkit:SettingsCard.HeaderIcon>
                            <FontIcon Glyph="&#xE753;" />
                        </toolkit:SettingsCard.HeaderIcon>
                        <TextBox
                            x:Name="OllamaEndpointBox"
                            MinWidth="240"
                            PlaceholderText="http://localhost:11434/api/generate"
                            TextChanged="OnOllamaEndpointChanged" />
                    </toolkit:SettingsCard>

                    <toolkit:SettingsCard Description="Проверка доступности выбранного AI-провайдера (Gemini или Ollama)." Header="Диагностика связи с AI">
                        <toolkit:SettingsCard.HeaderIcon>
                            <FontIcon Glyph="&#xE950;" />
                        </toolkit:SettingsCard.HeaderIcon>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock x:Name="AiTestStatusText" VerticalAlignment="Center" FontSize="12" />
                            <Button x:Name="TestAiBtn" Click="OnTestAiConnection" Content="Проверить связь" />
                        </StackPanel>
                    </toolkit:SettingsCard>
                </StackPanel>

                <!-- About Section -->
                <TextBlock
                    Margin="{StaticResource GroupHeaderMargin}"
                    Style="{StaticResource BodyStrongTextBlockStyle}"
                    Text="О программе"
                    ui:GridProbe.Area="page"
                    ui:GridProbe.Name="about" />
                <toolkit:SettingsCard x:Name="AboutCard" Header="KiteWin" ui:GridProbe.Area="page" ui:GridProbe.Name="about-card">
                    <toolkit:SettingsCard.HeaderIcon>
                        <ImageIcon Source="ms-appx:///Assets/AppIcon.png" />
                    </toolkit:SettingsCard.HeaderIcon>
                    <Button Click="OnOpenDataFolder" Content="Открыть папку данных" />
                </toolkit:SettingsCard>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</Page>
