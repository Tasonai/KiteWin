<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="KiteWin.Pages.PromptTranslatorPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="using:KiteWin.UI"
    NavigationCacheMode="Required">

    <Page.Resources>
        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="{ThemeResource OverlayCornerRadius}" />
        </Style>
    </Page.Resources>

    <Grid
        Padding="{StaticResource PageMargin}"
        ui:GridArea.Name="page"
        ui:GridArea.Inset="{StaticResource SpaceXxl}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Margin="{StaticResource PageHeaderMargin}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Spacing="2">
                <TextBlock Style="{StaticResource TitleTextBlockStyle}" Text="Промпт-переводчик Antigravity" />
                <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="Превращайте тезисы и концепции в инженерную спецификацию /plan и Google Stitch." />
            </StackPanel>
            <CommandBar Grid.Column="1" Background="Transparent" DefaultLabelPosition="Right" IsOpen="False">
                <AppBarButton Click="OnCopyOutput" Icon="Copy" Label="Скопировать" />
                <AppBarButton Click="OnSaveToIdeas" Icon="Save" Label="Сохранить в идеи" />
                <AppBarButton Click="OnScaffoldProjectClick" Icon="Folder" Label="Экспорт проекта" />
            </CommandBar>
        </Grid>

        <!-- Main Studio Grid -->
        <Grid Grid.Row="1" ColumnSpacing="{StaticResource SpaceLg}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Left Panel: Input, Mode & Presets -->
            <Border Padding="{StaticResource CardPadding}" Style="{StaticResource CardStyle}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Spacing="{StaticResource SpaceMd}">
                        <!-- Mode Selector -->
                        <TextBlock FontWeight="SemiBold" Text="Режим генерации" />
                        <Segmented x:Name="ModeSegmented" SelectionChanged="OnModeChanged">
                            <SegmentedItem Content="План" Tag="plan" />
                            <SegmentedItem Content="Stitch" Tag="stitch" IsSelected="True" />
                            <SegmentedItem Content="Точечный" Tag="targeted" />
                            <SegmentedItem Content="Бриф" Tag="brief" />
                            <SegmentedItem Content="Действия" Tag="actions" />
                        </Segmented>

                        <!-- Presets Bar -->
                        <TextBlock FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="Быстрые пресеты" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button Click="OnPresetStitchLanding" Content="Stitch Landing" />
                            <Button Click="OnPresetClaudePaper" Content="Claude Paper" />
                            <Button Click="OnPresetCodexMinimal" Content="Codex Minimal" />
                            <Button Click="OnPresetTerracotta" Content="Terracotta" />
                            <Button Click="OnPresetLinear" Content="Linear Cockpit" />
                        </StackPanel>

                        <!-- Engineering Hub (4 Waves) -->
                        <TextBlock FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="Инженерный хаб Antigravity (4 волны)" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <DropDownButton Content="1. Схема и Данные">
                                <DropDownButton.Flyout>
                                    <MenuFlyout>
                                        <MenuFlyoutItem Click="OnStudioDataSchema" Text="Схема данных и Prisma">
                                            <MenuFlyoutItem.Icon>
                                                <FontIcon Glyph="&#xE8A5;" />
                                            </MenuFlyoutItem.Icon>
                                        </MenuFlyoutItem>
                                        <MenuFlyoutItem Click="OnStudioModelRouter" Text="LLM Маршрутизатор (Gemini 3.8)">
                                            <MenuFlyoutItem.Icon>
                                                <FontIcon Glyph="&#xE945;" />
                                            </MenuFlyoutItem.Icon>
                                        </MenuFlyoutItem>
                                        <MenuFlyoutItem Click="OnStudioIndexOptimizer" Text="Оптимизатор индексов SQL">
                                            <MenuFlyoutItem.Icon>
                                                <FontIcon Glyph="&#xE81E;" />
                                            </MenuFlyoutItem.Icon>
                                        </MenuFlyoutItem>
                                        <MenuFlyoutItem Click="OnStudioSeedData" Text="Генератор тестовых данных">
                                            <MenuFlyoutItem.Icon>
                                                <FontIcon Glyph="&#xE8B7;" />
                                            </MenuFlyoutItem.Icon>
                                        </MenuFlyoutItem>
                                        <MenuFlyoutItem Click="OnStudioVectorStore" Text="Векторная база RAG (pgvector)">
                                            <MenuFlyoutItem.Icon>
                                                <FontIcon Glyph="&#xE753;" />
                                            </MenuFlyoutItem.Icon>
                                        </MenuFlyoutItem>
                                        <MenuFlyoutItem Click="OnStudioMigrations" Text="Миграции Expand &amp; Contract">
                                            <MenuFlyoutItem.Icon>
                                                <FontIcon Glyph="&#xE8D5;" />
                                            </MenuFlyoutItem.Icon>
                                        </MenuFlyoutItem>
                                    </MenuFlyout>
                                </DropDownButton.Flyout>
                            </DropDownButton>

                            <DropDownButton Content="2. Сервисы и API">
                                <DropDownButton.Flyout>
                                    <MenuFlyout>
                                        <MenuFlyoutItem Click="OnStudioApiContracts" Text="API-контракты и Mock-сервер">
                                            <MenuFlyoutItem.Icon>
                                                <FontIcon Glyph="&#xE8D2;" />
                                            </MenuFlyoutItem.Icon>
                                        </MenuFlyoutItem>
                                        <MenuFlyoutItem Click="OnStudioRpcStudio" Text="Типизированный RPC / tRPC">
                                            <MenuFlyoutItem.Icon>
                                                <FontIcon Glyph="&#xE943;" />
                                            </MenuFlyoutItem.Icon>
                                        </MenuFlyoutItem>
                                        <MenuFlyoutItem Click="OnStudioEventBus" Text="Шина событий (EventBus)">
                                            <MenuFlyoutItem.Icon>
                                                <FontIcon Glyph="&#xE8BD;" />
                                            </MenuFlyoutItem.Icon>
                                        </MenuFlyoutItem>
                                        <MenuFlyoutItem Click="OnStudioJobQueue" Text="Очереди фоновых задач">
                                            <MenuFlyoutItem.Icon>
                                                <FontIcon Glyph="&#xE823;" />
                                            </MenuFlyoutItem.Icon>
                                        </MenuFlyoutItem>
                                        <MenuFlyoutItem Click="OnStudioRateLimiter" Text="Rate Limiter и DDoS-защита">
                                            <MenuFlyoutItem.Icon>
                                                <FontIcon Glyph="&#xE72E;" />
                                            </MenuFlyoutItem.Icon>
                                        </MenuFlyoutItem>
                                        <MenuFlyoutItem Click="OnStudioQueryCache" Text="Двухуровневый кэш запросов">
                                            <MenuFlyoutItem.Icon>
                                                <FontIcon Glyph="&#xE8C8;" />
                                            </MenuFlyoutItem.Icon>
                                        </MenuFlyoutItem>
                                        <MenuFlyoutItem Click="OnStudioRealtime" Text="Потоковый Realtime WebSockets">
                                            <MenuFlyoutItem.Icon>
                                                <FontIcon Glyph="&#xE753;" />
                                            </MenuFlyoutItem.Icon>
                                        </MenuFlyoutItem>
                                        <MenuFlyoutItem Click="OnStudioWebhooks" Text="Симулятор вебхуков">
                                            <MenuFlyoutItem.Icon>
                                                <FontIcon Glyph="&#xE71B;" />
                                            </MenuFlyoutItem.Icon>
                                        </MenuFlyoutItem>
                                        <MenuFlyoutItem Click="OnStudioWebhookDispatcher" Text="Диспетчер исходящих вебхуков">
                                            <MenuFlyoutItem.Icon>
                                                <FontIcon Glyph="&#xE724;" />
                                            </MenuFlyoutItem.Icon>
                                        </MenuFlyoutItem>
                                    </MenuFlyout>
                                </DropDownButton.Flyout>
                            </DropDownButton>

                            <DropDownButton Content="3. UI и Токены">
                                <DropDownButton.Flyout>
                                    <MenuFlyout>
                                        <MenuFlyoutItem Click="OnStudioTokenSandbox" Text="Песочница дизайн-токенов">
                                            <MenuFlyoutItem.Icon>
                                                <FontIcon Glyph="&#xE790;" />
                                            </MenuFlyoutItem.Icon>
                                        </MenuFlyoutItem>
                                        <MenuFlyoutItem Click="OnStudioStateFlow" Text="Стейт-машина интерфейса (XState)">
                                            <MenuFlyoutItem.Icon>
                                                <FontIcon Glyph="&#xE8B7;" />
                                            </MenuFlyoutItem.Icon>
                                        </MenuFlyoutItem>
                                        <MenuFlyoutItem Click="OnStudioSitemapRouter" Text="Карта экранов и роутер">
                                            <MenuFlyoutItem.Icon>
                                                <FontIcon Glyph="&#xE81E;" />
                                            </MenuFlyoutItem.Icon>
                                        </MenuFlyoutItem>
                                        <MenuFlyoutItem Click="OnStudioAccessibility" Text="Аудит доступности (WCAG 2.2)">
                                            <MenuFlyoutItem.Icon>
                                                <FontIcon Glyph="&#xE776;" />
                                            </MenuFlyoutItem.Icon>
                                        </MenuFlyoutItem>
                                        <MenuFlyoutItem Click="OnStudioSeoStudio" Text="SEO и OpenGraph Next.js">
                                            <MenuFlyoutItem.Icon>
                                                <FontIcon Glyph="&#xE774;" />
                                            </MenuFlyoutItem.Icon>
                                        </MenuFlyoutItem>
                                        <MenuFlyoutItem Click="OnStudioInteractiveMockup" Text="Интерактивный HTML-макет">
                                            <MenuFlyoutItem.Icon>
                                                <FontIcon Glyph="&#xE8B9;" />
                                            </MenuFlyoutItem.Icon>
                                        </MenuFlyoutItem>
                                    </MenuFlyout>
                                </DropDownButton.Flyout>
                            </DropDownButton>

                            <DropDownButton Content="4. QA и Релиз">
                                <DropDownButton.Flyout>
                                    <MenuFlyout>
                                        <MenuFlyoutItem Click="OnStudioAntigravityPack" Text="Пакет Antigravity и Wave Runner">
                                            <MenuFlyoutItem.Icon>
                                                <FontIcon Glyph="&#xE72D;" />
                                            </MenuFlyoutItem.Icon>
                                        </MenuFlyoutItem>
                                        <MenuFlyoutItem Click="OnStudioTopologyValidator" Text="Валидатор топологии холста">
                                            <MenuFlyoutItem.Icon>
                                                <FontIcon Glyph="&#xE81E;" />
                                            </MenuFlyoutItem.Icon>
                                        </MenuFlyoutItem>
                                        <MenuFlyoutItem Click="OnStudioErrorDoctor" Text="Доктор сбоев терминала (Error Doctor)">
                                            <MenuFlyoutItem.Icon>
                                                <FontIcon Glyph="&#xE783;" />
                                            </MenuFlyoutItem.Icon>
                                        </MenuFlyoutItem>
                                        <MenuFlyoutItem Click="OnStudioThreatModeler" Text="Моделирование угроз (OWASP)">
                                            <MenuFlyoutItem.Icon>
                                                <FontIcon Glyph="&#xE72E;" />
                                            </MenuFlyoutItem.Icon>
                                        </MenuFlyoutItem>
                                        <MenuFlyoutItem Click="OnStudioSecretShield" Text="Защита от утечки секретов">
                                            <MenuFlyoutItem.Icon>
                                                <FontIcon Glyph="&#xE8D7;" />
                                            </MenuFlyoutItem.Icon>
                                        </MenuFlyoutItem>
                                        <MenuFlyoutItem Click="OnStudioEvalHarness" Text="Регрессионные тесты и эвалы">
                                            <MenuFlyoutItem.Icon>
                                                <FontIcon Glyph="&#xE945;" />
                                            </MenuFlyoutItem.Icon>
                                        </MenuFlyoutItem>
                                        <MenuFlyoutItem Click="OnStudioGitStory" Text="Conventional Commits и PR">
                                            <MenuFlyoutItem.Icon>
                                                <FontIcon Glyph="&#xE71B;" />
                                            </MenuFlyoutItem.Icon>
                                        </MenuFlyoutItem>
                                        <MenuFlyoutItem Click="OnStudioDeployBlueprint" Text="Blueprints деплоя Vercel/Docker">
                                            <MenuFlyoutItem.Icon>
                                                <FontIcon Glyph="&#xE777;" />
                                            </MenuFlyoutItem.Icon>
                                        </MenuFlyoutItem>
                                        <MenuFlyoutItem Click="OnStudioIncidentCommander" Text="План аварийного восстановления">
                                            <MenuFlyoutItem.Icon>
                                                <FontIcon Glyph="&#xE7BA;" />
                                            </MenuFlyoutItem.Icon>
                                        </MenuFlyoutItem>
                                        <MenuFlyoutItem Click="OnStudioStressTest" Text="Нагрузочные тесты k6">
                                            <MenuFlyoutItem.Icon>
                                                <FontIcon Glyph="&#xE9D9;" />
                                            </MenuFlyoutItem.Icon>
                                        </MenuFlyoutItem>
                                        <MenuFlyoutItem Click="OnStudioRunbook" Text="Runbook разработчика">
                                            <MenuFlyoutItem.Icon>
                                                <FontIcon Glyph="&#xE8D5;" />
                                            </MenuFlyoutItem.Icon>
                                        </MenuFlyoutItem>
                                    </MenuFlyout>
                                </DropDownButton.Flyout>
                            </DropDownButton>
                        </StackPanel>

                        <!-- Title and Concept Inputs -->
                        <TextBox
                            x:Name="InputTitleBox"
                            Header="Название проекта"
                            PlaceholderText="Например: SaaS Analytics DevTool Cockpit"
                            TextChanged="OnInputChanged" />

                        <TextBox
                            x:Name="InputConceptBox"
                            MinHeight="128"
                            AcceptsReturn="True"
                            Header="Ваша идея или сценарий"
                            PlaceholderText="Опишите экран, логику, фильтры, API и целевую аудиторию..."
                            TextChanged="OnInputChanged"
                            TextWrapping="Wrap" />

                        <!-- Targeted Edit fields (visible in targeted mode) -->
                        <StackPanel x:Name="TargetedEditPanel" Spacing="8" Visibility="Collapsed">
                            <TextBox x:Name="TargetElementBox" Header="Целевой компонент" PlaceholderText="Например: FilterBar, модальное окно, карточка метрик" />
                            <TextBox x:Name="TargetScopeBox" Header="Детали изменений" PlaceholderText="Например: добавить анимацию sub-250ms, кольцо фокуса и валидацию" />
                        </StackPanel>

                        <!-- Platform & Design System Selectors -->
                        <Grid ColumnSpacing="{StaticResource SpaceMd}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <ComboBox
                                x:Name="PlatformBox"
                                Header="Платформа"
                                HorizontalAlignment="Stretch"
                                SelectedIndex="0"
                                SelectionChanged="OnInputChanged">
                                <ComboBoxItem Content="Web" />
                                <ComboBoxItem Content="Mobile" />
                                <ComboBoxItem Content="Desktop" />
                            </ComboBox>

                            <ComboBox
                                x:Name="StyleBox"
                                Header="Дизайн-система"
                                HorizontalAlignment="Stretch"
                                SelectedIndex="0"
                                SelectionChanged="OnInputChanged">
                                <ComboBoxItem Content="Editorial &amp; Swiss Modern" />
                                <ComboBoxItem Content="Claude Paper" />
                                <ComboBoxItem Content="Codex Minimal" />
                                <ComboBoxItem Content="Terracotta Journal" />
                                <ComboBoxItem Content="Risograph Print" />
                                <ComboBoxItem Content="Linear &amp; DevTool Cockpit" />
                                <ComboBoxItem Content="Neo-Brutalism &amp; Tactical" />
                                <ComboBoxItem Content="Voxel &amp; 3D Isometric" />
                                <ComboBoxItem Content="Dark Glassmorphism" />
                            </ComboBox>
                        </Grid>

                        <!-- Active Antigravity Skills -->
                        <TextBlock FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="Активные скиллы Antigravity" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Border Background="{ThemeResource SubtleFillColorSecondaryBrush}" CornerRadius="4" Padding="8,4">
                                <TextBlock FontSize="11" Text="/enhance-prompt" />
                            </Border>
                            <Border Background="{ThemeResource SubtleFillColorSecondaryBrush}" CornerRadius="4" Padding="8,4">
                                <TextBlock FontSize="11" Text="/design-md" />
                            </Border>
                            <Border Background="{ThemeResource SubtleFillColorSecondaryBrush}" CornerRadius="4" Padding="8,4">
                                <TextBlock FontSize="11" Text="/taste-design" />
                            </Border>
                            <Border Background="{ThemeResource SubtleFillColorSecondaryBrush}" CornerRadius="4" Padding="8,4">
                                <TextBlock FontSize="11" Text="/emil-design-eng" />
                            </Border>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Border Background="{ThemeResource SubtleFillColorSecondaryBrush}" CornerRadius="4" Padding="8,4">
                                <TextBlock FontSize="11" Text="/a11y-debugging" />
                            </Border>
                            <Border Background="{ThemeResource SubtleFillColorSecondaryBrush}" CornerRadius="4" Padding="8,4">
                                <TextBlock FontSize="11" Text="/subagent-driven-development" />
                            </Border>
                            <Border Background="{ThemeResource SubtleFillColorSecondaryBrush}" CornerRadius="4" Padding="8,4">
                                <TextBlock FontSize="11" Text="/gsd-execute-phase" />
                            </Border>
                        </StackPanel>

                        <!-- Pre-Plan Clarifying Interview -->
                        <Border
                            x:Name="InterviewPanel"
                            Padding="12"
                            Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Visibility="Collapsed">
                            <StackPanel Spacing="12">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE8BD;" FontSize="14" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                    <TextBlock FontWeight="SemiBold" Text="Уточните, чтобы план вышел точным" />
                                </StackPanel>
                                <StackPanel x:Name="InterviewQuestionsList" Spacing="12" />
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Button
                                        x:Name="SubmitInterviewBtn"
                                        Click="OnSubmitInterviewClick"
                                        Content="Сгенерировать с ответами"
                                        Style="{StaticResource AccentButtonStyle}" />
                                    <Button
                                        x:Name="SkipInterviewBtn"
                                        Click="OnSkipInterviewClick"
                                        Content="Пропустить" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Action Buttons -->
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Button
                                x:Name="CompileBtn"
                                Click="OnCompileClick"
                                HorizontalAlignment="Stretch"
                                Style="{StaticResource AccentButtonStyle}">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <ProgressRing
                                        x:Name="CompileProgressRing"
                                        Width="16"
                                        Height="16"
                                        IsActive="False"
                                        Visibility="Collapsed" />
                                    <FontIcon x:Name="CompileIcon" Glyph="&#xE70F;" FontSize="14" />
                                    <TextBlock x:Name="CompileBtnText" FontWeight="SemiBold" Text="Скомпилировать спецификацию" />
                                </StackPanel>
                            </Button>
                            <Button
                                Grid.Column="1"
                                Click="OnOfflineCompileClick"
                                ToolTipService.ToolTip="Быстрая локальная сборка по шаблону без обращения к API">
                                <StackPanel Orientation="Horizontal" Spacing="4">
                                    <FontIcon Glyph="&#xE8B7;" FontSize="12" />
                                    <TextBlock Text="Офлайн" />
                                </StackPanel>
                            </Button>
                        </Grid>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- Right Panel: Output & Density Gauge -->
            <Border Padding="{StaticResource CardPadding}" Style="{StaticResource CardStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Quality Gauge Header -->
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="4">
                            <TextBlock FontWeight="SemiBold" Text="Индекс инженерной плотности" />
                            <ProgressBar x:Name="QualityBar" Height="8" Maximum="100" Value="85" />
                        </StackPanel>
                        <TextBlock
                            x:Name="QualityText"
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            FontFamily="Cascadia Code, Consolas"
                            FontWeight="Bold"
                            Text="85%" />
                    </Grid>

                    <!-- Output Text Area -->
                    <TextBox
                        x:Name="OutputTextBox"
                        Grid.Row="1"
                        AcceptsReturn="True"
                        FontFamily="Cascadia Code, Consolas"
                        FontSize="12"
                        Header="Результат компиляции"
                        PlaceholderText="Здесь появится готовый промпт для Google Stitch или Claude Code..."
                        TextWrapping="Wrap" />

                    <!-- Bottom Notification -->
                    <InfoBar
                        x:Name="TranslatorBanner"
                        Grid.Row="2"
                        Margin="0,8,0,0"
                        IsOpen="False"
                        IsClosable="True" />
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Page>
